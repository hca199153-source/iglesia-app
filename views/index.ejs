<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro | Samaritan's Purse - Operación Niño de la Navidad</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #0b221a; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; min-height: 100vh; padding: 20px 10px; color: #2b2b2b; }
        .form-container { max-width: 900px; margin: 0 auto; background: #ffffff; border-radius: 16px; box-shadow: 0 15px 35px rgba(0,0,0,0.4); border-top: 6px solid #009639; overflow: hidden; padding: 25px; }
        .header-logo { text-align: center; background: #f8f9fa; padding: 20px; border-radius: 12px; margin-bottom: 20px; border: 1px solid #e9ecef; }
        .header-logo img { height: 65px; }
        .title-banner { background: #009639; color: white; text-align: center; padding: 15px; border-radius: 12px; margin-bottom: 20px; }
        .section-title { background-color: #f1f8f4; color: #009639; font-weight: bold; padding: 10px 15px; border-radius: 8px; margin-top: 25px; margin-bottom: 15px; border-left: 4px solid #009639; }
        .dynamic-item { background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 10px; padding: 15px; margin-bottom: 12px; position: relative; }
        .btn-remove { position: absolute; top: 10px; right: 10px; color: #dc3545; cursor: pointer; font-size: 1.1rem; }
        .btn-remove:hover { color: #a71d2a; }
    </style>
</head>
<body>

    <div class="form-container">
        
        <div class="header-logo">
            <img src="/images/logo.png" alt="Samaritan's Purse">
            <h5 class="fw-bold text-success mt-2 mb-0">Operación Samaritan's Purse - Operación Niño de la Navidad</h5>
        </div>

        <div class="title-banner">
            <h4 class="fw-bold mb-1">Modelo de Crecimiento y Multiplicación</h4>
            <p class="small mb-0 opacity-75">De Números a Vidas Transformadas</p>
        </div>

        <div class="card mb-4 border-0 bg-light shadow-sm">
            <div class="card-body p-3">
                <h6 class="fw-bold text-danger mb-2"><i class="fas fa-bullseye me-2"></i> 3. De Porcentajes a Números Reales</h6>
                <p class="small text-muted mb-1">Metas claras y alcanzables a través de un proceso intencional de discipulado.</p>
                <ul class="small text-muted mb-0 ps-3">
                    <li><strong>Inscripción Esperada:</strong> Cuidar que cada cajita entregada llegue a un niño.</li>
                    <li><strong>Graduación Esperada:</strong> Lograr que los niños completen su discipulado.</li>
                </ul>
            </div>
        </div>

        <h5 class="text-center fw-bold text-success mb-4"><i class="fas fa-file-signature me-2"></i> Formulario de Registro</h5>

        <form action="/guardar-registro" method="POST">
            
            <!-- SELECCIÓN DE ZONA ACTUALIZADA -->
            <div class="mb-4 p-3 bg-light rounded border">
                <label class="form-label fw-bold text-secondary">Zona de Captura: <span class="text-danger">*</span></label>
                <select name="zona" class="form-select form-select-lg" required>
                    <option value="">-- Seleccione una zona --</option>
                    <option value="san_andres">San Andrés Tuxtla</option>
                    <option value="medellin">Medellín</option>
                    <option value="manlio">Manlio Fabio</option>
                    <option value="orizaba">Orizaba</option>
                    <option value="cd_aleman">Ciudad Alemán</option>
                    <option value="xalapa">Xalapa</option>
                </select>
                <div class="form-text text-muted small">Selecciona la zona geográfica que corresponde a tu iglesia o proyecto.</div>
            </div>

            <!-- DATOS DE LA IGLESIA -->
            <div class="section-title"><i class="fas fa-church me-2"></i> 1. Datos de la Iglesia</div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small fw-bold">Nombre de la Iglesia *</label>
                    <input type="text" name="nombre_iglesia" class="form-control form-control-sm" required placeholder="Ej. Lirio de los Valles">
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold">Dirección Completa *</label>
                    <input type="text" name="direccion" class="form-control form-control-sm" required placeholder="Calle, número, colonia, municipio">
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold">Cantidad de Cajitas Solicitadas *</label>
                    <input type="number" name="num_cajas" class="form-control form-control-sm" required min="1" placeholder="Ej. 100">
                </div>
            </div>

            <!-- DATOS DEL PASTOR -->
            <div class="section-title"><i class="fas fa-user-tie me-2"></i> 2. Datos del Pastor(a)</div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Nombre del Pastor(a) *</label>
                    <input type="text" name="nombre_pastor" class="form-control form-control-sm" required placeholder="Nombre completo">
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Teléfono del Pastor(a) *</label>
                    <input type="tel" name="telefono_pastor" class="form-control form-control-sm" required pattern="[0-9]{10}" placeholder="10 dígitos">
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Correo Electrónico (Opcional)</label>
                    <input type="email" name="correo_pastor" class="form-control form-control-sm" placeholder="correo@ejemplo.com">
                </div>
            </div>

            <!-- DATOS DEL LÍDER DE PROYECTO -->
            <div class="section-title"><i class="fas fa-user-shield me-2"></i> 3. Datos del Líder de Proyecto</div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Nombre del Líder *</label>
                    <input type="text" name="nombre_lider" class="form-control form-control-sm" required placeholder="Nombre completo">
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Teléfono del Líder *</label>
                    <input type="tel" name="telefono_lider" class="form-control form-control-sm" required pattern="[0-9]{10}" placeholder="10 dígitos">
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Correo Electrónico (Opcional)</label>
                    <input type="email" name="correo_lider" class="form-control form-control-sm" placeholder="correo@ejemplo.com">
                </div>
            </div>

            <!-- MAESTROS ASIGNADOS -->
            <div class="section-title d-flex justify-content-between align-items-center">
                <span><i class="fas fa-users me-2"></i> 4. Maestros Asignados</span>
                <button type="button" class="btn btn-success btn-sm" onclick="agregarMaestro()"><i class="fas fa-plus me-1"></i> Agregar Maestro</button>
            </div>
            <div id="containerMaestros"></div>

            <!-- GUERRERITOS DE ORACIÓN -->
            <div class="section-title d-flex justify-content-between align-items-center">
                <span><i class="fas fa-child me-2"></i> 5. Guerreritos de Oración (Niños / Tutores)</span>
                <button type="button" class="btn btn-primary btn-sm" onclick="agregarGuerrerito()"><i class="fas fa-plus me-1"></i> Agregar Guerrerito</button>
            </div>
            <div id="containerGuerreritos"></div>

            <!-- GUERREROS ADULTOS -->
            <div class="section-title d-flex justify-content-between align-items-center">
                <span><i class="fas fa-user-shield me-2"></i> 6. Guerreros de Oración (Adultos)</span>
                <button type="button" class="btn btn-danger btn-sm" onclick="agregarGuerrero()"><i class="fas fa-plus me-1"></i> Agregar Guerrero Adulto</button>
            </div>
            <div id="containerGuerreros"></div>

            <div class="mt-4 pt-3 border-top">
                <button type="submit" class="btn btn-success btn-lg w-100 fw-bold shadow-sm py-3">
                    <i class="fas fa-paper-plane me-2"></i> Guardar Registro de Iglesia
                </button>
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let countMaestros = 0;
        let countGuerreritos = 0;
        let countGuerreros = 0;

        function agregarMaestro() {
            countMaestros++;
            const div = document.createElement('div');
            div.className = 'dynamic-item';
            div.id = `maestro_${countMaestros}`;
            div.innerHTML = `
                <i class="fas fa-trash btn-remove" onclick="eliminarItem('maestro_${countMaestros}')" title="Eliminar"></i>
                <h6 class="fw-bold text-success mb-2">Maestro ${countMaestros}</h6>
                <div class="row g-2">
                    <div class="col-md-4">
                        <input type="text" name="maestros[m${countMaestros}][nombre]" class="form-control form-control-sm" placeholder="Nombre completo *" required>
                    </div>
                    <div class="col-md-4">
                        <input type="tel" name="maestros[m${countMaestros}][telefono]" class="form-control form-control-sm" placeholder="Teléfono *" required pattern="[0-9]{10}">
                    </div>
                    <div class="col-md-4">
                        <input type="email" name="maestros[m${countMaestros}][correo]" class="form-control form-control-sm" placeholder="Correo (Opcional)">
                    </div>
                </div>
            `;
            document.getElementById('containerMaestros').appendChild(div);
        }

        function agregarGuerrerito() {
            countGuerreritos++;
            const div = document.createElement('div');
            div.className = 'dynamic-item';
            div.id = `guerrerito_${countGuerreritos}`;
            div.innerHTML = `
                <i class="fas fa-trash btn-remove" onclick="eliminarItem('guerrerito_${countGuerreritos}')" title="Eliminar"></i>
                <h6 class="fw-bold text-primary mb-2">Guerrerito ${countGuerreritos}</h6>
                <div class="row g-2">
                    <div class="col-md-4">
                        <input type="text" name="guerreritos[g${countGuerreritos}][nombre_guerrerito]" class="form-control form-control-sm" placeholder="Nombre del niño/niña *" required>
                    </div>
                    <div class="col-md-4">
                        <input type="text" name="guerreritos[g${countGuerreritos}][nombre_tutor]" class="form-control form-control-sm" placeholder="Nombre del Papá/Tutor *" required>
                    </div>
                    <div class="col-md-4">
                        <input type="tel" name="guerreritos[g${countGuerreritos}][telefono_tutor]" class="form-control form-control-sm" placeholder="Teléfono Tutor *" required pattern="[0-9]{10}">
                    </div>
                </div>
            `;
            document.getElementById('containerGuerreritos').appendChild(div);
        }

        function agregarGuerrero() {
            countGuerreros++;
            const div = document.createElement('div');
            div.className = 'dynamic-item';
            div.id = `guerrero_${countGuerreros}`;
            div.innerHTML = `
                <i class="fas fa-trash btn-remove" onclick="eliminarItem('guerrero_${countGuerreros}')" title="Eliminar"></i>
                <h6 class="fw-bold text-danger mb-2">Guerrero Adulto ${countGuerreros}</h6>
                <div class="row g-2">
                    <div class="col-md-6">
                        <input type="text" name="guerreros[gu${countGuerreros}][nombre_guerrero]" class="form-control form-control-sm" placeholder="Nombre completo *" required>
                    </div>
                    <div class="col-md-6">
                        <input type="tel" name="guerreros[gu${countGuerreros}][telefono_guerrero]" class="form-control form-control-sm" placeholder="Teléfono *" required pattern="[0-9]{10}">
                    </div>
                </div>
            `;
            document.getElementById('containerGuerreros').appendChild(div);
        }

        function eliminarItem(id) {
            const el = document.getElementById(id);
            if (el) el.remove();
        }
    </script>
</body>
</html>
