<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registro de Cajas</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <style>
    body {
      background-color: #0a163b;
      color: #ffffff;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    .card-custom {
      background-color: #12224d;
      border: 1px solid #1d336d;
      border-radius: 12px;
    }
    .maestro-card {
      background-color: #182c61;
      border-left: 4px solid #ffc107;
      padding: 12px;
      margin-bottom: 10px;
      border-radius: 6px;
    }
    .btn-gold {
      background-color: #d4af37;
      color: #0a163b;
      font-weight: bold;
      border: none;
    }
    .btn-gold:hover {
      background-color: #f3cf55;
      color: #0a163b;
    }
  </style>
</head>
<body class="py-4">

  <div class="container" style="max-width: 800px;">
    
    <!-- Sección de Términos y Condiciones -->
    <div class="card card-custom p-4 mb-4 shadow">
      <h2 class="text-warning mb-3"><i class="bi bi-file-earmark-text"></i> Términos y Condiciones</h2>
      <p class="text-light">
        Por favor lea detenidamente las instrucciones y compromisos requeridos antes de solicitar las cajas para su iglesia. 
        Al dar clic en aceptar, confirma el compromiso de distribución y capacitación de los maestros asignados.
      </p>
      
      <div class="d-flex align-items-center mt-3">
        <div id="contenedorReloj" class="badge bg-secondary p-2 fs-6">
          Espere <span id="contadorReloj" class="fw-bold text-warning">25s</span> para continuar...
        </div>
        <button id="btnAceptarTerminos" onclick="aceptarTerminos()" class="btn btn-gold ms-auto" style="display: none;">
          <i class="bi bi-check-circle-fill"></i> Acepto los Términos
        </button>
      </div>
    </div>

    <!-- Sección del Formulario (Oculta al inicio) -->
    <div id="seccionFormulario" style="display: none;">
      
      <!-- Mensajes de Alerta del Servidor -->
      <% if (mensajeExito) { %>
        <div class="alert alert-success alert-dismissible fade show shadow" role="alert">
          <i class="bi bi-check-circle-fill me-2"></i> <%= mensajeExito %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>

      <% if (mensajeError) { %>
        <div class="alert alert-danger alert-dismissible fade show shadow" role="alert">
          <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= mensajeError %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>

      <form action="/guardar" method="POST" class="card card-custom p-4 shadow">
        <h3 class="text-warning mb-4"><i class="bi bi-journal-check"></i> Formulario de Registro</h3>
        
        <!-- Datos Pastor -->
        <h5 class="text-info border-bottom border-secondary pb-2">Datos del Pastor</h5>
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label">Nombre del Pastor *</label>
            <input type="text" name="nombre_pastor" class="form-control" required>
          </div>
          <div class="col-md-3">
            <label class="form-label">Teléfono *</label>
            <input type="tel" name="telefono_pastor" class="form-control" maxlength="10" pattern="[0-9]{10}" required>
          </div>
          <div class="col-md-3">
            <label class="form-label">Correo</label>
            <input type="email" name="correo_pastor" class="form-control">
          </div>
        </div>

        <!-- Datos Iglesia -->
        <h5 class="text-info border-bottom border-secondary pb-2 mt-3">Datos de la Iglesia</h5>
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label">Nombre de la Iglesia *</label>
            <input type="text" name="nombre_iglesia" class="form-control" required>
          </div>
          <div class="col-md-6">
            <label class="form-label">Dirección Completa *</label>
            <input type="text" name="direccion" class="form-control" required>
          </div>
          <div class="col-md-12">
            <label class="form-label">Cantidad de Cajas Requeridas *</label>
            <select id="selectCajas" name="num_cajas" class="form-select" onchange="actualizarMaestros()" required>
              <option value="" selected disabled>Selecciona una opción...</option>
              <option value="50">50 Cajas (Requiere 2 Maestros)</option>
              <option value="100">100 Cajas (Requiere 3 Maestros)</option>
              <option value="150">150 Cajas (Requiere 4 Maestros)</option>
            </select>
          </div>
        </div>

        <!-- Datos Líder -->
        <h5 class="text-info border-bottom border-secondary pb-2 mt-3">Datos del Líder Responsable</h5>
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label">Nombre del Líder *</label>
            <input type="text" name="nombre_lider" class="form-control" required>
          </div>
          <div class="col-md-3">
            <label class="form-label">Teléfono *</label>
            <input type="tel" name="telefono_lider" class="form-control" maxlength="10" pattern="[0-9]{10}" required>
          </div>
          <div class="col-md-3">
            <label class="form-label">Correo</label>
            <input type="email" name="correo_lider" class="form-control">
          </div>
        </div>

        <!-- Campos dinámicos para Maestros -->
        <div id="contenedorMaestros" class="mt-3" style="display: none;">
          <h5 class="text-info border-bottom border-secondary pb-2">Maestros Asignados</h5>
          <div id="listaMaestrosCampos"></div>
        </div>

        <button type="submit" class="btn btn-gold btn-lg w-100 mt-4">
          <i class="bi bi-send-fill"></i> Enviar Registro
        </button>
      </form>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    let tiempoRestante = 25;
    const contenedorReloj = document.getElementById('contenedorReloj');
    const contadorSpan = document.getElementById('contadorReloj');
    const btnAceptar = document.getElementById('btnAceptarTerminos');

    // Temporizador de 25 segundos
    const temporizador = setInterval(() => {
      tiempoRestante--;
      if (contadorSpan) {
        contadorSpan.textContent = tiempoRestante + 's';
      }

      if (tiempoRestante <= 0) {
        clearInterval(temporizador);
        if (contenedorReloj) contenedorReloj.style.display = 'none';
        if (btnAceptar) btnAceptar.style.display = 'block';
      }
    }, 1000);

    function aceptarTerminos() {
      const seccionForm = document.getElementById('seccionFormulario');
      seccionForm.style.display = 'block';
      seccionForm.scrollIntoView({ behavior: 'smooth' });
    }

    // Generador dinámico de campos de maestros según las cajas
    function actualizarMaestros() {
      const cajas = document.getElementById('selectCajas').value;
      const contenedor = document.getElementById('contenedorMaestros');
      const lista = document.getElementById('listaMaestrosCampos');
      
      let numMaestros = 0;
      if (cajas === "50") numMaestros = 2;
      else if (cajas === "100") numMaestros = 3;
      else if (cajas === "150") numMaestros = 4;

      lista.innerHTML = '';

      if (numMaestros > 0) {
        contenedor.style.display = 'block';

        for (let i = 1; i <= numMaestros; i++) {
          const maestroHTML = `
            <div class="maestro-card shadow-sm">
              <div class="fw-bold text-white mb-2 small">
                <i class="bi bi-person-badge-fill me-1 text-warning"></i> Maestro ${i}
              </div>
              <div class="row g-2">
                <div class="col-12 col-md-6">
                  <input type="text" name="maestro_nombre[]" class="form-control form-control-sm" required placeholder="Nombre Completo *">
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                  <input type="tel" name="maestro_telefono[]" class="form-control form-control-sm" maxlength="10" pattern="[0-9]{10}" required placeholder="Teléfono (10 dígitos) *">
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                  <input type="email" name="maestro_correo[]" class="form-control form-control-sm" placeholder="Correo (opcional)">
                </div>
              </div>
            </div>
          `;
          lista.innerHTML += maestroHTML;
        }
      } else {
        contenedor.style.display = 'none';
      }
    }

    // Muestra y desplaza el formulario al recibir confirmación del backend
    document.addEventListener("DOMContentLoaded", () => {
      const hayExito = <%= mensajeExito ? 'true' : 'false' %>;
      const hayError = <%= mensajeError ? 'true' : 'false' %>;

      if (hayExito || hayError) {
        const seccionForm = document.getElementById('seccionFormulario');
        seccionForm.style.display = 'block';
        seccionForm.scrollIntoView({ behavior: 'smooth' });
      }
    });
  </script>
</body>
</html>
