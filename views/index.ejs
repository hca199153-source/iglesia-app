<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registro de Clientes</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
  <style>
    body {
      background-color: #0f172a;
      color: #f8fafc;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .card-custom {
      background-color: #1e293b;
      border: 1px solid #334155;
      border-radius: 12px;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
    }

    .form-control, .form-select {
      background-color: #0f172a;
      border: 1px solid #334155;
      color: #f8fafc;
    }

    .form-control:focus, .form-select:focus {
      background-color: #0f172a;
      border-color: #3b82f6;
      color: #f8fafc;
      box-shadow: 0 0 0 0.25rem rgba(59, 130, 246, 0.25);
    }

    .btn-primary {
      background-color: #2563eb;
      border: none;
    }

    .btn-primary:hover {
      background-color: #1d4ed8;
    }

    .maestro-card {
      background-color: #0f172a;
      border: 1px dashed #3b82f6;
      border-radius: 8px;
      padding: 15px;
      margin-bottom: 12px;
    }

    .terms-box {
      background-color: #0f172a;
      border: 1px solid #334155;
      border-radius: 8px;
      max-height: 250px;
      overflow-y: auto;
      padding: 15px;
      font-size: 0.9rem;
    }

    #contenedorReloj {
      font-weight: bold;
      color: #f59e0b;
    }
  </style>
</head>
<body class="py-4">

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-10">

        <!-- HEADER -->
        <div class="text-center mb-4">
          <h1 class="fw-bold text-white mb-2">
            <i class="bi bi-shield-check text-primary me-2"></i>Plataforma de Registro
          </h1>
          <p class="text-secondary">Por favor, lea los términos y condiciones antes de continuar con la solicitud.</p>
        </div>

        <!-- MUESTRA DE ALERTAS DE SERVIDOR -->
        <% if (typeof mensajeExito !== 'undefined' && mensajeExito) { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i><%= mensajeExito %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% } %>

        <% if (typeof mensajeError !== 'undefined' && mensajeError) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><%= mensajeError %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% } %>

        <!-- SECCIÓN DE TÉRMINOS Y CONDICIONES -->
        <div class="card card-custom mb-4" id="seccionTerminos">
          <div class="card-header border-bottom border-secondary bg-transparent py-3">
            <h5 class="card-title text-white mb-0">
              <i class="bi bi-file-text me-2 text-warning"></i>Términos y Condiciones del Servicio
            </h5>
          </div>
          <div class="card-body">
            <div class="terms-box text-secondary mb-3">
              <p>1. <strong>Aceptación de Términos:</strong> Al utilizar esta plataforma para la solicitud de servicios o productos, usted acepta cumplir con todos los requisitos de la organización.</p>
              <p>2. <strong>Veracidad de la Información:</strong> Toda la información proporcionada en este formulario debe ser verídica, exacta y actualizada. Datos falsos o inconsistentes resultarán en la anulación del registro.</p>
              <p>3. <strong>Asignación de Maestros:</strong> En caso de requerir el suministro de cajas en volúmenes específicos (50, 100 o 150), se solicitará la asignación formal de personal maestro autorizado, cuyos datos deben ser proporcionados de manera obligatoria.</p>
              <p>4. <strong>Protección de Datos:</strong> Sus datos personales y de contacto registrados únicamente serán procesados para la gestión operativa y logística de la solicitud conforme a las políticas vigentes.</p>
              <p>5. <strong>Confirmación:</strong> El envío del formulario no garantiza la aceptación inmediata de la solicitud hasta la revisión por parte del personal administrador.</p>
            </div>

            <!-- CONTROLES Y TEMPORIZADOR -->
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
              <div id="contenedorReloj" class="d-flex align-items-center gap-2">
                <i class="bi bi-clock-history"></i>
                <span>Lea con atención. Podrá aceptar en: <strong id="contadorReloj">25s</strong></span>
              </div>

              <button type="button" id="btnAceptarTerminos" class="btn btn-primary px-4 fw-bold" onclick="aceptarTerminos()" style="display: none;">
                <i class="bi bi-check-lg me-1"></i> Aceptar Términos y Continuar
              </button>
            </div>
          </div>
        </div>

        <!-- FORMULARIO DE REGISTRO DE CLIENTES -->
        <div class="card card-custom mb-4" id="seccionFormulario" style="display: none;">
          <div class="card-header border-bottom border-secondary bg-transparent py-3">
            <h5 class="card-title text-white mb-0">
              <i class="bi bi-person-lines-fill me-2 text-info"></i>Formulario de Solicitud de Registro
            </h5>
          </div>
          <div class="card-body">
            <form action="/guardar" method="POST" id="formRegistro">
              
              <!-- SECCIÓN: DATOS DEL CLIENTE -->
              <h6 class="text-primary mb-3 border-bottom border-secondary pb-2 fw-bold">
                <i class="bi bi-person-badge me-1"></i> Datos Generales del Cliente
              </h6>
              
              <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                  <label for="nombre_completo" class="form-label small text-secondary">Nombre Completo *</label>
                  <input type="text" class="form-control" id="nombre_completo" name="nombre_completo" required placeholder="Ej. Juan Pérez González">
                </div>

                <div class="col-12 col-sm-6 col-md-3">
                  <label for="telefono" class="form-label small text-secondary">Teléfono (10 dígitos) *</label>
                  <input type="tel" class="form-control" id="telefono" name="telefono" maxlength="10" pattern="[0-9]{10}" required placeholder="Ej. 5512345678">
                </div>

                <div class="col-12 col-sm-6 col-md-3">
                  <label for="correo" class="form-label small text-secondary">Correo Electrónico *</label>
                  <input type="email" class="form-control" id="correo" name="correo" required placeholder="correo@ejemplo.com">
                </div>
              </div>

              <!-- SECCIÓN: UBICACIÓN Y DIRECCIÓN -->
              <h6 class="text-primary mb-3 border-bottom border-secondary pb-2 fw-bold">
                <i class="bi bi-geo-alt me-1"></i> Dirección y Ubicación
              </h6>

              <div class="row g-3 mb-4">
                <div class="col-12 col-md-4">
                  <label for="calle_numero" class="form-label small text-secondary">Calle y Número *</label>
                  <input type="text" class="form-control" id="calle_numero" name="calle_numero" required placeholder="Av. Principal #123">
                </div>

                <div class="col-12 col-sm-6 col-md-4">
                  <label for="colonia" class="form-label small text-secondary">Colonia / Fraccionamiento *</label>
                  <input type="text" class="form-control" id="colonia" name="colonia" required placeholder="Col. Centro">
                </div>

                <div class="col-12 col-sm-6 col-md-4">
                  <label for="ciudad_estado" class="form-label small text-secondary">Ciudad / Estado *</label>
                  <input type="text" class="form-control" id="ciudad_estado" name="ciudad_estado" required placeholder="Ciudad de México">
                </div>
              </div>

              <!-- SECCIÓN: SELECCIÓN DE CAJAS -->
              <h6 class="text-primary mb-3 border-bottom border-secondary pb-2 fw-bold">
                <i class="bi bi-box-seam me-1"></i> Selección de Volumen
              </h6>

              <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                  <label for="selectCajas" class="form-label small text-secondary">Cantidad de Cajas Requeridas *</label>
                  <select class="form-select" id="selectCajas" name="cajas" onchange="actualizarMaestros()" required>
                    <option value="" selected disabled>-- Selecciona una opción --</option>
                    <option value="ninguna">Ninguna</option>
                    <option value="50">50 Cajas (Requiere 2 Maestros)</option>
                    <option value="100">100 Cajas (Requiere 3 Maestros)</option>
                    <option value="150">150 Cajas (Requiere 4 Maestros)</option>
                  </select>
                </div>
              </div>

              <!-- SECCIÓN: REGISTRO DINÁMICO DE MAESTROS -->
              <div id="contenedorMaestros" style="display: none;" class="mb-4">
                <h6 class="text-warning mb-3 border-bottom border-secondary pb-2 fw-bold">
                  <i class="bi bi-people me-1"></i> Datos de los Maestros Asignados
                </h6>
                <div id="listaMaestrosCampos">
                  <!-- Los campos dinámicos se insertarán vía JavaScript -->
                </div>
              </div>

              <!-- BOTÓN DE ENVIAR -->
              <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                <button type="submit" class="btn btn-primary btn-lg px-5 font-semibold">
                  <i class="bi bi-send-fill me-2"></i> Guardar y Enviar Registro
                </button>
              </div>

            </form>
          </div>
        </div>

      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <!-- CONTROL DE TIEMPO, FORMULARIO Y REGISTRO DE MAESTROS -->
  <script>
    let tiempoRestante = 25;
    const contenedorReloj = document.getElementById('contenedorReloj');
    const contadorSpan = document.getElementById('contadorReloj');
    const btnAceptar = document.getElementById('btnAceptarTerminos');

    // Muestra automáticamente el formulario y hace scroll si hay mensaje de éxito o error
    window.addEventListener('DOMContentLoaded', () => {
      const mensajeExito = <%- JSON.stringify(typeof mensajeExito !== 'undefined' ? mensajeExito : '') %>;
      const mensajeError = <%- JSON.stringify(typeof mensajeError !== 'undefined' ? mensajeError : '') %>;

      if (mensajeExito !== '' || mensajeError !== '') {
        if (typeof temporizador !== 'undefined') clearInterval(temporizador);
        aceptarTerminos();
      }
    });

    const temporizador = setInterval(() => {
      tiempoRestante--;
      if (contadorSpan) {
        contadorSpan.textContent = tiempoRestante + 's';
      }

      if (tiempoRestante <= 0) {
        clearInterval(temporizador);
        if (contenedorReloj) contenedorReloj.style.display = 'none';
        if (btnAceptar) btnAceptar.style.display = 'block';
      }
    }, 1000);

    function aceptarTerminos() {
      if (contenedorReloj) contenedorReloj.style.display = 'none';
      if (btnAceptar) btnAceptar.style.display = 'none';
      
      const seccionForm = document.getElementById('seccionFormulario');
      if (seccionForm) {
        seccionForm.style.display = 'block';
        seccionForm.scrollIntoView({ behavior: 'smooth' });
      }
    }

    // Generador dinámico de campos para maestros
    function actualizarMaestros() {
      const cajas = document.getElementById('selectCajas').value;
      const contenedor = document.getElementById('contenedorMaestros');
      const lista = document.getElementById('listaMaestrosCampos');
      
      let numMaestros = 0;
      if (cajas === "50") numMaestros = 2;
      else if (cajas === "100") numMaestros = 3;
      else if (cajas === "150") numMaestros = 4;

      lista.innerHTML = '';

      if (numMaestros > 0) {
        contenedor.style.display = 'block';

        for (let i = 1; i <= numMaestros; i++) {
          const maestroHTML = `
            <div class="maestro-card shadow-sm">
              <div class="fw-bold text-white mb-2 small">
                <i class="bi bi-person-badge-fill me-1 text-warning"></i> Maestro ${i}
              </div>
              <div class="row g-2">
                <div class="col-12 col-md-6">
                  <input type="text" name="maestro_nombre[]" class="form-control form-control-sm" required placeholder="Nombre Completo *">
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                  <input type="tel" name="maestro_telefono[]" class="form-control form-control-sm" maxlength="10" pattern="[0-9]{10}" required placeholder="Teléfono (10 dígitos) *">
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                  <input type="email" name="maestro_correo[]" class="form-control form-control-sm" placeholder="Correo (opcional)">
                </div>
              </div>
            </div>
          `;
          lista.innerHTML += maestroHTML;
        }
      } else {
        contenedor.style.display = 'none';
      }
    }
  </script>
</body>
</html>
