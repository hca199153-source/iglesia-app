<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro | Samaritan's Purse - Operación Niño de la Navidad</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Incluimos Tesseract.js para procesar la imagen y extraer texto directamente en el navegador -->
    <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
    <style>
        body { background-color: #0b221a; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #2b2b2b; margin: 0; padding: 0; }
        .main-container { max-width: 720px; margin: 30px auto; background: #009639; border-radius: 16px; box-shadow: 0 15px 35px rgba(0,0,0,0.5); padding: 20px; }
        .header-top-box, .title-bar-box { background: #ffffff; border-radius: 12px; padding: 15px; text-align: center; margin-bottom: 15px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
        .hero-banner { background: linear-gradient(135deg, #007a2e, #005a22); color: white; padding: 20px; text-align: center; border-radius: 10px; margin-bottom: 20px; }
        .card-custom { border: none; border-radius: 10px; background-color: #ffffff; margin-bottom: 15px; border-left: 5px solid #d32f2f; }
        .card-header-custom { background-color: #f8f9fa; color: #005a22; font-weight: bold; padding: 10px 15px; border-radius: 0 10px 0 0; }
        .form-section-box { background-color: #ffffff; border-radius: 12px; padding: 25px; margin-top: 20px; box-shadow: 0 5px 20px rgba(0,0,0,0.15); }
        .form-control, .form-select { background-color: #f8f9fa; border: 1px solid #ced4da; border-radius: 8px; padding: 10px; }
        .timer-box { background: #ffffff; border: 2px dashed #ffc107; color: #856404; padding: 15px; border-radius: 10px; text-align: center; font-weight: bold; margin-top: 20px; }
        
        /* ESTILOS PARA EL NUEVO MÓDULO DE ESCANEO DE IMAGEN / IA */
        .ai-scanner-box { background: linear-gradient(135deg, #072217, #0b221a); border: 2px dashed #00ff66; border-radius: 12px; padding: 20px; color: white; margin-bottom: 20px; box-shadow: 0 5px 15px rgba(0,0,0,0.3); }
        .btn-scanner { background-color: #009639; color: white; border-radius: 50px; padding: 10px 20px; font-weight: bold; border: none; transition: all 0.3s; }
        .btn-scanner:hover { background-color: #007a2e; color: white; }
    </style>
</head>
<body>

    <div class="main-container">
        <div class="header-top-box">
            <img src="/images/logo.png" alt="Logo Samaritan's Purse" style="height: 55px;">
        </div>

        <div class="title-bar-box">
            <h5 class="fw-bold text-dark m-0">Operación Samaritan's Purse - Operación Niño de la Navidad</h5>
        </div>

        <div class="hero-banner shadow-sm">
            <h4 class="fw-bold mb-1">Modelo de Crecimiento y Multiplicación</h4>
            <p class="small mb-0 text-light">De Números a Vidas Transformadas</p>
        </div>

        <div class="card card-custom mb-3">
            <div class="card-header-custom"><i class="fas fa-bullseye me-2 text-danger"></i> 3. De Porcentajes a Números Reales</div>
            <div class="card-body small">
                <p class="mb-2">Metas claras y alcanzables a través de un proceso intencional de discipulado.</p>
                <ul class="ps-3 mb-0 text-muted">
                    <li><strong>Inscripción Esperada:</strong> Cuidar que cada cajita entregada llegue a un niño.</li>
                    <li><strong>Graduación Esperada:</strong> Lograr que los niños completen su discipulado.</li>
                </ul>
            </div>
        </div>

        <!-- Temporizador Obligatorio -->
        <div id="timerContainer" class="timer-box small shadow-sm">
            <i class="fas fa-hourglass-half fa-spin me-2"></i> Tiempo de lectura obligatorio: <span id="countdown" class="fs-5 text-dark">10</span>s
        </div>

        <!-- Formulario Oculto hasta terminar lectura -->
        <div id="formContainer" style="display: none;" class="form-section-box shadow">
            <div class="text-center mb-4">
                <h4 class="fw-bold mb-1 text-success"><i class="fas fa-file-alt me-2"></i> Formulario de Registro</h4>
            </div>

            <!-- NUEVO MÓDULO: RECOLECTOR DE DATOS POR IA / IMAGEN (OCR) -->
            <div class="ai-scanner-box text-center">
                <h5 class="fw-bold text-success mb-2">
                    <i class="fas fa-camera-retro me-2"></i> Relleno Automático por Imagen (IA)
                </h5>
                <p class="small text-light mb-3">
                    Sube la foto o captura de tu formato físico de registro para que el sistema extraiga y rellene los campos automáticamente.
                </p>

                <div class="mb-2">
                    <input type="file" id="inputImagenFormulario" accept="image/*" class="form-control form-control-sm bg-dark text-light border-success" onchange="procesarImagenConIA(event)">
                </div>

                <div id="statusEscaneo" class="small mt-2 font-monospace text-warning" style="min-height: 22px;"></div>
            </div>
            
            <form action="/guardar-registro" method="POST" id="registroForm">
                <div class="mb-3">
                    <label class="form-label fw-bold small">Zona de Captura: <span class="text-danger">*</span></label>
                    <select name="zona" id="input_zona" class="form-select form-select-sm" required>
                        <option value="">-- Seleccione una zona --</option>
                        <option value="san_andres">San Andrés Tuxtla</option>
                        <option value="medellin">Medellín</option>
                        <option value="manlio">Manlio Fabio</option>
                        <option value="orizaba">Orizaba</option>
                        <option value="cd_aleman">Ciudad Alemán</option>
                        <option value="xalapa">Xalapa</option>
                    </select>
                </div>

                <h6 class="border-bottom border-success pb-1 mb-3 small fw-bold text-success"><i class="fas fa-user-tie me-1"></i> 1. Datos del Pastor</h6>
                <div class="mb-2">
                    <label class="form-label small text-muted">Nombre del Pastor *</label>
                    <input type="text" name="nombre_pastor" id="nombre_pastor" class="form-control form-control-sm" required>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6"><label class="form-label small text-muted">Teléfono *</label><input type="tel" name="telefono_pastor" id="telefono_pastor" class="form-control form-control-sm" required></div>
                    <div class="col-6"><label class="form-label small text-muted">Correo (Opcional)</label><input type="email" name="correo_pastor" id="correo_pastor" class="form-control form-control-sm"></div>
                </div>

                <h6 class="border-bottom border-success pb-1 mb-3 small fw-bold text-success"><i class="fas fa-church me-1"></i> 2. Datos de la Iglesia</h6>
                <div class="mb-2"><label class="form-label small text-muted">Nombre de la Iglesia *</label><input type="text" name="nombre_iglesia" id="nombre_iglesia" class="form-control form-control-sm" required></div>
                <div class="mb-3"><label class="form-label small text-muted">Dirección *</label><input type="text" name="direccion" id="direccion" class="form-control form-control-sm" required></div>

                <h6 class="border-bottom border-success pb-1 mb-3 small fw-bold text-success"><i class="fas fa-users me-1"></i> 3. Datos del Líder</h6>
                <div class="mb-2"><label class="form-label small text-muted">Nombre del Líder *</label><input type="text" name="nombre_lider" id="nombre_lider" class="form-control form-control-sm" required></div>
                <div class="row g-2 mb-3">
                    <div class="col-6"><label class="form-label small text-muted">Teléfono *</label><input type="tel" name="telefono_lider" id="telefono_lider" class="form-control form-control-sm" required></div>
                    <div class="col-6"><label class="form-label small text-muted">Correo (Opcional)</label><input type="email" name="correo_lider" id="correo_lider" class="form-control form-control-sm"></div>
                </div>

                <h6 class="border-bottom border-success pb-1 mb-3 small fw-bold text-success"><i class="fas fa-box-open me-1"></i> 4. Solicitud de Cajas y Maestros</h6>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small text-muted">Cajitas Solicitadas *</label>
                        <select name="num_cajas" id="num_cajas" class="form-select form-select-sm" required onchange="calcularMaestros()">
                            <option value="">-- Seleccionar --</option>
                            <option value="50">50 Cajas (2 Maestros)</option>
                            <option value="100">100 Cajas (3 Maestros)</option>
                            <option value="150">150 Cajas (4 Maestros)</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">Maestros Mínimos</label>
                        <input type="text" id="num_maestros_display" class="form-control form-control-sm bg-light fw-bold text-success" readonly value="Seleccione cajas">
                    </div>
                </div>
                <div id="maestros-container" class="mb-3"></div>

                <!-- 5. RED DE APOYO ESPIRITUAL (7 GUERRERITOS - NIÑOS) -->
                <h6 class="border-bottom border-success pb-1 mb-3 small fw-bold text-success"><i class="fas fa-child me-1"></i> 5. Red de Apoyo Espiritual (7 Guerreritos - Niños)</h6>
                <div id="guerreritos-container">
                    <% for(let i = 1; i <= 7; i++) { %>
                        <div class="border p-2 mb-2 rounded bg-light">
                            <span class="small fw-bold text-success">Guerrerito #<%= i %> (Opcional)</span>
                            <div class="row g-1 mt-1">
                                <div class="col-md-4"><input type="text" name="guerreritos[<%= i-1 %>][nombre_guerrerito]" class="form-control form-control-sm input-guerrerito-nombre" placeholder="Nombre guerrerito"></div>
                                <div class="col-md-4"><input type="text" name="guerreritos[<%= i-1 %>][nombre_tutor]" class="form-control form-control-sm input-guerrerito-tutor" placeholder="Nombre tutor"></div>
                                <div class="col-md-4"><input type="tel" name="guerreritos[<%= i-1 %>][telefono_tutor]" class="form-control form-control-sm input-guerrerito-tel" placeholder="Teléfono tutor"></div>
                            </div>
                        </div>
                    <% } %>
                </div>

                <!-- 6. RED DE APOYO ESPIRITUAL (7 GUERREROS - ADULTOS) -->
                <h6 class="border-bottom border-success pb-1 mb-3 small fw-bold text-success mt-4"><i class="fas fa-user-shield me-1"></i> 6. Red de Apoyo Espiritual (7 Guerreros - Adultos)</h6>
                <div id="guerreros-container">
                    <% for(let i = 1; i <= 7; i++) { %>
                        <div class="border p-2 mb-2 rounded bg-light">
                            <span class="small fw-bold text-success">Guerrero Adulto #<%= i %> (Opcional)</span>
                            <div class="row g-1 mt-1">
                                <div class="col-md-7"><input type="text" name="guerreros[<%= i-1 %>][nombre_guerrero]" class="form-control form-control-sm input-guerrero-nombre" placeholder="Nombre completo del guerrero"></div>
                                <div class="col-md-5"><input type="tel" name="guerreros[<%= i-1 %>][telefono_guerrero]" class="form-control form-control-sm input-guerrero-tel" placeholder="Número de teléfono"></div>
                            </div>
                        </div>
                    <% } %>
                </div>

                <button type="submit" class="btn btn-danger w-100 fw-bold py-2 mt-3 shadow-sm"><i class="fas fa-paper-plane me-2"></i> Enviar Registro Oficial</button>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let timeLeft = 10;
        const timerInterval = setInterval(() => {
            timeLeft--;
            document.getElementById('countdown').innerText = timeLeft;
            if (timeLeft <= 0) {
                clearInterval(timerInterval);
                document.getElementById('timerContainer').style.display = 'none';
                document.getElementById('formContainer').style.display = 'block';
            }
        }, 1000);

        function calcularMaestros() {
            const cajas = document.getElementById('num_cajas').value;
            const display = document.getElementById('num_maestros_display');
            const container = document.getElementById('maestros-container');
            container.innerHTML = '';
            let count = cajas === "100" ? 3 : (cajas === "150" ? 4 : 2);
            if (cajas) {
                display.value = count + " Requeridos";
                let html = '<p class="small text-success fw-bold mb-2">Maestros Asignados:</p>';
                for (let i = 1; i <= count; i++) {
                    html += `
                        <div class="p-2 border border-success rounded bg-light mb-2">
                            <input type="text" name="maestros[${i}][nombre]" class="form-control form-control-sm mb-1" placeholder="Maestro ${i} - Nombre completo" required>
                            <div class="row g-1">
                                <div class="col-6"><input type="tel" name="maestros[${i}][telefono]" class="form-control form-control-sm" placeholder="Teléfono" required></div>
                                <div class="col-6"><input type="email" name="maestros[${i}][correo]" class="form-control form-control-sm" placeholder="Correo (opcional)"></div>
                            </div>
                        </div>`;
                }
                container.innerHTML = html;
            } else { display.value = "Seleccione cajas"; }
        }

        // --- MOTOR DE EXTRACCIÓN INTELIGENTE DE DATOS POR IMAGEN (IA / OCR) ---
        async function procesarImagenConIA(event) {
            const archivo = event.target.files[0];
            const statusVoz = document.getElementById('statusEscaneo');

            if (!archivo) return;

            statusVoz.innerHTML = '<i class="fas fa-circle-notch fa-spin text-warning me-1"></i> Analizando imagen con IA y extrayendo texto...';

            try {
                // Ejecutamos Tesseract.js directamente en el navegador para leer el texto de la imagen
                const resultado = await Tesseract.recognize(archivo, 'es', {
                    logger: m => {
                        if (m.status === 'recognizing text') {
                            let progreso = Math.round(m.progress * 100);
                            statusVoz.innerHTML = `<i class="fas fa-circle-notch fa-spin text-warning me-1"></i> Leyendo imagen: ${progreso}%`;
                        }
                    }
                });

                const textoExtraido = resultado.data.text;
                console.log("Texto detectado por la IA:", textoExtraido);

                // Procesamos el texto para autocompletar campos clave del formulario
                extraerYAsignarCampos(textoExtraido);

                statusVoz.innerHTML = '<i class="fas fa-check-circle text-success me-1"></i> ¡Datos extraídos y rellenados con éxito!';
            } catch (error) {
                console.error("Error al escanear la imagen:", error);
                statusVoz.innerHTML = '<i class="fas fa-exclamation-triangle text-danger me-1"></i> Error al procesar la imagen. Intenta con otra foto.';
            }
        }

        function extraerYAsignarCampos(texto) {
            const lineas = texto.split('\n').map(l => l.trim()).filter(l => l.length > 0);

            // Intentamos buscar patrones lógicos o palabras clave en el texto escaneado
            lineas.forEach(linea => {
                let lower = linea.toLowerCase();

                // Detección de Pastor
                if (lower.includes('pastor') || lower.includes('pastora')) {
                    let partes = linea.split(/:|-/);
                    let val = partes[1] ? partes[1].trim() : linea;
                    document.getElementById('nombre_pastor').value = val;
                }
                // Detección de Iglesia
                else if (lower.includes('iglesia') || lower.includes('templo')) {
                    let partes = linea.split(/:|-/);
                    let val = partes[1] ? partes[1].trim() : linea;
                    document.getElementById('nombre_iglesia').value = val;
                }
                // Detección de Dirección
                else if (lower.includes('direccion') || lower.includes('calle') || lower.includes('ubicacion')) {
                    let partes = linea.split(/:|-/);
                    let val = partes[1] ? partes[1].trim() : linea;
                    document.getElementById('direccion').value = val;
                }
                // Detección de Líder
                else if (lower.includes('lider') || lower.includes('líder')) {
                    let partes = linea.split(/:|-/);
                    let val = partes[1] ? partes[1].trim() : linea;
                    document.getElementById('nombre_lider').value = val;
                }
                // Detección de Teléfono (busca de 10 dígitos)
                else {
                    let telefonos = linea.match(/\d{10}/);
                    if (telefonos && !document.getElementById('telefono_pastor').value) {
                        document.getElementById('telefono_pastor').value = telefonos[0];
                    }
                }
            });

            // Detectar cantidad de cajas si aparece 50, 100 o 150 en el texto
            if (texto.includes('150')) {
                document.getElementById('num_cajas').value = '150';
                calcularMaestros();
            } else if (texto.includes('100')) {
                document.getElementById('num_cajas').value = '100';
                calcularMaestros();
            } else if (texto.includes('50')) {
                document.getElementById('num_cajas').value = '50';
                calcularMaestros();
            }
        }
    </script>
</body>
</html>
