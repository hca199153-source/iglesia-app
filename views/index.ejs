<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registro - Evento Especial</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  
  <style>
    :root {
      --primary-color: #0a163b;
      --accent-color: #d4af37;
      --bg-dark: #050b1e;
    }

    body {
      background-color: var(--bg-dark);
      color: #e2e8f0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      min-height: 100vh;
    }

    .header-banner {
      background: linear-gradient(135deg, #0a163b 0%, #1a2b5c 100%);
      border-bottom: 2px solid var(--accent-color);
      padding: 2.5rem 1rem;
      text-align: center;
    }

    .card-custom {
      background-color: #0d1b40;
      border: 1px solid rgba(212, 175, 55, 0.2);
      border-radius: 12px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    }

    .terms-box {
      background-color: #071026;
      border: 1px solid #1e2d5a;
      border-radius: 8px;
      max-height: 250px;
      overflow-y: auto;
      padding: 1.25rem;
      font-size: 0.9rem;
      line-height: 1.6;
    }

    .terms-box::-webkit-scrollbar {
      width: 6px;
    }

    .terms-box::-webkit-scrollbar-thumb {
      background: var(--accent-color);
      border-radius: 4px;
    }

    .btn-gold {
      background: linear-gradient(45deg, #d4af37, #f3e5ab);
      color: #000;
      font-weight: 600;
      border: none;
      transition: all 0.3s ease;
    }

    .btn-gold:hover {
      background: linear-gradient(45deg, #f3e5ab, #d4af37);
      box-shadow: 0 0 15px rgba(212, 175, 55, 0.4);
      color: #000;
    }

    .form-control, .form-select {
      background-color: #071026;
      border: 1px solid #1e2d5a;
      color: #fff;
    }

    .form-control:focus, .form-select:focus {
      background-color: #091533;
      border-color: var(--accent-color);
      color: #fff;
      box-shadow: 0 0 0 0.25rem rgba(212, 175, 55, 0.25);
    }

    .form-control::placeholder {
      color: #64748b;
    }

    .section-title {
      border-bottom: 1px solid rgba(212, 175, 55, 0.3);
      padding-bottom: 0.5rem;
      margin-bottom: 1.5rem;
      color: var(--accent-color);
    }

    .maestro-card {
      background-color: #091533;
      border-left: 3px solid var(--accent-color);
      padding: 1rem;
      margin-bottom: 0.75rem;
      border-radius: 0 6px 6px 0;
    }

    #seccionFormulario {
      display: none;
    }
  </style>
</head>
<body>

  <!-- Banner Superior -->
  <header class="header-banner mb-4">
    <div class="container">
      <h1 class="display-5 fw-bold text-white mb-2">Formulario de Registro</h1>
      <p class="lead text-warning mb-0">Gestión de Asistencia y Distribución de Materiales</p>
    </div>
  </header>

  <main class="container pb-5">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-10">

        <!-- Sección Términos y Condiciones -->
        <div class="card card-custom p-4 mb-4">
          <h3 class="h4 section-title"><i class="bi bi-shield-check me-2"></i>Términos y Condiciones</h3>
          <p class="small text-muted mb-3">Por favor, lea detenidamente las políticas antes de proceder con el registro.</p>
          
          <div class="terms-box mb-3">
            <h5 class="text-white h6">1. Registro de Participantes</h5>
            <p>Al completarlo, el usuario acepta dar información verídica y verificable sobre la iglesia y los representantes encargados.</p>
            
            <h5 class="text-white h6">2. Asignación de Materiales</h5>
            <p>Las cajas solicitadas están sujetas a disponibilidad y a la confirmación de datos por parte de los organizadores del evento.</p>
            
            <h5 class="text-white h6">3. Uso de Datos Personales</h5>
            <p>Los datos ingresados serán utilizados exclusivamente para fines coordinativos y de logística interna para el evento.</p>

            <h5 class="text-white h6">4. Compromiso de Asistencia</h5>
            <p>Se requiere que el líder y los maestros registrados se presenten en los horarios indicados durante las jornadas de entrega.</p>
          </div>

          <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div id="contenedorReloj" class="text-warning small fw-bold">
              <i class="bi bi-hourglass-split me-1"></i> Por favor lea los términos (<span id="contadorReloj">25s</span>)
            </div>
            <button id="btnAceptarTerminos" class="btn btn-gold px-4 py-2" style="display: none;" onclick="aceptarTerminos()">
              <i class="bi bi-check-circle-fill me-2"></i>Acepto los Términos y Continuar
            </button>
          </div>
        </div>

        <!-- Formulario de Registro Principal -->
        <div id="seccionFormulario" class="card card-custom p-4">

          <!-- Alertas de Éxito o Error -->
          <% if (mensajeExito) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
              <i class="bi bi-check-circle-fill me-2"></i> <%= mensajeExito %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% } %>

          <% if (mensajeError) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= mensajeError %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% } %>

          <h3 class="h4 section-title"><i class="bi bi-journal-text me-2"></i>Datos del Registro</h3>

          <form action="/guardar" method="POST">

            <!-- Datos del Pastor e Iglesia -->
            <div class="row g-3 mb-4">
              <div class="col-12"><h5 class="h6 text-warning"><i class="bi bi-building me-1"></i> Información General</h5></div>
              
              <div class="col-12 col-md-6">
                <label class="form-label small text-muted">Nombre del Pastor *</label>
                <input type="text" name="nombre_pastor" class="form-control" required placeholder="Nombre completo">
              </div>

              <div class="col-12 col-md-3">
                <label class="form-label small text-muted">Teléfono Pastor *</label>
                <input type="tel" name="telefono_pastor" class="form-control" maxlength="10" pattern="[0-9]{10}" required placeholder="10 dígitos">
              </div>

              <div class="col-12 col-md-3">
                <label class="form-label small text-muted">Correo Pastor</label>
                <input type="email" name="correo_pastor" class="form-control" placeholder="ejemplo@correo.com">
              </div>

              <div class="col-12 col-md-6">
                <label class="form-label small text-muted">Nombre de la Iglesia *</label>
                <input type="text" name="nombre_iglesia" class="form-control" required placeholder="Nombre oficial de la iglesia">
              </div>

              <div class="col-12 col-md-6">
                <label class="form-label small text-muted">Dirección de la Iglesia *</label>
                <input type="text" name="direccion" class="form-control" required placeholder="Calle, Número, Colonia, Ciudad">
              </div>

              <div class="col-12 col-md-4">
                <label class="form-label small text-muted">Número de Cajas *</label>
                <select name="num_cajas" id="selectCajas" class="form-select" onchange="actualizarMaestros()" required>
                  <option value="" selected disabled>Seleccione una opción</option>
                  <option value="50">50 Cajas (2 Maestros)</option>
                  <option value="100">100 Cajas (3 Maestros)</option>
                  <option value="150">150 Cajas (4 Maestros)</option>
                </select>
              </div>
            </div>

            <!-- Datos del Líder -->
            <div class="row g-3 mb-4">
              <div class="col-12"><h5 class="h6 text-warning"><i class="bi bi-person-badge me-1"></i> Información del Líder Encargado</h5></div>

              <div class="col-12 col-md-6">
                <label class="form-label small text-muted">Nombre del Líder *</label>
                <input type="text" name="nombre_lider" class="form-control" required placeholder="Nombre completo del líder">
              </div>

              <div class="col-12 col-md-3">
                <label class="form-label small text-muted">Teléfono Líder *</label>
                <input type="tel" name="telefono_lider" class="form-control" maxlength="10" pattern="[0-9]{10}" required placeholder="10 dígitos">
              </div>

              <div class="col-12 col-md-3">
                <label class="form-label small text-muted">Correo Líder</label>
                <input type="email" name="correo_lider" class="form-control" placeholder="ejemplo@correo.com">
              </div>
            </div>

            <!-- Registro Dinámico de Maestros -->
            <div id="contenedorMaestros" class="mb-4" style="display: none;">
              <h5 class="h6 text-warning mb-3"><i class="bi bi-people me-1"></i> Datos de Maestros Requeridos</h5>
              <div id="listaMaestrosCampos"></div>
            </div>

            <div class="text-end mt-4">
              <button type="submit" class="btn btn-gold btn-lg px-5">
                <i class="bi bi-send-fill me-2"></i>Enviar Registro
              </button>
            </div>

          </form>
        </div>

      </div>
    </div>
  </main>

  <!-- Bootstrap 5 JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    let tiempoRestante = 25;
    const contenedorReloj = document.getElementById('contenedorReloj');
    const contadorSpan = document.getElementById('contadorReloj');
    const btnAceptar = document.getElementById('btnAceptarTerminos');

    const temporizador = setInterval(() => {
      tiempoRestante--;
      if (contadorSpan) {
        contadorSpan.textContent = tiempoRestante + 's';
      }

      if (tiempoRestante <= 0) {
        clearInterval(temporizador);
        if (contenedorReloj) contenedorReloj.style.display = 'none';
        if (btnAceptar) btnAceptar.style.display = 'block';
      }
    }, 1000);

    function aceptarTerminos() {
      const seccionForm = document.getElementById('seccionFormulario');
      seccionForm.style.display = 'block';
      seccionForm.scrollIntoView({ behavior: 'smooth' });
    }

    function actualizarMaestros() {
      const cajas = document.getElementById('selectCajas').value;
      const contenedor = document.getElementById('contenedorMaestros');
      const lista = document.getElementById('listaMaestrosCampos');
      
      let numMaestros = 0;
      if (cajas === "50") numMaestros = 2;
      else if (cajas === "100") numMaestros = 3;
      else if (cajas === "150") numMaestros = 4;

      lista.innerHTML = '';

      if (numMaestros > 0) {
        contenedor.style.display = 'block';

        for (let i = 1; i <= numMaestros; i++) {
          const maestroHTML = `
            <div class="maestro-card shadow-sm">
              <div class="fw-bold text-white mb-2 small">
                <i class="bi bi-person-badge-fill me-1 text-warning"></i> Maestro ${i}
              </div>
              <div class="row g-2">
                <div class="col-12 col-md-6">
                  <input type="text" name="maestro_nombre[]" class="form-control form-control-sm" required placeholder="Nombre Completo *">
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                  <input type="tel" name="maestro_telefono[]" class="form-control form-control-sm" maxlength="10" pattern="[0-9]{10}" required placeholder="Teléfono (10 dígitos) *">
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                  <input type="email" name="maestro_correo[]" class="form-control form-control-sm" placeholder="Correo (opcional)">
                </div>
              </div>
            </div>
          `;
          lista.innerHTML += maestroHTML;
        }
      } else {
        contenedor.style.display = 'none';
      }
    }

    // Muestra el formulario si existe algún mensaje retornado por la URL
    document.addEventListener("DOMContentLoaded", () => {
      const hayExito = <%= mensajeExito ? 'true' : 'false' %>;
      const hayError = <%= mensajeError ? 'true' : 'false' %>;

      if (hayExito || hayError) {
        const seccionForm = document.getElementById('seccionFormulario');
        seccionForm.style.display = 'block';
        seccionForm.scrollIntoView({ behavior: 'smooth' });
      }
    });
  </script>
</body>
</html>
