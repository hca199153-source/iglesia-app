<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro | Samaritan's Purse</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <!-- Encabezado / Logo -->
        <header class="header">
            <div class="carousel-nav">&lt; --- &gt;</div>
            <div class="logo-box">Logo Samaritan's Purse</div>
            <h1>Registro Samaritan's Purse</h1>
            <div class="alert-box">⚠️ Por favor leer cuidadosamente los lineamientos</div>
        </header>

        <!-- Lineamientos Oficiales -->
        <section class="guidelines">
            <div class="guideline-card">
                <h3>Lineamiento 1: La Cajita como Herramienta Evangelística</h3>
                <p>Cada cajita representa una oportunidad estratégica para compartir el Evangelio de Jesucristo con un niño de forma clara y amorosa.</p>
            </div>
            <div class="guideline-card">
                <h3>Lineamiento 2: Discipulado "El Gran Viaje"</h3>
                <p>El evento evangelístico es el inicio. Cada niño debe ser invitado a participar en el programa de discipulado de 12 lecciones.</p>
            </div>
            <div class="guideline-card">
                <h3>Lineamiento 3: Proporción de Cajas y Maestros</h3>
                <p>50 Cajas = 2 Maestros | 100 Cajas = 3 Maestros | 150 Cajas = 4 Maestros</p>
            </div>
            <div class="guideline-card">
                <h3>Lineamiento 4, 5 y 6</h3>
                <p>Responsabilidad del maestro de acompañar 26 niños, requisitos del compañero de ministerio y elementos esenciales del discipulador.</p>
            </div>
            
            <div class="buttons-row">
                <button type="button" class="btn-info">Compromiso</button>
                <button type="button" class="btn-info">Objetivo</button>
            </div>
        </section>

        <!-- Temporizador Obligatorio de Lectura (23 segundos) -->
        <div class="timer-section" id="timerSection">
            <p>⏳ Tiempo de lectura obligatorio</p>
            <h2 id="countdown">23s</h2>
            <button type="button" id="acceptBtn" class="btn-disabled" disabled>Aceptar y Continuar</button>
        </div>

        <!-- Formulario Oculto hasta terminar el tiempo -->
        <form action="/guardar-registro" method="POST" id="registroForm" class="form-container" style="display: none;">
            <h2>Formulario de Registro</h2>
            
            <div class="form-group">
                <label>Seleccionar Zona:</label>
                <select name="zona" required>
                    <option value="">-- Seleccione una zona --</option>
                    <option value="san_andres">San Andrés Tuxtla, Veracruz</option>
                    <option value="cd_aleman">Ciudad Alemán</option>
                    <option value="xalapa">Xalapa</option>
                </select>
            </div>

            <!-- Datos del Pastor -->
            <fieldset>
                <legend>Datos del Pastor</legend>
                <div class="form-group"><label>Número / Teléfono:</label><input type="text" name="telefono_pastor" required></div>
                <div class="form-group"><label>Nombre del Pastor:</label><input type="text" name="nombre_pastor" required></div>
                <div class="form-group"><label>Correo Electrónico:</label><input type="email" name="correo_pastor" required></div>
            </fieldset>

            <!-- Datos de la Iglesia -->
            <fieldset>
                <legend>Datos de la Iglesia</legend>
                <div class="form-group"><label>Nombre de la Iglesia:</label><input type="text" name="nombre_iglesia" required></div>
                <div class="form-group"><label>Dirección:</label><textarea name="direccion" required></textarea></div>
            </fieldset>

            <!-- Datos del Líder -->
            <fieldset>
                <legend>Datos del Líder de Proyecto</legend>
                <div class="form-group"><label>Nombre del Líder:</label><input type="text" name="nombre_lider" required></div>
                <div class="form-group"><label>Teléfono:</label><input type="text" name="telefono_lider" required></div>
                <div class="form-group"><label>Correo:</label><input type="email" name="correo_lider" required></div>
            </fieldset>

            <!-- Asignación de Cajas y Maestros dinámicos -->
            <fieldset>
                <legend>Asignación de Cajas y Maestros</legend>
                <div class="form-group">
                    <label>Cantidad de Cajitas Solicitadas:</label>
                    <select name="num_cajas" id="num_cajas" required>
                        <option value="50">50 Cajas (Mínimo 2 Maestros)</option>
                        <option value="100">100 Cajas (Mínimo 3 Maestros)</option>
                        <option value="150">150 Cajas (Mínimo 4 Maestros)</option>
                    </select>
                </div>
                <div id="maestrosContainer">
                    <!-- Se llenará dinámicamente con JS -->
                </div>
            </fieldset>

            <!-- Guerreritos y Tutores -->
            <fieldset>
                <legend>Guerreritos de Oración y Tutores</legend>
                <div class="form-group"><label>Nombre del Guerrerito de Oración:</label><input type="text" name="guerrerito_nombre"></div>
                <div class="form-group"><label>Guerrero de Oración (Nombre y Teléfono):</label>
                    <input type="text" name="guerrero_nombre" placeholder="Nombre">
                    <input type="text" name="guerrero_telefono" placeholder="Teléfono">
                </div>
                <div class="form-group"><label>Tutores de Guerreritos (Nombre y Teléfono):</label>
                    <input type="text" name="tutor_nombre" placeholder="Nombre">
                    <input type="text" name="tutor_telefono" placeholder="Teléfono">
                </div>
            </fieldset>

            <button type="submit" class="btn-submit">Guardar Registro</button>
        </form>
    </div>

    <script>
        // Lógica del temporizador de 23 segundos
        let timeLeft = 23;
        const countdownEl = document.getElementById('countdown');
        const acceptBtn = document.getElementById('acceptBtn');
        const timerSection = document.getElementById('timerSection');
        const registroForm = document.getElementById('registroForm');

        const timer = setInterval(() => {
            timeLeft--;
            countdownEl.textContent = timeLeft + 's';
            if (timeLeft <= 0) {
                clearInterval(timer);
                timerSection.style.display = 'none';
                registroForm.style.display = 'block';
            }
        }, 1000);

        // Dinámica de maestros según cajas seleccionadas
        const selectCajas = document.getElementById('num_cajas');
        const maestrosContainer = document.getElementById('maestrosContainer');

        function actualizarMaestros() {
            const cajas = parseInt(selectCajas.value);
            let numMaestros = 2;
            if (cajas === 100) numMaestros = 3;
            if (cajas === 150) numMaestros = 4;

            let html = `<h4>Debe registrar ${numMaestros} maestros para ${cajas} cajas:</h4>`;
            for (let i = 1; i <= numMaestros; i++) {
                html += `
                    <div class="sub-card">
                        <h5>Maestro ${i}</h5>
                        <input type="text" name="maestros[${i}][nombre]" placeholder="Nombre completo" required>
                        <input type="text" name="maestros[${i}][telefono]" placeholder="Teléfono" required>
                        <input type="email" name="maestros[${i}][correo]" placeholder="Correo electrónico" required>
                    </div>
                `;
            }
            maestrosContainer.innerHTML = html;
        }

        selectCajas.addEventListener('change', actualizarMaestros);
        window.addEventListener('DOMContentLoaded', actualizarMaestros);
    </script>
</body>
</html>
