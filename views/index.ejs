<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registro de Iglesia - Samaritan's Purse</title>
  
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <style>
    body {
      background: linear-gradient(135deg, #1b381e 0%, #0a170c 100%);
      min-height: 100vh;
      color: #ffffff;
      padding: 15px 0;
    }
    .card-custom {
      background-color: #1e7e34;
      border: 2px solid #28a745;
      border-radius: 16px;
      color: #ffffff;
    }
    .card-terms {
      background-color: #ffffff;
      border-radius: 20px;
      color: #1a1a1a;
      border: 4px solid #198754;
    }
    .terms-box {
      background-color: #f4f6f8;
      border-radius: 14px;
      padding: 15px;
      max-height: 480px;
      overflow-y: auto;
    }
    .form-label {
      color: #ffffff !important;
      font-weight: 600;
      font-size: 0.9rem;
    }
    .form-control, .form-select {
      background-color: rgba(255, 255, 255, 0.95) !important;
      border: 1px solid #155724;
      color: #000000 !important;
      font-weight: 500;
      font-size: 0.95rem;
    }
    .form-control:focus, .form-select:focus {
      background-color: #ffffff !important;
      color: #000000 !important;
      border-color: #28a745;
      box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.4);
    }
    .form-control::placeholder {
      color: #6c757d;
    }
    .carousel-item img {
      height: 240px;
      object-fit: cover;
      border-radius: 12px;
    }
    @media (min-width: 768px) {
      body { padding: 30px 0; }
      .carousel-item img { height: 320px; }
    }
    .btn-submit {
      background-color: #ffffff;
      color: #1e7e34;
      border: none;
      transition: all 0.3s ease;
    }
    .btn-submit:hover {
      background-color: #d4edda;
      color: #155724;
      transform: translateY(-2px);
    }
    .section-header {
      color: #ffffff;
      border-bottom: 2px solid rgba(255, 255, 255, 0.3);
      font-size: 1.1rem;
    }
    .app-logo {
      max-height: 75px;
      object-fit: contain;
    }
    .timer-badge {
      font-size: 1.5rem;
      letter-spacing: 2px;
    }
    .maestro-card {
      background-color: rgba(255, 255, 255, 0.1);
      border: 1px dashed rgba(255, 255, 255, 0.4);
      border-radius: 10px;
      padding: 12px;
    }
  </style>
</head>
<body>

  <div class="container my-auto">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-9">
        
        <!-- CARRUSEL DE IMÁGENES -->
        <div id="carouselIglesia" class="carousel slide mb-3 mb-md-4 shadow-lg rounded-3 overflow-hidden" data-bs-ride="carousel">
          <div class="carousel-indicators">
            <button type="button" data-bs-target="#carouselIglesia" data-bs-slide-to="0" class="active"></button>
            <button type="button" data-bs-target="#carouselIglesia" data-bs-slide-to="1"></button>
          </div>
          <div class="carousel-inner">
            <div class="carousel-item active">
              <img src="/images/foto1.jpg" class="d-block w-100" alt="Fotografía 1" onerror="this.src='/images/foto1.png'">
            </div>
            <div class="carousel-item">
              <img src="/images/foto2.jpg" class="d-block w-100" alt="Fotografía 2" onerror="this.src='/images/foto2.png'">
            </div>
          </div>
          <button class="carousel-control-prev" type="button" data-bs-target="#carouselIglesia" data-bs-slide-prev>
            <span class="carousel-control-prev-icon"></span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#carouselIglesia" data-bs-slide-next>
            <span class="carousel-control-next-icon"></span>
          </button>
        </div>

        <!-- SECCIÓN 1: TÉRMINOS Y CONDICIONES -->
        <div id="seccionTerminos" class="card card-terms shadow-lg p-3 p-md-4 mb-4">
          <div class="text-center mb-3">
            <img src="/images/logo.png" alt="Logo Samaritan's Purse" class="app-logo bg-white p-2 rounded shadow-sm mb-2">
            <h4 class="fw-bold text-success mb-1">Modelo de Crecimiento y Multiplicación</h4>
            <span class="badge bg-warning text-dark px-3 py-2 fs-6 shadow-sm">
              <i class="bi bi-exclamation-triangle-fill me-1"></i> Por favor lea cuidadosamente los lineamientos
            </span>
          </div>

          <div class="terms-box shadow-sm mb-3">
            
            <!-- PUNTO 1 -->
            <div class="card border-0 shadow-sm mb-3 overflow-hidden" style="border-left: 5px solid #198754 !important;">
              <div class="card-body bg-light p-3">
                <div class="d-flex align-items-center mb-2">
                  <div class="bg-success text-white p-2 rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                    <i class="bi bi-box-seam fs-5"></i>
                  </div>
                  <h6 class="fw-bold text-dark mb-0">1. La Cajita de Regalo como Herramienta Evangelística</h6>
                </div>
                <p class="small text-muted mb-0">Cada cajita de regalo representa una oportunidad estratégica para compartir el Evangelio de Jesucristo con un niño de forma clara, amorosa y personalizada en su propia comunidad.</p>
              </div>
            </div>

            <!-- PUNTO 2 -->
            <div class="card border-0 shadow-sm mb-3 overflow-hidden" style="border-left: 5px solid #0d6efd !important;">
              <div class="card-body bg-light p-3">
                <div class="d-flex align-items-center mb-2">
                  <div class="bg-primary text-white p-2 rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                    <i class="bi bi-book-half fs-5"></i>
                  </div>
                  <h6 class="fw-bold text-dark mb-0">2. Discipulado "El Gran Viaje"</h6>
                </div>
                <p class="small text-muted mb-0">El evento evangelístico es solo el inicio. Cada niño que recibe una cajita debe ser invitado a participar en el programa de discipulado de 12 lecciones diseñado para guiarlo a seguir a Cristo.</p>
              </div>
            </div>

            <!-- PUNTO 3 -->
            <div class="card border-0 shadow-sm mb-3 overflow-hidden" style="border-left: 5px solid #6f42c1 !important;">
              <div class="card-body bg-light p-3">
                <div class="d-flex align-items-center mb-2">
                  <div class="bg-purple text-white p-2 rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; background-color: #6f42c1;">
                    <i class="bi bi-diagram-3-fill fs-5"></i>
                  </div>
                  <h6 class="fw-bold text-dark mb-0">3. Proporción de Cajas y Maestros</h6>
                </div>
                <p class="small text-muted mb-2">Para garantizar la atención y el discipulado efectivo, la asignación de materiales se calcula bajo la siguiente proporción obligatoria:</p>
                <div class="row g-2 text-center small">
                  <div class="col-4"><div class="p-2 bg-white border rounded"><strong>50 Cajas</strong><br><span class="text-success fw-bold">2 Maestros</span></div></div>
                  <div class="col-4"><div class="p-2 bg-white border rounded"><strong>100 Cajas</strong><br><span class="text-primary fw-bold">3 Maestros</span></div></div>
                  <div class="col-4"><div class="p-2 bg-white border rounded"><strong>150 Cajas</strong><br><span class="text-warning fw-bold">4 Maestros</span></div></div>
                </div>
              </div>
            </div>

            <!-- PUNTO 4 -->
            <div class="card border-0 shadow-sm mb-3 overflow-hidden" style="border-left: 5px solid #fd7e14 !important;">
              <div class="card-body bg-light p-3">
                <div class="d-flex align-items-center mb-2">
                  <div class="bg-warning text-dark p-2 rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                    <i class="bi bi-person-workspace fs-5"></i>
                  </div>
                  <h6 class="fw-bold text-dark mb-0">4. Responsabilidad del Maestro</h6>
                </div>
                <p class="small text-muted mb-2">Cada maestro debe acompañar aproximadamente <strong>26 niños</strong> durante todo el proceso:</p>
                <div class="row g-2">
                  <div class="col-12 col-sm-6 col-md-4"><span class="badge bg-white text-dark border p-2 w-100 text-start"><i class="bi bi-person-plus-fill text-success me-1"></i> Inscribir a los niños</span></div>
                  <div class="col-12 col-sm-6 col-md-4"><span class="badge bg-white text-dark border p-2 w-100 text-start"><i class="bi bi-calendar-check-fill text-primary me-1"></i> Seguimiento semanal</span></div>
                  <div class="col-12 col-sm-6 col-md-4"><span class="badge bg-white text-dark border p-2 w-100 text-start"><i class="bi bi-heart-pulse-fill text-danger me-1"></i> Crecimiento espiritual</span></div>
                  <div class="col-12 col-sm-6 col-md-6"><span class="badge bg-white text-dark border p-2 w-100 text-start"><i class="bi bi-mortarboard-fill text-warning me-1"></i> Llevarlos a la graduación</span></div>
                  <div class="col-12 col-sm-6 col-md-6"><span class="badge bg-white text-dark border p-2 w-100 text-start"><i class="bi bi-hands me-1 text-info"></i> Orar por el niño y su familia</span></div>
                </div>
              </div>
            </div>

            <!-- PUNTO 5 -->
            <div class="card border-0 shadow-sm mb-3 overflow-hidden" style="border-left: 5px solid #0d6efd !important;">
              <div class="card-body bg-light p-3">
                <div class="d-flex align-items-center mb-2">
                  <div class="bg-primary text-white p-2 rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                    <i class="bi bi-clipboard-check fs-5"></i>
                  </div>
                  <h6 class="fw-bold text-dark mb-0">5. Requisitos para el Compañero de Ministerio (CM)</h6>
                </div>
                <ul class="list-group list-group-flush small mb-2">
                  <li class="list-group-item bg-transparent p-1"><i class="bi bi-check-circle-fill text-primary me-2"></i>Contar con el número mínimo de maestros.</li>
                  <li class="list-group-item bg-transparent p-1"><i class="bi bi-check-circle-fill text-primary me-2"></i>Tener un plan claro para el discipulado.</li>
                  <li class="list-group-item bg-transparent p-1"><i class="bi bi-check-circle-fill text-primary me-2"></i>Organizar los eventos evangelísticos.</li>
                  <li class="list-group-item bg-transparent p-1"><i class="bi bi-check-circle-fill text-primary me-2"></i>Comprometerse con el seguimiento hasta la graduación.</li>
                  <li class="list-group-item bg-transparent p-1"><i class="bi bi-check-circle-fill text-primary me-2"></i>Reportar resultados y testimonios.</li>
                </ul>
                <div class="p-2 bg-primary bg-opacity-10 border border-primary rounded text-primary small fw-bold">
                  <i class="bi bi-info-circle-fill me-1"></i> El CM es clave para que cada cajita se convierta en un niño discipulado y graduado.
                </div>
              </div>
            </div>

            <!-- PUNTO 6 -->
            <div class="card border-0 shadow-sm mb-3 overflow-hidden" style="border-left: 5px solid #198754 !important;">
              <div class="card-body bg-light p-3">
                <div class="d-flex align-items-center mb-2">
                  <div class="bg-success text-white p-2 rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                    <i class="bi bi-people-fill fs-5"></i>
                  </div>
                  <h6 class="fw-bold text-dark mb-0">6. Elementos que debe tener un Discipulador</h6>
                </div>
                <div class="row g-2 small">
                  <div class="col-12 col-md-6"><div class="p-2 bg-white rounded border"><i class="bi bi-heart-fill text-danger me-2"></i>Comprometido con Cristo</div></div>
                  <div class="col-12 col-md-6"><div class="p-2 bg-white rounded border"><i class="bi bi-book-fill text-primary me-2"></i>Conocimiento básico de la Biblia</div></div>
                  <div class="col-12 col-md-6"><div class="p-2 bg-white rounded border"><i class="bi bi-fire text-warning me-2"></i>Hombre o mujer de oración</div></div>
                  <div class="col-12 col-md-6"><div class="p-2 bg-white rounded border"><i class="bi bi-clock-fill text-secondary me-2"></i>Disponible para acompañar a los niños</div></div>
                  <div class="col-12 col-md-6"><div class="p-2 bg-white rounded border"><i class="bi bi-calendar2-week-fill text-success me-2"></i>Constante en las reuniones</div></div>
                  <div class="col-12 col-md-6"><div class="p-2 bg-white rounded border"><i class="bi bi-star-fill text-warning me-2"></i>Buen ejemplo cristiano</div></div>
                </div>
              </div>
            </div>

            <!-- COMPROMISO Y OBJETIVO -->
            <div class="row g-2 text-center">
              <div class="col-12 col-md-6">
                <div class="p-3 bg-danger text-white rounded-3 shadow-sm h-100">
                  <i class="bi bi-bullseye fs-2 mb-1 d-block"></i>
                  <h6 class="fw-bold text-uppercase mb-1">Nuestro Compromiso</h6>
                  <p class="small mb-0">No se trata de cuánto porcentaje logramos, sino de cuántos niños <strong>inscribimos y cuidamos</strong> para graduarse.</p>
                </div>
              </div>
              <div class="col-12 col-md-6">
                <div class="p-3 bg-success text-white rounded-3 shadow-sm h-100">
                  <i class="bi bi-trophy-fill fs-2 mb-1 d-block"></i>
                  <h6 class="fw-bold text-uppercase mb-1">Objetivo Final</h6>
                  <p class="small mb-0">Vidas transformadas que sirven y multiplican el Evangelio.</p>
                </div>
              </div>
            </div>

          </div>

          <!-- RELOJ Y BOTÓN DE ACEPTAR -->
          <div class="text-center">
            <div id="contenedorReloj" class="p-3 bg-light border border-secondary rounded-3 shadow-sm d-inline-block w-100">
              <div class="text-muted small fw-bold mb-1">
                <i class="bi bi-hourglass-split me-1 text-warning"></i> Tiempo de lectura obligatorio
              </div>
              <span id="contadorReloj" class="badge bg-dark text-warning timer-badge px-4 py-2 rounded-pill shadow">
                25s
              </span>
            </div>

            <button id="btnAceptarTerminos" class="btn btn-success btn-lg fw-bold px-4 py-3 shadow w-100" style="display: none;" onclick="aceptarTerminos()">
              <i class="bi bi-check-circle-fill me-2"></i>Aceptar Términos y Continuar
            </button>
          </div>
        </div>

        <!-- SECCIÓN 2: FORMULARIO DE CAPTURA -->
        <div id="seccionFormulario" class="card card-custom shadow-lg p-3 p-md-5" style="display: none;">
          
          <div class="text-center mb-4">
            <div class="mb-3">
              <img src="/images/logo.png" alt="Logo Samaritan's Purse" class="app-logo bg-white p-2 rounded shadow-sm">
            </div>
            <h3 class="fw-bold text-white mb-1">Formulario de Registro</h3>
            <p class="text-white-50 small">Por favor complete la información requerida a continuación</p>
          </div>

          <% if (mensajeExito) { %>
            <div class="alert alert-success alert-dismissible fade show fw-bold text-dark" role="alert">
              <i class="bi bi-check-circle-fill me-2"></i><%= mensajeExito %>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          <% } %>

          <% if (mensajeError) { %>
            <div class="alert alert-warning alert-dismissible fade show fw-bold text-dark" role="alert">
              <i class="bi bi-exclamation-triangle-fill me-2"></i><%= mensajeError %>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          <% } %>

          <form action="/guardar" method="POST">
            
            <!-- Datos del Pastor -->
            <h5 class="section-header pb-2 mb-3 fw-bold">
              <i class="bi bi-person-badge me-2"></i>Datos del Pastor
            </h5>
            <div class="row g-3 mb-4">
              <div class="col-12 col-md-6">
                <label class="form-label">Nombre del Pastor *</label>
                <input type="text" name="nombre_pastor" class="form-control" required placeholder="Ej: Juan Pérez">
              </div>
              <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label">Teléfono *</label>
                <input type="tel" name="telefono_pastor" class="form-control" maxlength="10" pattern="[0-9]{10}" required placeholder="10 dígitos">
              </div>
              <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label">Correo Electrónico</label>
                <input type="email" name="correo_pastor" class="form-control" placeholder="opcional">
              </div>
            </div>

            <!-- Datos de la Iglesia -->
            <h5 class="section-header pb-2 mb-3 fw-bold">
              <i class="bi bi-building me-2"></i>Datos de la Iglesia
            </h5>
            <div class="row g-3 mb-4">
              <div class="col-12 col-md-6">
                <label class="form-label">Nombre de la Iglesia *</label>
                <input type="text" name="nombre_iglesia" class="form-control" required placeholder="Ej: Iglesia Central">
              </div>
              <div class="col-12 col-md-6">
                <label class="form-label">Dirección</label>
                <input type="text" name="direccion" class="form-control" placeholder="Calle, Número, Ciudad">
              </div>
            </div>

            <!-- Datos del Líder -->
            <h5 class="section-header pb-2 mb-3 fw-bold">
              <i class="bi bi-person-check me-2"></i>Datos del Líder
            </h5>
            <div class="row g-3 mb-4">
              <div class="col-12 col-md-6">
                <label class="form-label">Nombre del Líder *</label>
                <input type="text" name="nombre_lider" class="form-control" required placeholder="Ej: María Gómez">
              </div>
              <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label">Teléfono *</label>
                <input type="tel" name="telefono_lider" class="form-control" maxlength="10" pattern="[0-9]{10}" required placeholder="10 dígitos">
              </div>
              <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label">Correo Electrónico</label>
                <input type="email" name="correo_lider" class="form-control" placeholder="opcional">
              </div>
            </div>

            <!-- Cantidad de Cajas -->
            <h5 class="section-header pb-2 mb-3 fw-bold">
              <i class="bi bi-box-seam me-2"></i>Asignación de Cajas y Maestros
            </h5>
            <div class="row g-3 mb-4">
              <div class="col-12">
                <label class="form-label">Selecciona la cantidad de cajitas solicitadas *</label>
                <select name="num_cajas" id="selectCajas" class="form-select" required onchange="actualizarMaestros()">
                  <option value="" disabled selected>-- Selecciona una opción --</option>
                  <option value="50">50 Cajas (Requiere 2 Maestros)</option>
                  <option value="100">100 Cajas (Requiere 3 Maestros)</option>
                  <option value="150">150 Cajas (Requiere 4 Maestros)</option>
                </select>
              </div>
            </div>

            <!-- Contenedor Dinámico para Maestros -->
            <div id="contenedorMaestros" class="mb-4" style="display: none;">
              <h6 class="text-warning fw-bold mb-3">
                <i class="bi bi-people-fill me-2"></i>Registro de Maestros Requeridos
              </h6>
              <div id="listaMaestrosCampos" class="d-flex flex-column gap-3">
                <!-- Se llena dinámicamente con JavaScript -->
              </div>
            </div>

            <button type="submit" class="btn btn-submit w-100 py-3 fw-bold fs-5 shadow">
              <i class="bi bi-send-fill me-2"></i>Enviar Registro
            </button>
          </form>

        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <!-- CONTROL DE TIEMPO, FORMULARIO Y REGISTRO DE MAESTROS -->
  <script>
    let tiempoRestante = 25;
    const contenedorReloj = document.getElementById('contenedorReloj');
    const contadorSpan = document.getElementById('contadorReloj');
    const btnAceptar = document.getElementById('btnAceptarTerminos');

    const temporizador = setInterval(() => {
      tiempoRestante--;
      if (contadorSpan) {
        contadorSpan.textContent = tiempoRestante + 's';
      }

      if (tiempoRestante <= 0) {
        clearInterval(temporizador);
        contenedorReloj.style.display = 'none';
        btnAceptar.style.display = 'block';
      }
    }, 1000);

    function aceptarTerminos() {
      const seccionForm = document.getElementById('seccionFormulario');
      seccionForm.style.display = 'block';
      seccionForm.scrollIntoView({ behavior: 'smooth' });
    }

    // Generador dinámico de campos para maestros
    function actualizarMaestros() {
      const cajas = document.getElementById('selectCajas').value;
      const contenedor = document.getElementById('contenedorMaestros');
      const lista = document.getElementById('listaMaestrosCampos');
      
      let numMaestros = 0;
      if (cajas === "50") numMaestros = 2;
      else if (cajas === "100") numMaestros = 3;
      else if (cajas === "150") numMaestros = 4;

      lista.innerHTML = '';

      if (numMaestros > 0) {
        contenedor.style.display = 'block';

        for (let i = 1; i <= numMaestros; i++) {
          const maestroHTML = `
            <div class="maestro-card shadow-sm">
              <div class="fw-bold text-white mb-2 small">
                <i class="bi bi-person-badge-fill me-1 text-warning"></i> Maestro ${i}
              </div>
              <div class="row g-2">
                <div class="col-12 col-md-6">
                  <input type="text" name="maestro_nombre[]" class="form-control form-control-sm" required placeholder="Nombre Completo *">
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                  <input type="tel" name="maestro_telefono[]" class="form-control form-control-sm" maxlength="10" pattern="[0-9]{10}" required placeholder="Teléfono (10 dígitos) *">
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                  <input type="email" name="maestro_correo[]" class="form-control form-control-sm" placeholder="Correo (opcional)">
                </div>
              </div>
            </div>
          `;
          lista.innerHTML += maestroHTML;
        }
      } else {
        contenedor.style.display = 'none';
      }
    }
  </script>

</body>
</html>
