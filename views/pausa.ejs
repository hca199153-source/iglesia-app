<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Página en Mantenimiento | Samaritan's Purse</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #0b221a; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #ffffff; margin: 0; padding: 20px; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
        .pause-container { max-width: 650px; width: 100%; background: #009639; border-radius: 20px; padding: 30px; text-align: center; box-shadow: 0 15px 35px rgba(0,0,0,0.6); }
        .header-box { background: #ffffff; border-radius: 12px; padding: 15px; margin-bottom: 20px; }
        .hero-title { font-weight: bold; color: #ffffff; }
        .timer-badge { background: #0b221a; color: #ffc107; font-size: 1.5rem; font-weight: bold; border-radius: 10px; padding: 10px 20px; display: inline-block; margin: 15px 0; border: 2px dashed #ffc107; }
        
        /* ESTILOS DEL MINIJUEGO CAJITA JUMP */
        #gameCanvas { background-color: #ffffff; border-radius: 12px; border: 3px solid #0b221a; display: block; margin: 15px auto; max-width: 100%; }
        .game-instructions { font-size: 0.8rem; color: #e0e0e0; margin-bottom: 5px; }
    </style>
</head>
<body>

    <div class="pause-container">
        <div class="header-box">
            <img src="/images/logo.png" alt="Samaritan's Purse" style="height: 55px;">
        </div>

        <% if (tipo === 'mantenimiento') { %>
            <h3 class="hero-title"><i class="fas fa-tools me-2 text-warning"></i> Estamos realizando mejoras</h3>
        <% } else { %>
            <h3 class="hero-title"><i class="fas fa-clock me-2 text-danger"></i> Periodo de Registros Finalizado</h3>
        <% } %>

        <p class="mt-3 fs-5 opacity-90"><%= mensaje %></p>

        <!-- CRONÓMETRO REGRESIVO -->
        <% if (targetDate) { %>
            <div class="timer-badge shadow-sm">
                <i class="fas fa-hourglass-half me-2 fa-spin"></i>
                <span id="timerDisplay">Calculando...</span>
            </div>
        <% } %>

        <hr class="my-4 border-light">

        <!-- MINIJUEGO SAMARITAN BOX JUMP -->
        <h6 class="fw-bold"><i class="fas fa-gamepad me-2"></i> ¡Diviértete mientras esperas! (Samaritan Box Jump)</h6>
        <p class="game-instructions">Presiona <strong>Espacio</strong> o <strong>Toca la pantalla</strong> para saltar con la Cajita de Regalo.</p>

        <canvas id="gameCanvas" width="500" height="150"></canvas>
        <button id="btnStartGame" class="btn btn-light btn-sm fw-bold px-4 text-success" onclick="iniciarJuego()"><i class="fas fa-play me-1"></i> Iniciar Minijuego</button>
    </div>

    <script>
        // LÓGICA DEL CRONÓMETRO REGRESIVO
        const targetTime = "<%= targetDate %>";
        if (targetTime && targetTime !== "null") {
            const countDate = parseInt(targetTime);
            const timerDisplay = document.getElementById('timerDisplay');

            const timerInterval = setInterval(() => {
                const now = new Date().getTime();
                const distance = countDate - now;

                if (distance < 0) {
                    clearInterval(timerInterval);
                    timerDisplay.innerText = "¡El tiempo ha concluido!";
                } else {
                    const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                    const seconds = Math.floor((distance % (1000 * 60)) / 1000);
                    timerDisplay.innerText = `${hours}h ${minutes}m ${seconds}s`;
                }
            }, 1000);
        }

        // MINIJUEGO CAJITA JUMP (ESTILO DINOSAURIO DE CHROME)
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        let gameRunning = false;
        let score = 0;

        let box = { x: 40, y: 100, width: 30, height: 30, dy: 0, gravity: 0.6, jump: -10, grounded: true };
        let obstacles = [];
        let gameFrame = 0;

        function iniciarJuego() {
            if (gameRunning) return;
            gameRunning = true;
            score = 0;
            obstacles = [];
            box.y = 100;
            box.dy = 0;
            document.getElementById('btnStartGame').style.display = 'none';
            loop();
        }

        function jump() {
            if (box.grounded && gameRunning) {
                box.dy = box.jump;
                box.grounded = false;
            }
        }

        document.addEventListener('keydown', (e) => {
            if (e.code === 'Space') { jump(); e.preventDefault(); }
        });
        canvas.addEventListener('touchstart', (e) => { jump(); e.preventDefault(); });

        function loop() {
            if (!gameRunning) return;

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Suelo
            ctx.fillStyle = '#0b221a';
            ctx.fillRect(0, 130, canvas.width, 20);

            // Gravedad de la Cajita
            box.dy += box.gravity;
            box.y += box.dy;

            if (box.y >= 100) {
                box.y = 100;
                box.dy = 0;
                box.grounded = true;
            }

            // Dibujar Cajita de Samaritan's Purse (Verde con lazo Rojo)
            ctx.fillStyle = '#009639';
            ctx.fillRect(box.x, box.y, box.width, box.height);
            ctx.fillStyle = '#dc3545';
            ctx.fillRect(box.x + 12, box.y, 6, box.height); // Lazo vertical
            ctx.fillRect(box.x, box.y + 12, box.width, 6); // Lazo horizontal

            // Generar Obstáculos
            gameFrame++;
            if (gameFrame % 90 === 0) {
                obstacles.push({ x: canvas.width, y: 105, width: 18, height: 25 });
            }

            for (let i = 0; i < obstacles.length; i++) {
                let obs = obstacles[i];
                obs.x -= 5;

                // Dibujar Obstáculo
                ctx.fillStyle = '#dc3545';
                ctx.fillRect(obs.x, obs.y, obs.width, obs.height);

                // Colisión
                if (
                    box.x < obs.x + obs.width &&
                    box.x + box.width > obs.x &&
                    box.y < obs.y + obs.height &&
                    box.y + box.height > obs.y
                ) {
                    gameRunning = false;
                    alert('¡Juego Terminado! Tu puntuación fue: ' + score);
                    document.getElementById('btnStartGame').style.display = 'inline-block';
                    document.getElementById('btnStartGame').innerText = 'Volver a Jugar';
                    return;
                }
            }

            obstacles = obstacles.filter(obs => obs.x > -20);
            score++;

            // Puntuación
            ctx.fillStyle = '#0b221a';
            ctx.font = '14px Segoe UI';
            ctx.fillText('Puntos: ' + score, 400, 25);

            requestAnimationFrame(loop);
        }
    </script>
</body>
</html>
