<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dev Access | Samaritan's Purse</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #0b221a; font-family: 'Consolas', 'Courier New', monospace; color: #00ff66; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
        .dev-card { background: #071711; border: 2px solid #009639; border-radius: 12px; padding: 30px; width: 100%; max-width: 400px; box-shadow: 0 0 20px rgba(0,255,102,0.2); }
        .form-control { background-color: #0b221a; border: 1px solid #009639; color: #00ff66; font-family: monospace; }
        .form-control:focus { background-color: #0b221a; color: #00ff66; border-color: #00ff66; box-shadow: 0 0 10px rgba(0,255,102,0.3); }
        .btn-dev { background: #009639; color: white; border: none; font-weight: bold; }
        .btn-dev:hover { background: #007a2e; color: #00ff66; }
    </style>
</head>
<body>
    <div class="dev-card text-center">
        <i class="fas fa-terminal fa-3x mb-3 text-success"></i>
        <h5 class="fw-bold text-white mb-1">&lt;DevMaster /&gt;</h5>
        <p class="small text-muted mb-4">Mantenimiento y Control de Estado</p>

        <% if (error) { %>
            <div class="alert alert-danger py-2 small fw-bold"><%= error %></div>
        <% } %>

        <form action="/dev-admin/login" method="POST">
            <div class="mb-3 text-start">
                <label class="form-label small">&gt; Admin Key Password:</label>
                <input type="password" name="password" class="form-control form-control-sm" placeholder="••••••••" required autofocus>
            </div>
            <button type="submit" class="btn btn-dev btn-sm w-100 py-2 mt-2"><i class="fas fa-key me-1"></i> Authenticate</button>
        </form>
    </div>
</body>
</html>
