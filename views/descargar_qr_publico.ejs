<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Descargar Mi Código QR | Samaritan's Purse</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #0b221a;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
        }
        .qr-card {
            background: #ffffff;
            border-radius: 16px;
            max-width: 480px;
            width: 100%;
            padding: 28px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.45);
            border-top: 6px solid #009639;
        }
        .qr-box {
            background: #f8f9fa;
            border: 2px dashed #009639;
            border-radius: 14px;
            padding: 18px;
            display: inline-block;
        }
    </style>
</head>
<body>
    <div class="qr-card text-center">
        <img src="/images/logo.png" alt="Logo Samaritan's Purse" style="height: 55px;" class="mb-2">
        <h4 class="fw-bold text-success mb-1">Descarga tu Código QR</h4>
        <p class="small text-muted mb-3">Ingresa el número de teléfono registrado del Pastor o Líder de Proyecto para obtener tu pase de acceso al evento.</p>

        <form action="/buscar-mi-qr" method="POST" class="mb-3 text-start">
            <label class="form-label small fw-bold text-secondary">Teléfono registrado (10 dígitos):</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="fas fa-phone text-success"></i></span>
                <input type="tel" name="telefono" class="form-control" placeholder="Ej. 9211234567" required maxlength="15">
                <button type="submit" class="btn btn-success fw-bold">
                    <i class="fas fa-search me-1"></i> Buscar QR
                </button>
            </div>
        </form>

        <% if (locals.errorMensaje) { %>
            <div class="alert alert-danger py-2 px-3 small text-start">
                <i class="fas fa-exclamation-circle me-1"></i> <%= errorMensaje %>
            </div>
        <% } %>

        <% if (locals.iglesia && locals.qrImageSrc) {
            const zonaVisible = (locals.nombresZonas && nombresZonas[iglesia.zona]) ? nombresZonas[iglesia.zona] : (iglesia.zona || '');
            const nombreArchivo = 'QR_' + (iglesia.nombre_iglesia || 'Iglesia').replace(/[^a-zA-Z0-9]/g, '_') + '.png';
        %>
            <hr class="my-3">
            <div class="bg-light border rounded p-3 text-start small mb-3">
                <div class="mb-1"><strong>Iglesia:</strong> <%= iglesia.nombre_iglesia %></div>
                <div class="mb-1"><strong>Pastor:</strong> <%= iglesia.nombre_pastor %></div>
                <div class="mb-1"><strong>Zona:</strong> <%= zonaVisible %></div>
                <div><strong>Cajitas asignadas:</strong> <span class="badge bg-success"><%= iglesia.num_cajas || 0 %></span></div>
            </div>

            <div class="qr-box mb-3">
                <img src="<%= qrImageSrc %>" alt="Código QR de <%= iglesia.nombre_iglesia %>" style="width: 240px; height: 240px;">
                <div class="small text-muted mt-2 fw-bold">Presenta este código al llegar al evento</div>
            </div>

            <div class="d-grid gap-2">
                <a href="<%= qrImageSrc %>"
                   download="<%= nombreArchivo %>"
                   onclick="registrarDescargaQr('<%= iglesia.id %>')"
                   class="btn btn-success fw-bold py-2">
                    <i class="fas fa-download me-1"></i> Descargar Imagen QR
                </a>
                <button type="button"
                        onclick="registrarDescargaQr('<%= iglesia.id %>'); window.print();"
                        class="btn btn-outline-dark btn-sm fw-bold">
                    <i class="fas fa-print me-1"></i> Imprimir Pase QR
                </button>
            </div>
        <% } %>

        <div class="mt-3">
            <a href="/" class="small text-decoration-none text-secondary"><i class="fas fa-arrow-left me-1"></i> Volver al inicio</a>
        </div>
    </div>

    <script>
        function registrarDescargaQr(iglesiaId) {
            if (!iglesiaId) return;
            fetch('/api/marcar-qr-descargado/' + iglesiaId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                keepalive: true
            }).catch(() => {});
        }
    </script>
</body>
</html>
