    <div class="modal fade" id="modalSemaforo" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header py-2 bg-success text-white"><h6 class="modal-title fw-bold">Estado / Faltante</h6><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
                <form id="formSemaforo" method="POST" action="">
                    <div class="modal-body">
                        <div class="mb-2"><label class="form-label small fw-bold">Color:</label>
                            <select name="estado_semaforo" id="selectEstadoSemaforo" class="form-select form-select-sm" onchange="actualizarTextoHelp()">
                                <option value="verde">🟢 Verde</option>
                                <option value="amarillo">🟡 Amarillo</option>
                                <option value="rojo">🔴 Rojo</option>
                            </select>
                        </div>
                        <div class="mb-2"><label class="form-label small fw-bold">Motivo:</label>
                            <input type="text" name="observacion_semaforo" id="inputObservacionSemaforo" class="form-control form-control-sm" required maxlength="30">
                        </div>
                    </div>
                    <div class="modal-footer py-1"><button type="submit" class="btn btn-success btn-sm w-100 fw-bold">Guardar</button></div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let modalTrasladarBs = null;
        function abrirModalTrasladar(id, nombreIglesia, zonaActual) {
            document.getElementById('formTrasladarZona').action = '/trasladar-zona/' + id;
            document.getElementById('lblIglesiaTraslado').innerText = nombreIglesia;
            
            const selectZona = document.getElementById('selectNuevaZona');
            selectZona.value = zonaActual; // Selecciona la actual por defecto

            if (!modalTrasladarBs) modalTrasladarBs = new bootstrap.Modal(document.getElementById('modalTrasladar'));
            modalTrasladarBs.show();
        }

        function aplicarFiltrosYOrden() {
            const searchInput = document.getElementById('searchInput').value.toLowerCase().trim();
            const filterSemaforo = document.getElementById('filterSemaforo').value;
            const filterCajas = document.getElementById('filterCajas').value;
            const filterLocalidad = document.getElementById('filterLocalidad').value.toLowerCase().trim();
            const sortOption = document.getElementById('sortOption').value;

            const tbody = document.querySelector('#tablaRegistros tbody');
            const filas = Array.from(tbody.querySelectorAll('tr[data-id]'));

            filas.forEach(fila => {
                const textoCompleto = fila.innerText.toLowerCase();
                const semaforoVal = fila.getAttribute('data-semaforo');
                const cajasVal = fila.getAttribute('data-cajas');
                const direccionVal = fila.getAttribute('data-direccion');

                const cumpleSearch = !searchInput || textoCompleto.includes(searchInput);
                const cumpleSemaforo = !filterSemaforo || semaforoVal === filterSemaforo;
                const cumpleCajas = !filterCajas || cajasVal === filterCajas;
                const cumpleLocalidad = !filterLocalidad || direccionVal.includes(filterLocalidad);

                fila.style.display = (cumpleSearch && cumpleSemaforo && cumpleCajas && cumpleLocalidad) ? '' : 'none';
            });

            filas.sort((a, b) => {
                const numA = parseInt(a.getAttribute('data-num')) || 0;
                const numB = parseInt(b.getAttribute('data-num')) || 0;
                const iglesiaA = a.getAttribute('data-iglesia');
                const iglesiaB = b.getAttribute('data-iglesia');
                const pastorA = a.getAttribute('data-pastor');
                const pastorB = b.getAttribute('data-pastor');
                const cajasA = parseInt(a.getAttribute('data-cajas')) || 0;
                const cajasB = parseInt(b.getAttribute('data-cajas')) || 0;

                switch (sortOption) {
                    case 'iglesia_asc': return iglesiaA.localeCompare(iglesiaB);
                    case 'iglesia_desc': return iglesiaB.localeCompare(iglesiaA);
                    case 'pastor_asc': return pastorA.localeCompare(pastorB);
                    case 'pastor_desc': return pastorB.localeCompare(pastorA);
                    case 'cajas_desc': return cajasB - cajasA;
                    case 'cajas_asc': return cajasA - cajasB;
                    default: return numA - numB;
                }
            });

            filas.forEach(fila => tbody.appendChild(fila));
        }

        function limpiarFiltros() {
            document.getElementById('searchInput').value = '';
            document.getElementById('filterSemaforo').value = '';
            document.getElementById('filterCajas').value = '';
            document.getElementById('filterLocalidad').value = '';
            document.getElementById('sortOption').value = 'num_asc';
            aplicarFiltrosYOrden();
        }

        let modalNotifWaBs = null;
        function abrirModalNotifWhatsApp(id) {
            const row = document.querySelector(`tr[data-id="${id}"]`);
            if (!row) return;

            document.getElementById('notifRowId').value = id;
            const nombrePastor = row.getAttribute('data-nombre-pastor-raw');
            const telPastor = row.getAttribute('data-tel-pastor-raw').replace(/\D/g, '');
            const nombreLider = row.getAttribute('data-nombre-lider-raw');
            const telLider = row.getAttribute('data-tel-lider-raw').replace(/\D/g, '');

            const selectDest = document.getElementById('selectDestinatarioWa');
            selectDest.innerHTML = '';

            if (telPastor) selectDest.innerHTML += `<option value="${telPastor}|Pastor|${nombrePastor}">Pastor: ${nombrePastor} (${telPastor})</option>`;
            if (telLider) selectDest.innerHTML += `<option value="${telLider}|Líder|${nombreLider}">Líder: ${nombreLider} (${telLider})</option>`;
            if (!telPastor && !telLider) selectDest.innerHTML = `<option value="">⚠️ Sin teléfono registrado para esta iglesia</option>`;

            document.getElementById('selectTipoNotificacion').value = 'invitacion_grupo';
            document.getElementById('chkFaltaCajas').checked = false;
            document.getElementById('chkFaltaMaestros').checked = false;
            document.getElementById('chkFaltaGuerreritos').checked = false;
            document.getElementById('chkFaltaGuerreros').checked = false;
            document.getElementById('txtNotaExtraWa').value = '';

            cambiarTipoNotificacion();
            if (!modalNotifWaBs) modalNotifWaBs = new bootstrap.Modal(document.getElementById('modalNotifWhatsApp'));
            modalNotifWaBs.show();
        }

        function cambiarTipoNotificacion() {
            const tipo = document.getElementById('selectTipoNotificacion').value;
            const secFaltantes = document.getElementById('secFaltantesInfo');
            const secGrupo = document.getElementById('secInvitacionGrupo');

            if (tipo === 'faltante') {
                secFaltantes.style.display = 'block';
                secGrupo.style.display = 'none';
            } else {
                secFaltantes.style.display = 'none';
                secGrupo.style.display = 'block';
            }
            actualizarPrevisualizacionMensaje();
        }

        function actualizarPrevisualizacionMensaje() {
            const rowId = document.getElementById('notifRowId').value;
            const row = document.querySelector(`tr[data-id="${rowId}"]`);
            if (!row) return;

            const nombreIglesia = row.getAttribute('data-nombre-iglesia-raw');
            const valDest = document.getElementById('selectDestinatarioWa').value;
            if (!valDest) {
                document.getElementById('boxPreviewMensajeWa').value = 'No hay número registrado para notificar.';
                return;
            }

            const [tel, cargo, nombre] = valDest.split('|');
            const tipo = document.getElementById('selectTipoNotificacion').value;
            const notaExtra = document.getElementById('txtNotaExtraWa').value.trim();
            let msg = '';

            if (tipo === 'faltante') {
                let faltantes = [];
                if (document.getElementById('chkFaltaCajas').checked) faltantes.push('• Cantidad de cajitas solicitadas');
                if (document.getElementById('chkFaltaMaestros').checked) faltantes.push('• Datos de los maestros asignados');
                if (document.getElementById('chkFaltaGuerreritos').checked) faltantes.push('• Registro de Guerreritos de Oración');
                if (document.getElementById('chkFaltaGuerreros').checked) faltantes.push('• Registro de Guerreros Adultos');

                msg = `¡Dios le bendiga ${cargo} ${nombre}!\nLe saludamos de Operación Niño de la Navidad (Samaritan's Purse).\n\nLe escribimos para solicitar respetuosamente complementar la información de su iglesia *${nombreIglesia}*.\n\nActualmente nos falta la siguiente información:\n`;

                if (faltantes.length > 0) msg += faltantes.join('\n') + '\n';
                else msg += '• (Por favor seleccione las casillas correspondientes)\n';

                if (notaExtra) msg += `\nNota: ${notaExtra}\n`;
                msg += `\nAgradecemos mucho su valioso apoyo. ¡Bendiciones!`;

            } else {
                const grupoSel = document.getElementById('selectGrupoPlantilla').value;
                const mapaGrupos = {
                    'maestros_lerdo': { nombre: 'Maestros de Lerdo de Tejada', link: 'https://chat.whatsapp.com/J56uP7MaPa78reDb0BHxvr' },
                    'maestros_catemaco': { nombre: 'Maestros de la Zona Catemaco', link: 'https://chat.whatsapp.com/GdjuIPnI2JTINlXTQiHBAS' },
                    'cm_lerdo': { nombre: 'CM de Lerdo de Tejada', link: 'https://chat.whatsapp.com/KCgzoYFlnqz0CPiseThOdK' },
                    'cm_catemaco': { nombre: 'CM Catemaco', link: 'https://chat.whatsapp.com/Gn0mJGYtdS893bEV12XPUA' }
                };

                const infoGrupo = mapaGrupos[grupoSel] || mapaGrupos['maestros_lerdo'];
                msg = `Estimado ${cargo.toLowerCase()} *${nombre}*, bendiciones.\n\nLe compartimos el enlace de acceso exclusivo para integrarse al grupo de *${infoGrupo.nombre}*, por este medio estaremos compartiendo información importante y avisos sobre nuestras próximas actividades:\n\n${infoGrupo.link}`;

                if (notaExtra) msg += `\n\nNota: ${notaExtra}`;
            }

            document.getElementById('boxPreviewMensajeWa').value = msg;
        }

        function copiarMensajePortapapeles() {
            const textoArea = document.getElementById('boxPreviewMensajeWa');
            textoArea.select();
            navigator.clipboard.writeText(textoArea.value).then(() => {
                alert('¡Texto copiado al portapapeles! Ya puedes pegarlo en WhatsApp junto con la imagen.');
            });
        }

        function enviarMensajeWhatsAppPersonalizado() {
            const valDest = document.getElementById('selectDestinatarioWa').value;
            if (!valDest) { alert('No hay un número válido seleccionado.'); return; }
            const [tel] = valDest.split('|');
            const texto = document.getElementById('boxPreviewMensajeWa').value;
            window.open(`https://wa.me/52${tel}?text=${encodeURIComponent(texto)}`, '_blank');
            if (modalNotifWaBs) modalNotifWaBs.hide();
        }

        let modalSemaforoBs = null;
        function abrirModalSemaforo(id, estadoActual, observacionActual) {
            document.getElementById('formSemaforo').action = '/actualizar-semaforo/' + id;
            document.getElementById('selectEstadoSemaforo').value = estadoActual || 'verde';
            document.getElementById('inputObservacionSemaforo').value = observacionActual || 'Completo';
            if (!modalSemaforoBs) modalSemaforoBs = new bootstrap.Modal(document.getElementById('modalSemaforo'));
            modalSemaforoBs.show();
        }

        function actualizarTextoHelp() {
            if (document.getElementById('selectEstadoSemaforo').value === 'verde') {
                document.getElementById('inputObservacionSemaforo').value = 'Completo';
            }
        }

        let modalDictadoBs = null;
        let currentBtnDictado = null;
        function abrirModalDictado(id) {
            detenerDictadoGlobal();
            document.getElementById('dictadoActiveRowId').value = id;
            if (!modalDictadoBs) modalDictadoBs = new bootstrap.Modal(document.getElementById('modalDictado'));
            modalDictadoBs.show();
        }

        function iniciarLecturaVoz() {
            if (!('speechSynthesis' in window)) return;
            window.speechSynthesis.cancel();
            const rowId = document.getElementById('dictadoActiveRowId').value;
            const row = document.querySelector(`tr[data-id="${rowId}"]`);
            if (!row) return;

            const inicio = document.getElementById('selectDictadoInicio').value;
            const velocidad = parseFloat(document.getElementById('selectDictadoVelocidad').value) || 1;
            const partes = [
                { id: 'inicio', texto: row.getAttribute('data-dictado-iglesia') },
                { id: 'pastor', texto: row.getAttribute('data-dictado-pastor') },
                { id: 'lider', texto: row.getAttribute('data-dictado-lider') },
                { id: 'cajas', texto: row.getAttribute('data-dictado-cajas') },
                { id: 'maestros', texto: row.getAttribute('data-dictado-maestros') },
                { id: 'guerreritos', texto: row.getAttribute('data-dictado-guerreritos') },
                { id: 'guerreros', texto: row.getAttribute('data-dictado-guerreros') }
            ];

            let indexStart = inicio !== 'inicio' ? partes.findIndex(p => p.id === inicio) : 0;
            const utterance = new SpeechSynthesisUtterance(partes.slice(indexStart !== -1 ? indexStart : 0).map(p => p.texto).join(' '));
            utterance.lang = 'es-MX';
            utterance.rate = velocidad;

            currentBtnDictado = document.getElementById(`btnAudio_${rowId}`);
            if (currentBtnDictado) {
                currentBtnDictado.classList.add('reproduciendo');
                currentBtnDictado.innerHTML = `<i class="fas fa-volume-up fa-spin"></i> Leyendo...`;
            }

            utterance.onend = utterance.onerror = () => detenerDictadoGlobal();
            window.speechSynthesis.speak(utterance);
            if (modalDictadoBs) modalDictadoBs.hide();
        }

        function detenerDictadoGlobal() {
            if ('speechSynthesis' in window) window.speechSynthesis.cancel();
            if (currentBtnDictado) {
                currentBtnDictado.classList.remove('reproduciendo');
                currentBtnDictado.innerHTML = `<i class="fas fa-volume-up"></i> Dictar`;
                currentBtnDictado = null;
            }
        }
    </script>
</body>
</html>
