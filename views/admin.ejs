<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Panel de Administración - Iglesia App</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <style>
    body {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      min-height: 100vh;
      color: #f8fafc;
    }
    .card-custom {
      background: rgba(30, 41, 59, 0.7);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 12px;
    }
    .table-dark-custom {
      --bs-table-bg: transparent;
      --bs-table-color: #f1f5f9;
    }
  </style>
</head>
<body>

  <!-- Navegación -->
  <nav class="navbar navbar-dark bg-dark bg-opacity-50 border-bottom border-secondary">
    <div class="container">
      <a class="navbar-brand fw-bold text-warning" href="#">
        <i class="bi bi-shield-check me-2"></i>Panel Admin
      </a>
      <a href="/logout" class="btn btn-outline-danger btn-sm">
        <i class="bi bi-box-arrow-right me-1"></i> Salir
      </a>
    </div>
  </nav>

  <div class="container my-4">
    
    <!-- DASHBOARD (Métricas) -->
    <div class="row g-3 mb-4">
      <div class="col-md-6">
        <div class="card card-custom p-3 text-white">
          <div class="d-flex align-items-center">
            <div class="p-3 bg-primary bg-opacity-20 rounded-3 text-primary me-3">
              <i class="bi bi-building fs-2"></i>
            </div>
            <div>
              <h6 class="text-muted mb-0">Total Iglesias Registradas</h6>
              <h3 class="fw-bold mb-0"><%= totalIglesias %></h3>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card card-custom p-3 text-white">
          <div class="d-flex align-items-center">
            <div class="p-3 bg-info bg-opacity-20 rounded-3 text-info me-3">
              <i class="bi bi-people fs-2"></i>
            </div>
            <div>
              <h6 class="text-muted mb-0">Total Maestros Capacitados</h6>
              <h3 class="fw-bold mb-0"><%= totalMaestros %></h3>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TABLA DE REGISTROS -->
    <div class="card card-custom shadow-lg">
      <div class="card-header border-bottom border-secondary d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold"><i class="bi bi-table me-2"></i>Registros</h5>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-dark-custom table-hover align-middle mb-0">
            <thead>
              <tr class="text-secondary border-bottom border-secondary">
                <th class="ps-3">#</th>
                <th>Pastor</th>
                <th>Contacto Pastor</th>
                <th>Iglesia / Dirección</th>
                <th class="text-center">Maestros</th>
                <th>Líder</th>
                <th>Contacto Líder</th>
                <th class="text-end pe-3">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% if (registros && registros.length > 0) { %>
                <% registros.forEach((item, index) => { %>
                  <tr class="border-bottom border-secondary">
                    <td class="ps-3 text-muted"><%= index + 1 %></td>
                    <td class="fw-bold"><%= item.nombre_pastor %></td>
                    <td>
                      <div class="small"><i class="bi bi-telephone text-primary me-1"></i><%= item.telefono_pastor %></div>
                      <div class="small text-muted"><i class="bi bi-envelope me-1"></i><%= item.correo_pastor || 'N/A' %></div>
                    </td>
                    <td>
                      <div class="fw-semibold"><%= item.nombre_iglesia %></div>
                      <div class="small text-muted"><%= item.direccion_iglesia || 'N/A' %></div>
                    </td>
                    <td class="text-center">
                      <span class="badge bg-info text-dark rounded-pill"><%= item.num_maestros %></span>
                    </td>
                    <td><%= item.nombre_lider %></td>
                    <td>
                      <div class="small"><i class="bi bi-telephone text-primary me-1"></i><%= item.telefono_lider %></div>
                      <div class="small text-muted"><i class="bi bi-envelope me-1"></i><%= item.correo_lider || 'N/A' %></div>
                    </td>
                    <td class="text-end pe-3">
                      <!-- Botón Editar -->
                      <button class="btn btn-sm btn-outline-warning me-1" data-bs-toggle="modal" data-bs-target="#editModal<%= item.id %>">
                        <i class="bi bi-pencil"></i>
                      </button>
                      <!-- Botón Eliminar -->
                      <form action="/admin/eliminar/<%= item.id %>" method="POST" class="d-inline" onsubmit="return confirm('¿Seguro que deseas eliminar este registro?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                          <i class="bi bi-trash"></i>
                        </button>
                      </form>
                    </td>
                  </tr>

                  <!-- MODAL EDITAR -->
                  <div class="modal fade text-dark" id="editModal<%= item.id %>" tabindex="-1">
                    <div class="modal-dialog modal-lg">
                      <div class="modal-content">
                        <div class="modal-header bg-dark text-white">
                          <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Editar Registro</h5>
                          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <form action="/admin/editar/<%= item.id %>" method="POST">
                          <div class="modal-body row g-3">
                            <div class="col-md-6">
                              <label class="form-label fw-bold">Nombre Pastor</label>
                              <input type="text" name="nombre_pastor" class="form-control" value="<%= item.nombre_pastor %>" required>
                            </div>
                            <div class="col-md-3">
                              <label class="form-label fw-bold">Teléfono Pastor</label>
                              <input type="text" name="telefono_pastor" class="form-control" value="<%= item.telefono_pastor %>" required>
                            </div>
                            <div class="col-md-3">
                              <label class="form-label fw-bold">Correo Pastor</label>
                              <input type="email" name="correo_pastor" class="form-control" value="<%= item.correo_pastor %>">
                            </div>
                            <div class="col-md-6">
                              <label class="form-label fw-bold">Nombre Iglesia</label>
                              <input type="text" name="nombre_iglesia" class="form-control" value="<%= item.nombre_iglesia %>" required>
                            </div>
                            <div class="col-md-4">
                              <label class="form-label fw-bold">Dirección</label>
                              <input type="text" name="direccion_iglesia" class="form-control" value="<%= item.direccion_iglesia %>">
                            </div>
                            <div class="col-md-2">
                              <label class="form-label fw-bold">Maestros</label>
                              <input type="number" name="num_maestros" class="form-control" value="<%= item.num_maestros %>" required>
                            </div>
                            <div class="col-md-6">
                              <label class="form-label fw-bold">Líder Capacitado</label>
                              <input type="text" name="nombre_lider" class="form-control" value="<%= item.nombre_lider %>" required>
                            </div>
                            <div class="col-md-3">
                              <label class="form-label fw-bold">Teléfono Líder</label>
                              <input type="text" name="telefono_lider" class="form-control" value="<%= item.telefono_lider %>" required>
                            </div>
                            <div class="col-md-3">
                              <label class="form-label fw-bold">Correo Líder</label>
                              <input type="email" name="correo_lider" class="form-control" value="<%= item.correo_lider %>">
                            </div>
                          </div>
                          <div class="modal-footer bg-light">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>

                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="8" class="text-center py-5 text-muted">
                    No hay registros disponibles.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
