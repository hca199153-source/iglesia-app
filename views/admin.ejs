<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Panel de Administración - Samaritan's Purse</title>
  
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  
  <!-- Librerías para Exportación -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>

  <style>
    body {
      background-color: #f4f6f9;
      color: #333333;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    .navbar-custom {
      background-color: #155724;
    }
    .card-header-custom {
      background-color: #1e7e34;
      color: white;
    }
    .table-responsive {
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    }
    .badge-cajas {
      font-size: 0.9rem;
      padding: 6px 12px;
    }
    .oracion-box {
      background-color: #fff9e6;
      border-left: 3px solid #ffc107;
      font-size: 0.82rem;
    }
  </style>
</head>
<body>

  <!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow-sm mb-4">
    <div class="container-fluid px-4">
      <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" href="#">
        <img src="/images/logo.png" alt="Logo" width="35" height="35" class="bg-white rounded p-1">
        <span>Panel Admin | Samaritan's Purse</span>
      </a>
      <div class="d-flex gap-2">
        <a href="/" class="btn btn-outline-light btn-sm"><i class="bi bi-house-door-fill me-1"></i> Ir al Registro</a>
      </div>
    </div>
  </nav>

  <div class="container-fluid px-4 mb-5">

    <!-- CABECERA Y BOTONES DE EXPORTACIÓN -->
    <div class="row align-items-center mb-4">
      <div class="col-12 col-md-6 mb-2 mb-md-0">
        <h3 class="fw-bold text-success mb-0"><i class="bi bi-journal-text me-2"></i>Registros de Iglesias</h3>
        <p class="text-muted small mb-0">Gestión de datos de pastores, líderes, cajas y equipos de apoyo/oración.</p>
      </div>
      <div class="col-12 col-md-6 text-md-end d-flex gap-2 justify-content-md-end">
        <button onclick="exportarExcel()" class="btn btn-outline-success fw-bold shadow-sm">
          <i class="bi bi-file-earmark-excel-fill me-1"></i> Exportar Excel
        </button>
        <button onclick="exportarPDF()" class="btn btn-outline-danger fw-bold shadow-sm">
          <i class="bi bi-file-earmark-pdf-fill me-1"></i> Exportar PDF
        </button>
      </div>
    </div>

    <!-- TABLA DE REGISTROS -->
    <div class="card border-0 shadow-sm">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0" id="tablaRegistros">
            <thead class="table-dark text-center">
              <tr>
                <th style="width: 40px;">#</th>
                <th>Iglesia y Dirección</th>
                <th>Pastor</th>
                <th>Líder</th>
                <th style="width: 90px;">Cajas</th>
                <th>Maestros Requeridos</th>
                <th>Equipo de Oración</th>
              </tr>
            </thead>
            <tbody>
              <% if (typeof registros !== 'undefined' && registros.length > 0) { %>
                <% registros.forEach((r, index) => { %>
                  <tr>
                    <td class="text-center fw-bold text-muted"><%= index + 1 %></td>
                    
                    <!-- Iglesia y Dirección -->
                    <td>
                      <div class="fw-bold text-dark"><%= r.nombre_iglesia %></div>
                      <small class="text-muted d-block"><i class="bi bi-geo-alt-fill me-1"></i><%= r.direccion || 'Sin dirección' %></small>
                    </td>

                    <!-- Pastor -->
                    <td>
                      <div class="fw-bold"><%= r.nombre_pastor %></div>
                      <small class="text-muted d-block"><i class="bi bi-telephone-fill me-1"></i><%= r.telefono_pastor %></small>
                      <% if(r.correo_pastor) { %>
                        <small class="text-muted d-block"><i class="bi bi-envelope-fill me-1"></i><%= r.correo_pastor %></small>
                      <% } %>
                    </td>

                    <!-- Líder -->
                    <td>
                      <div class="fw-bold"><%= r.nombre_lider %></div>
                      <small class="text-muted d-block"><i class="bi bi-telephone-fill me-1"></i><%= r.telefono_lider %></small>
                      <% if(r.correo_lider) { %>
                        <small class="text-muted d-block"><i class="bi bi-envelope-fill me-1"></i><%= r.correo_lider %></small>
                      <% } %>
                    </td>

                    <!-- Cajas -->
                    <td class="text-center">
                      <span class="badge bg-success badge-cajas rounded-pill shadow-sm"><%= r.num_cajas %></span>
                    </td>

                    <!-- Maestros -->
                    <td>
                      <% if(r.maestros && r.maestros.length > 0) { %>
                        <ul class="list-unstyled mb-0 small">
                          <% r.maestros.forEach(m => { %>
                            <li class="mb-1">
                              <i class="bi bi-person-fill text-success me-1"></i><strong><%= m.nombre %></strong> 
                              <span class="text-muted">(<%= m.telefono %>)</span>
                            </li>
                          <% }) %>
                        </ul>
                      <% } else { %>
                        <span class="text-muted small">Sin maestros registrados</span>
                      <% } %>
                    </td>

                    <!-- Equipo de Oración -->
                    <td>
                      <div class="oracion-box p-2 rounded">
                        <!-- Guerreros -->
                        <% if(r.guerreros_oracion && r.guerreros_oracion.length > 0) { %>
                          <div class="fw-bold text-dark border-bottom pb-1 mb-1">
                            <i class="bi bi-people-fill me-1 text-warning"></i>Guerreros (<%= r.guerreros_oracion.length %>)
                          </div>
                        <% } %>
                        
                        <!-- Guerreritos -->
                        <% if(r.guerreritos_oracion && r.guerreritos_oracion.length > 0) { %>
                          <div class="fw-bold text-dark border-bottom pb-1 mb-1">
                            <i class="bi bi-emoji-smile-fill me-1 text-warning"></i>Guerreritos (<%= r.guerreritos_oracion.length %>)
                          </div>
                        <% } %>

                        <!-- Tutores -->
                        <% if(r.tutores && r.tutores.length > 0) { %>
                          <div class="fw-bold text-dark">
                            <i class="bi bi-shield-check me-1 text-warning"></i>Tutores (<%= r.tutores.length %>)
                          </div>
                        <% } %>

                        <% if((!r.guerreros_oracion || r.guerreros_oracion.length === 0) && (!r.guerreritos_oracion || r.guerreritos_oracion.length === 0)) { %>
                          <span class="text-muted">Sin datos de oración</span>
                        <% } %>
                      </div>
                    </td>

                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center py-4 text-muted">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>No hay registros guardados actualmente.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <!-- FUNCIONES DE EXPORTACIÓN -->
  <script>
    function exportarExcel() {
      const filas = document.querySelectorAll('#tablaRegistros tbody tr');
      const datosExcel = [];

      filas.forEach((tr, index) => {
        const cols = tr.querySelectorAll('td');
        if (cols.length > 1) {
          datosExcel.push({
            "No.": index + 1,
            "Iglesia / Dirección": cols[1].innerText.replace(/\n/g, ' - ').trim(),
            "Pastor": cols[2].innerText.replace(/\n/g, ' ').trim(),
            "Líder": cols[3].innerText.replace(/\n/g, ' ').trim(),
            "Cajas": cols[4].innerText.trim(),
            "Maestros": cols[5].innerText.replace(/\n/g, ' | ').trim(),
            "Equipo Oración": cols[6].innerText.replace(/\n/g, ' | ').trim()
          });
        }
      });

      const ws = XLSX.utils.json_to_sheet(datosExcel);
      
      ws['!cols'] = [
        { wch: 6 },  // No.
        { wch: 35 }, // Iglesia
        { wch: 25 }, // Pastor
        { wch: 25 }, // Líder
        { wch: 10 }, // Cajas
        { wch: 35 }, // Maestros
        { wch: 35 }  // Equipo Oración
      ];

      const wb = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(wb, ws, "Registros");
      XLSX.writeFile(wb, 'Registros_Iglesias.xlsx');
    }

    function exportarPDF() {
      const { jsPDF } = window.jspdf;
      const doc = new jsPDF('l', 'mm', 'a4');

      doc.setFontSize(14);
      doc.setTextColor(21, 87, 36);
      doc.text("Reporte Completo de Registros - Samaritan's Purse", 14, 15);

      const filasData = [];
      document.querySelectorAll('#tablaRegistros tbody tr').forEach((tr, index) => {
        const cols = tr.querySelectorAll('td');
        if (cols.length > 1) {
          filasData.push([
            index + 1,
            cols[1].innerText.trim(),
            cols[2].innerText.trim(),
            cols[3].innerText.trim(),
            cols[4].innerText.trim(),
            cols[5].innerText.trim(),
            cols[6].innerText.trim()
          ]);
        }
      });

      doc.autoTable({
        head: [['#', 'Iglesia / Dirección', 'Pastor', 'Líder', 'Cajas', 'Maestros', 'Equipo Oración']],
        body: filasData,
        startY: 22,
        theme: 'grid',
        headStyles: { 
          fillColor: [21, 87, 36], 
          halign: 'center', 
          valign: 'middle',
          fontSize: 8 
        },
        styles: { 
          fontSize: 7.5, 
          cellPadding: 2.5, 
          valign: 'middle',
          overflow: 'linebreak'
        },
        columnStyles: {
          0: { halign: 'center', cellWidth: 8 },
          1: { halign: 'left', cellWidth: 50 },
          2: { halign: 'left', cellWidth: 42 },
          3: { halign: 'left', cellWidth: 42 },
          4: { halign: 'center', cellWidth: 15 },
          5: { halign: 'left', cellWidth: 55 },
          6: { halign: 'left' }
        }
      });

      doc.save('Registros_Iglesias.pdf');
    }
  </script>
</body>
</html>
