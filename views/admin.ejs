<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Panel de Administración - Samaritan's Purse</title>
  
  <!-- FAVICON / LOGO EN LA PESTAÑA -->
  <link rel="icon" type="image/png" href="/images/logo.png">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <style>
    body {
      background: linear-gradient(135deg, #1b381e 0%, #0a170c 100%);
      min-height: 100vh;
      color: #ffffff;
      padding: 30px 0;
    }
    .card-custom {
      background-color: #1e7e34;
      border: 2px solid #28a745;
      border-radius: 16px;
      color: #ffffff;
    }
    .app-logo {
      max-height: 80px;
      object-fit: contain;
    }
    .table-container {
      background-color: #ffffff;
      border-radius: 12px;
      overflow: hidden;
      color: #000000;
    }
    .table thead {
      background-color: #155724;
      color: #ffffff;
    }
    .btn-action {
      transition: all 0.2s ease;
    }
    .btn-action:hover {
      transform: scale(1.05);
    }
    .maestro-item {
      font-size: 0.85rem;
      border-bottom: 1px dashed #dee2e6;
      padding-bottom: 4px;
      margin-bottom: 4px;
    }
    .maestro-item:last-child {
      border-bottom: none;
      margin-bottom: 0;
      padding-bottom: 0;
    }
  </style>
</head>
<body>

  <div class="container-fluid px-md-5">
    
    <div class="card card-custom shadow-lg p-4 p-md-5 mb-4">
      
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 pb-3 border-bottom border-light-subtle">
        <div class="d-flex align-items-center mb-3 mb-md-0">
          <img src="/images/logo.png" alt="Logo Samaritan's Purse" class="app-logo bg-white p-2 rounded shadow-sm me-3">
          <div>
            <h2 class="fw-bold mb-0 text-white">Panel de Administración</h2>
            <p class="text-white-50 mb-0 small">Listado de Iglesias, Líderes y Maestros Registrados</p>
          </div>
        </div>
        
        <!-- BOTONES DE ACCIÓN -->
        <div class="d-flex flex-wrap gap-2">
          <button onclick="exportarExcel()" class="btn btn-success fw-bold shadow-sm btn-action">
            <i class="bi bi-file-earmark-excel-fill me-1"></i> Excel
          </button>
          <button onclick="exportarPDF()" class="btn btn-danger fw-bold shadow-sm btn-action">
            <i class="bi bi-file-earmark-pdf-fill me-1"></i> PDF
          </button>
          <a href="/" class="btn btn-light fw-bold text-success shadow-sm btn-action">
            <i class="bi bi-plus-circle-fill me-1"></i> Nuevo Registro
          </a>
        </div>
      </div>

      <div class="table-container shadow-sm p-3">
        <div class="table-responsive">
          <table id="tablaRegistros" class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th scope="col">#</th>
                <th scope="col">Iglesia / Dirección</th>
                <th scope="col">Pastor</th>
                <th scope="col">Líder</th>
                <th scope="col" class="text-center">Cajas</th>
                <th scope="col">Maestros Asignados</th>
                <th scope="col" class="text-center">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% if (registros && registros.length > 0) { %>
                <% registros.forEach((item, index) => { %>
                  <tr>
                    <td class="fw-bold"><%= index + 1 %></td>
                    <td>
                      <strong class="text-success"><%= item.nombre_iglesia %></strong>
                      <% if (item.direccion) { %>
                        <br><small class="text-muted"><i class="bi bi-geo-alt me-1"></i><%= item.direccion %></small>
                      <% } %>
                    </td>
                    <td>
                      <div><strong><%= item.nombre_pastor %></strong></div>
                      <% if (item.telefono_pastor) { %>
                        <small><a href="tel:<%= item.telefono_pastor %>" class="text-decoration-none text-dark"><i class="bi bi-telephone me-1"></i><%= item.telefono_pastor %></a></small>
                      <% } %>
                    </td>
                    <td>
                      <div><strong><%= item.nombre_lider %></strong></div>
                      <% if (item.telefono_lider) { %>
                        <small><a href="tel:<%= item.telefono_lider %>" class="text-decoration-none text-dark"><i class="bi bi-telephone me-1"></i><%= item.telefono_lider %></a></small>
                      <% } %>
                    </td>
                    <td class="text-center">
                      <span class="badge bg-success fs-6"><%= item.num_cajas || 50 %></span>
                    </td>
                    <td>
                      <% if (item.maestros && item.maestros.length > 0) { %>
                        <div class="d-flex flex-column">
                          <% item.maestros.forEach(function(m) { %>
                            <div class="maestro-item">
                              <i class="bi bi-person-fill text-success me-1"></i><strong><%= m.nombre %></strong><br>
                              <small class="text-muted"><i class="bi bi-telephone me-1"></i><%= m.telefono %></small>
                              <% if (m.correo) { %>
                                <small class="text-muted me-1">|</small><small class="text-muted"><i class="bi bi-envelope me-1"></i><%= m.correo %></small>
                              <% } %>
                            </div>
                          <% }); %>
                        </div>
                      <% } else { %>
                        <span class="text-muted small">Sin maestros registrados</span>
                      <% } %>
                    </td>
                    <td class="text-center">
                      <form action="/eliminar/<%= item.id %>" method="POST" onsubmit="return confirm('¿Seguro que deseas eliminar este registro?');" style="display:inline;">
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle btn-action" title="Eliminar">
                          <i class="bi bi-trash-fill"></i>
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center py-4 text-muted fw-bold">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                    No hay registros de iglesias almacenados hasta el momento.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>

  </div>

  <!-- LIBRERÍAS PARA EXCEL Y PDF -->
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>

  <script>
    // Exportar a Excel sin la columna de "Acciones"
    function exportarExcel() {
      const tabla = document.getElementById('tablaRegistros');
      const wb = XLSX.utils.table_to_book(tabla, { sheet: "Registros" });
      
      // Eliminar la última columna (Acciones) de la hoja
      const ws = wb.Sheets["Registros"];
      const range = XLSX.utils.decode_range(ws['!ref']);
      for (let R = range.s.r; R <= range.e.r; ++R) {
        delete ws[XLSX.utils.encode_cell({ r: R, c: 6 })];
      }
      range.e.c = 5;
      ws['!ref'] = XLSX.utils.encode_range(range);

      XLSX.writeFile(wb, 'Registros_Iglesias.xlsx');
    }

    // Exportar a PDF en formato horizontal (landscape)
    function exportarPDF() {
      const { jsPDF } = window.jspdf;
      const doc = new jsPDF('l', 'mm', 'a4');

      doc.setFontSize(16);
      doc.text("Reporte de Registros - Samaritan's Purse", 14, 15);

      doc.autoTable({
        html: '#tablaRegistros',
        startY: 22,
        theme: 'grid',
        headStyles: { fillColor: [21, 87, 36] },
        columns: [
          { header: '#', dataKey: 0 },
          { header: 'Iglesia / Dirección', dataKey: 1 },
          { header: 'Pastor', dataKey: 2 },
          { header: 'Líder', dataKey: 3 },
          { header: 'Cajas', dataKey: 4 },
          { header: 'Maestros', dataKey: 5 }
        ]
      });

      doc.save('Registros_Iglesias.pdf');
    }
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
