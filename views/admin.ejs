// Obtener registros con tablas relacionadas integradas
async function cargarDatosAdmin() {
  const { data: registros, error } = await supabase
    .from('registros')
    .select(`
      *,
      guerreros_oracion (nombre, telefono),
      guerreritos_oracion (nombre),
      tutores (nombre, telefono)
    `)
    .order('created_at', { ascending: false });

  if (error) {
    console.error('Error al cargar datos:', error);
    return;
  }

  renderTablaEscritorio(registros);
  renderTarjetasMovil(registros);
}

// Vista Escritorio (Tabla)
function renderTablaEscritorio(registros) {
  const tbody = document.getElementById('tabla-registros-body');
  tbody.innerHTML = registros.map(reg => `
    <tr>
      <td>${escapeHTML(reg.nombre_iglesia)}</td>
      <td>${escapeHTML(reg.nombre_pastor)} (${escapeHTML(reg.telefono_pastor)})</td>
      <td>
        <details class="cursor-pointer">
          <summary class="font-bold text-blue-600">Ver 7 Guerreros</summary>
          <ul class="text-xs list-disc pl-4 mt-1">
            ${reg.guerreros_oracion?.map(g => `<li>${escapeHTML(g.nombre)} - ${escapeHTML(g.telefono)}</li>`).join('') || ''}
          </ul>
        </details>
      </td>
      <td>
        <details class="cursor-pointer">
          <summary class="font-bold text-blue-600">Ver 7 Guerreritos</summary>
          <ul class="text-xs list-disc pl-4 mt-1">
            ${reg.guerreritos_oracion?.map(g => `<li>${escapeHTML(g.nombre)}</li>`).join('') || ''}
          </ul>
        </details>
      </td>
      <td>
        <details class="cursor-pointer">
          <summary class="font-bold text-blue-600">Ver 7 Tutores</summary>
          <ul class="text-xs list-disc pl-4 mt-1">
            ${reg.tutores?.map(t => `<li>${escapeHTML(t.nombre)} - ${escapeHTML(t.telefono)}</li>`).join('') || ''}
          </ul>
        </details>
      </td>
    </tr>
  `).join('');
}

// Vista Móvil (Tarjetas con prevención de desbordamiento de texto)
function renderTarjetasMovil(registros) {
  const contenedor = document.getElementById('tarjetas-movil-container');
  contenedor.innerHTML = registros.map(reg => `
    <div class="bg-white rounded-lg shadow p-4 mb-4 border border-gray-200 w-full overflow-hidden">
      <h3 class="font-bold text-lg text-gray-800 break-words">${escapeHTML(reg.nombre_iglesia)}</h3>
      <p class="text-sm text-gray-600 break-words">Pastor: ${escapeHTML(reg.nombre_pastor)}</p>
      
      <!-- Contenedor Resaltado Amarillo con protección anti-overflow -->
      <div class="bg-yellow-100 border-l-4 border-yellow-500 p-3 my-3 rounded text-sm min-w-0 max-w-full overflow-hidden">
        <p class="font-bold text-yellow-800 mb-1">Guerreros de Oración:</p>
        <div class="space-y-1 overflow-x-auto">
          ${reg.guerreros_oracion?.map(g => `
            <p class="text-xs text-yellow-900 break-words whitespace-pre-wrap">
              • <span class="font-semibold">${escapeHTML(g.nombre)}</span> (${escapeHTML(g.telefono)})
            </p>
          `).join('') || ''}
        </div>

        <p class="font-bold text-yellow-800 mt-3 mb-1">Guerreritos:</p>
        <div class="space-y-1 overflow-x-auto">
          ${reg.guerreritos_oracion?.map(g => `
            <p class="text-xs text-yellow-900 break-words whitespace-pre-wrap">
              • <span class="font-semibold">${escapeHTML(g.nombre)}</span>
            </p>
          `).join('') || ''}
        </div>

        <p class="font-bold text-yellow-800 mt-3 mb-1">Tutores / Papás:</p>
        <div class="space-y-1 overflow-x-auto">
          ${reg.tutores?.map(t => `
            <p class="text-xs text-yellow-900 break-words whitespace-pre-wrap">
              • <span class="font-semibold">${escapeHTML(t.nombre)}</span> (${escapeHTML(t.telefono)})
            </p>
          `).join('') || ''}
        </div>
      </div>
    </div>
  `).join('');
}
