<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Panel de Administración - Samaritan's Purse</title>
<!-- FAVICON / LOGO EN LA PESTAÑA -->
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <style>
    body {
      background: linear-gradient(135deg, #1b381e 0%, #0a170c 100%);
      min-height: 100vh;
      color: #ffffff;
      padding: 30px 0;
    }
    .card-custom {
      background-color: #1e7e34;
      border: 2px solid #28a745;
      border-radius: 16px;
      color: #ffffff;
    }
    .app-logo {
      max-height: 80px;
      object-fit: contain;
    }
    .table-container {
      background-color: #ffffff;
      border-radius: 12px;
      overflow: hidden;
      color: #000000;
    }
    .table thead {
      background-color: #155724;
      color: #ffffff;
    }
    .btn-action {
      transition: all 0.2s ease;
    }
    .btn-action:hover {
      transform: scale(1.05);
    }
  </style>
</head>
<body>

  <div class="container-fluid px-md-5">
    
    <div class="card card-custom shadow-lg p-4 p-md-5 mb-4">
      
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 pb-3 border-bottom border-light-subtle">
        <div class="d-flex align-items-center mb-3 mb-md-0">
          <img src="/images/logo.png" alt="Logo Samaritan's Purse" class="app-logo bg-white p-2 rounded shadow-sm me-3">
          <div>
            <h2 class="fw-bold mb-0 text-white">Panel de Administración</h2>
            <p class="text-white-50 mb-0 small">Listado de Iglesias y Líderes Registrados</p>
          </div>
        </div>
        <div>
          <a href="/" class="btn btn-light fw-bold text-success shadow-sm btn-action">
            <i class="bi bi-plus-circle-fill me-2"></i>Nuevo Registro
          </a>
        </div>
      </div>

      <div class="table-container shadow-sm p-3">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th scope="col">#</th>
                <th scope="col">Iglesia</th>
                <th scope="col">Pastor</th>
                <th scope="col">Tel. Pastor</th>
                <th scope="col">Líder</th>
                <th scope="col">Tel. Líder</th>
                <th scope="col" class="text-center">Maestros</th>
                <th scope="col" class="text-center">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% if (registros && registros.length > 0) { %>
                <% registros.forEach((item, index) => { %>
                  <tr>
                    <td class="fw-bold"><%= index + 1 %></td>
                    <td class="fw-bold text-success"><%= item.nombre_iglesia %></td>
                    <td><%= item.nombre_pastor %></td>
                    <td><a href="tel:<%= item.telefono_pastor %>" class="text-decoration-none text-dark"><i class="bi bi-telephone me-1"></i><%= item.telefono_pastor %></a></td>
                    <td><%= item.nombre_lider %></td>
                    <td><a href="tel:<%= item.telefono_lider %>" class="text-decoration-none text-dark"><i class="bi bi-telephone me-1"></i><%= item.telefono_lider %></a></td>
                    <td class="text-center"><span class="badge bg-success fs-6"><%= item.num_maestros %></span></td>
                    <td class="text-center">
                      <form action="/eliminar/<%= item.id %>" method="POST" onsubmit="return confirm('¿Seguro que deseas eliminar este registro?');" style="display:inline;">
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle btn-action" title="Eliminar">
                          <i class="bi bi-trash-fill"></i>
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="8" class="text-center py-4 text-muted fw-bold">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                    No hay registros de iglesias almacenados hasta el momento.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
