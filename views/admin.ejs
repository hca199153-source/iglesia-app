<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Panel de Administración - Registros</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body class="bg-light">

  <!-- Navegación -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid container">
      <a class="navbar-brand fw-bold" href="#">
        <i class="bi bi-shield-lock-fill text-warning me-2"></i>Panel de Administración
      </a>
      <div class="d-flex">
        <a href="/logout" class="btn btn-outline-light btn-sm">
          <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión
        </a>
      </div>
    </div>
  </nav>

  <!-- Contenido Principal -->
  <div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="fw-bold mb-0">Registros de Iglesias</h2>
        <p class="text-muted small">Listado de respuestas recibidas a través del formulario</p>
      </div>
      <span class="badge bg-primary fs-6">
        Total: <%= registros ? registros.length : 0 %> registros
      </span>
    </div>

    <!-- Tabla de Registros -->
    <div class="card shadow-sm border-0 rounded-3">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
              <tr>
                <th scope="col" class="ps-3">#</th>
                <th scope="col">Pastor</th>
                <th scope="col">Contacto Pastor</th>
                <th scope="col">Iglesia / Dirección</th>
                <th scope="col">Maestros</th>
                <th scope="col">Líder Capacitado</th>
                <th scope="col">Contacto Líder</th>
                <th scope="col">Fecha</th>
              </tr>
            </thead>
            <tbody>
              <% if (registros && registros.length > 0) { %>
                <% registros.forEach((item, index) => { %>
                  <tr>
                    <td class="ps-3 fw-bold text-muted"><%= index + 1 %></td>
                    <td>
                      <div class="fw-bold"><%= item.nombre_pastor %></div>
                    </td>
                    <td>
                      <div class="small"><i class="bi bi-telephone text-primary me-1"></i><%= item.telefono_pastor %></div>
                      <div class="small text-muted"><i class="bi bi-envelope text-secondary me-1"></i><%= item.correo_pastor || 'N/A' %></div>
                    </td>
                    <td>
                      <div class="fw-semibold"><%= item.nombre_iglesia %></div>
                      <div class="small text-muted"><%= item.direccion_iglesia || 'Sin dirección' %></div>
                    </td>
                    <td class="text-center">
                      <span class="badge bg-info text-dark rounded-pill px-3"><%= item.num_maestros %></span>
                    </td>
                    <td>
                      <div class="fw-semibold"><%= item.nombre_lider %></div>
                    </td>
                    <td>
                      <div class="small"><i class="bi bi-telephone text-primary me-1"></i><%= item.telefono_lider %></div>
                      <div class="small text-muted"><i class="bi bi-envelope text-secondary me-1"></i><%= item.correo_lider || 'N/A' %></div>
                    </td>
                    <td class="small text-muted">
                      <%= item.creado_en ? new Date(item.creado_en).toLocaleDateString('es-MX') : 'N/A' %>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="8" class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                    Aún no hay registros guardados en la base de datos.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Bootstrap 5 JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
