    <div class="modal fade" id="modalDictado" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header py-2 bg-primary text-white"><h6 class="modal-title fw-bold">Dictado por Voz</h6><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" onclick="detenerDictadoGlobal()"></button></div>
                <div class="modal-body">
                    <input type="hidden" id="dictadoActiveRowId">
                    <div class="mb-2"><label class="form-label small fw-bold">Empezar desde:</label>
                        <select id="selectDictadoInicio" class="form-select form-select-sm">
                            <option value="inicio">1. Desde el Inicio</option>
                            <option value="pastor">2. Pastor</option>
                            <option value="lider">3. Líder</option>
                            <option value="cajas">4. Cajas</option>
                            <option value="maestros">5. Maestros</option>
                            <option value="guerreritos">6. Guerreritos</option>
                            <option value="guerreros">7. Guerreros</option>
                        </select>
