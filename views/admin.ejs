<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Administración | Samaritan's Purse</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #0b221a;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #2b2b2b;
            margin: 0;
            padding: 0;
        }
        #authModal {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(11, 34, 26, 0.95);
            z-index: 9999;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .auth-card {
            background: #ffffff;
            padding: 30px;
            border-radius: 16px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
            border-top: 6px solid #009639;
        }
        .admin-container {
            max-width: 1200px;
            margin: 20px auto;
            background: #009639;
            border-radius: 16px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
            padding: 20px;
        }
        .admin-header {
            background: #ffffff;
            border-radius: 12px;
            padding: 15px 20px;
            margin-bottom: 20px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }
        .admin-header img { height: 45px; width: auto; }
        .stat-card-green { background-color: #007a2e; color: white; border-radius: 12px; padding: 20px; display: flex; justify-content: space-between; align-items: center; }
        .stat-card-blue { background-color: #0056b3; color: white; border-radius: 12px; padding: 20px; display: flex; justify-content: space-between; align-items: center; }
        .stat-card-yellow { background-color: #ffc107; color: #533f03; border-radius: 12px; padding: 20px; display: flex; justify-content: space-between; align-items: center; }
        .table-section { background: #ffffff; border-radius: 12px; padding: 20px; box-shadow: 0 5px 20px rgba(0,0,0,0.15); }
        .table-custom th { background-color: #009639 !important; color: white !important; font-size: 0.85rem; text-transform: uppercase; }
        .table-custom td { font-size: 0.85rem; vertical-align: middle; }
    </style>
</head>
<body>

    <!-- MODAL DE ACCESO POR ZONA -->
    <div id="authModal">
        <div class="auth-card">
            <div class="text-center mb-4">
                <img src="/images/logo.png" alt="Logo" style="height: 55px;" class="mb-2">
                <h5 class="fw-bold text-success">Acceso a Panel por Zona</h5>
                <p class="small text-muted">Seleccione su zona e ingrese la contraseña asignada.</p>
            </div>
            <form id="loginForm" onsubmit="verificarAcceso(event)">
                <div class="mb-3">
                    <label class="form-label small fw-bold">Área de Procedencia:</label>
                    <select id="zonaSelect" class="form-select form-select-sm" required>
                        <option value="">-- Seleccionar Zona --</option>
                        <option value="san_andres">San Andrés Tuxtla</option>
                        <option value="veracruz">Veracruz</option>
                        <option value="cd_aleman">Ciudad Alemán</option>
                        <option value="xalapa">Xalapa</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold">Contraseña de Zona:</label>
                    <input type="password" id="zonaPassword" class="form-control form-control-sm" placeholder="••••••••" required>
                </div>
                <button type="submit" class="btn btn-success w-100 fw-bold py-2">Ingresar al Panel</button>
            </form>
        </div>
    </div>

    <!-- CONTENEDOR PRINCIPAL -->
    <div class="admin-container" id="adminContent" style="display: none;">
        <div class="admin-header">
            <div class="d-flex align-items-center">
                <img src="/images/logo.png" alt="Logo" class="me-3">
                <div>
                    <h4 class="fw-bold text-success mb-0">Panel de Administración</h4>
                    <p class="small text-muted mb-0">Zona Activa: <span id="labelZonaActual" class="fw-bold text-uppercase text-danger"></span></p>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a href="/exportar-excel" class="btn btn-success btn-sm"><i class="fas fa-file-excel me-1"></i> Excel</a>
                <button onclick="window.print()" class="btn btn-danger btn-sm"><i class="fas fa-print me-1"></i> Imprimir</button>
                <a href="/" class="btn btn-outline-secondary btn-sm"><i class="fas fa-sign-out-alt"></i> Salir</a>
            </div>
        </div>

        <!-- TARJETAS SUPERIORES -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="stat-card-green">
                    <div>
                        <span class="small text-uppercase fw-bold opacity-75">Iglesias Registradas</span>
                        <h2 class="fw-bold mb-0"><%= totalIglesias %></h2>
                    </div>
                    <i class="fas fa-church fa-2x opacity-50"></i>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card-blue">
                    <div>
                        <span class="small text-uppercase fw-bold opacity-75">Total Cajitas</span>
                        <h2 class="fw-bold mb-0"><%= totalCajitas %></h2>
                    </div>
                    <i class="fas fa-box-open fa-2x opacity-50"></i>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card-yellow">
                    <div>
                        <span class="small text-uppercase fw-bold opacity-75">Total Maestros</span>
                        <h2 class="fw-bold mb-0"><%= totalMaestros %></h2>
                    </div>
                    <i class="fas fa-users fa-2x opacity-50"></i>
                </div>
            </div>
        </div>

        <!-- TABLA -->
        <div class="table-section">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-success mb-0"><i class="fas fa-list me-2"></i> Registros de la Zona</h6>
                <div class="input-group input-group-sm w-50">
                    <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" id="searchInput" class="form-control" placeholder="Buscar por iglesia, pastor o líder..." onkeyup="filtrarTabla()">
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover table-custom align-middle" id="tablaRegistros">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Iglesia / Dirección</th>
                            <th>Pastor</th>
                            <th>Líder</th>
                            <th>Cajitas</th>
                            <th>Maestros Asignados</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (registros && registros.length > 0) { %>
                            <% registros.forEach((item, index) => { %>
                                <tr data-zona="<%= item.zona %>">
                                    <td class="fw-bold"><%= index + 1 %></td>
                                    <td>
                                        <strong><%= item.nombre_iglesia %></strong><br>
                                        <small class="text-muted"><i class="fas fa-map-marker-alt text-danger me-1"></i> <%= item.direccion %></small>
                                    </td>
                                    <td>
                                        <strong><%= item.nombre_pastor %></strong><br>
                                        <small class="text-muted"><i class="fas fa-phone me-1"></i> <%= item.telefono_pastor %></small>
                                    </td>
                                    <td>
                                        <strong><%= item.nombre_lider %></strong><br>
                                        <small class="text-muted"><i class="fas fa-phone me-1"></i> <%= item.telefono_lider %></small>
                                    </td>
                                    <td><span class="badge bg-success"><%= item.num_cajas %> Cajas</span></td>
                                    <td>
                                        <% if (item.maestros && item.maestros.length > 0) { %>
                                            <% item.maestros.forEach(m => { %>
                                                <div class="small text-secondary"><strong><%= m.nombre %></strong> (<%= m.telefono %>)</div>
                                            <% }) %>
                                        <% } else { %>
                                            <span class="small text-muted">Sin maestros</span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <form action="/eliminar-registro/<%= item.id %>" method="POST" onsubmit="return confirm('¿Estás seguro de eliminar este registro?');" style="display:inline;">
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Eliminar"><i class="fas fa-trash-alt"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="7" class="text-center text-muted py-4">No hay registros guardados en esta zona.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        const contrasenasZonas = { "san_andres": "sanandres2026", "veracruz": "veracruz2026", "cd_aleman": "cdaleman2026", "xalapa": "xalapa2026" };

        function verificarAcceso(event) {
            event.preventDefault();
            const zona = document.getElementById('zonaSelect').value;
            const pass = document.getElementById('zonaPassword').value;

            if (contrasenasZonas[zona] && contrasenasZonas[zona] === pass) {
                document.getElementById('authModal').style.display = 'none';
                document.getElementById('adminContent').style.display = 'block';
                document.getElementById('labelZonaActual').innerText = document.getElementById('zonaSelect').options[document.getElementById('zonaSelect').selectedIndex].text;
            } else {
                alert("Contraseña incorrecta para la zona seleccionada.");
            }
        }

        function filtrarTabla() {
            const input = document.getElementById('searchInput').value.toLowerCase();
            document.querySelectorAll('#tablaRegistros tbody tr').forEach(fila => {
                fila.style.display = fila.innerText.toLowerCase().includes(input) ? '' : 'none';
            });
        }
    </script>
</body>
</html>
