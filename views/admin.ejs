<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Registros Capturados</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light p-4">
  <div class="container-fluid">
    <h2 class="mb-4">Registros de Iglesiast</h2>
    
    <div class="table-responsive bg-white p-3 rounded shadow-sm">
      <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
          <tr>
            <th>ID</th>
            <th>Iglesia</th>
            <th>Dirección</th>
            <th>Maestros</th>
            <th>Pastor</th>
            <th>Tel. Pastor</th>
            <th>Líder</th>
            <th>Tel. Líder</th>
            <th>Fecha</th>
          </tr>
        </thead>
        <tbody>
          <% registros.forEach(r => { %>
            <tr>
              <td><%= r.id %></td>
              <td><strong><%= r.nombre_iglesia %></strong></td>
              <td><%= r.direccion_iglesia %></td>
              <td><span class="badge bg-info text-dark"><%= r.num_maestros %></span></td>
              <td><%= r.nombre_pastor %></td>
              <td><%= r.telefono_pastor %></td>
              <td><%= r.nombre_lider %></td>
              <td><%= r.telefono_lider %></td>
              <td><%= new Date(r.creado_en).toLocaleDateString() %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>