                    <button type="button" class="btn btn-outline-success btn-sm fw-bold" onclick="copiarMensajePortapapeles()"><i class="fas fa-copy me-1"></i> Copiar</button>
                    <button type="button" class="btn btn-success btn-sm fw-bold" onclick="enviarMensajeWhatsAppPersonalizado()"><i class="fab fa-whatsapp me-1"></i> Enviar</button>
