<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Administración | Samaritan's Purse</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #0b221a; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #2b2b2b; margin: 0; padding: 0; }
        #authModal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(11, 34, 26, 0.95); z-index: 9999; display: flex; justify-content: center; align-items: center; }
        .auth-card { background: #ffffff; padding: 30px; border-radius: 16px; width: 100%; max-width: 420px; box-shadow: 0 15px 35px rgba(0,0,0,0.5); border-top: 6px solid #009639; }
        .admin-container { max-width: 1650px; margin: 20px auto; background: #009639; border-radius: 16px; box-shadow: 0 15px 35px rgba(0,0,0,0.5); padding: 20px; }
        .admin-header { background: #ffffff; border-radius: 12px; padding: 15px 20px; margin-bottom: 20px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; }
        .admin-header img { height: 45px; width: auto; }
        
        .stat-card-green { background-color: #007a2e; color: white; border-radius: 12px; padding: 18px; box-shadow: 0 4px 10px rgba(0,0,0,0.15); display: flex; justify-content: space-between; align-items: center; }
        .stat-card-blue { background-color: #0056b3; color: white; border-radius: 12px; padding: 18px; box-shadow: 0 4px 10px rgba(0,0,0,0.15); display: flex; justify-content: space-between; align-items: center; }
        .stat-card-yellow { background-color: #ffc107; color: #533f03; border-radius: 12px; padding: 18px; box-shadow: 0 4px 10px rgba(0,0,0,0.15); display: flex; justify-content: space-between; align-items: center; }
        .stat-card-teal { background-color: #0d9488; color: white; border-radius: 12px; padding: 18px; box-shadow: 0 4px 10px rgba(0,0,0,0.15); display: flex; justify-content: space-between; align-items: center; }
        .stat-card-purple { background-color: #7c3aed; color: white; border-radius: 12px; padding: 18px; box-shadow: 0 4px 10px rgba(0,0,0,0.15); display: flex; justify-content: space-between; align-items: center; }
        .stat-card-red { background-color: #dc2626; color: white; border-radius: 12px; padding: 18px; box-shadow: 0 4px 10px rgba(0,0,0,0.15); display: flex; justify-content: space-between; align-items: center; }
        
        .table-section { background: #ffffff; border-radius: 12px; padding: 20px; box-shadow: 0 5px 20px rgba(0,0,0,0.15); }
        .table-custom th { background-color: #009639 !important; color: white !important; font-size: 0.76rem; text-transform: uppercase; }
        .table-custom td { font-size: 0.75rem; vertical-align: top; }
        
        .filter-box { background-color: #f8f9fa; border: 1px solid #e9ecef; border-radius: 10px; padding: 12px 15px; margin-bottom: 15px; }
        
        .btn-excel { background-color: #198754; color: white; font-weight: bold; }
        .btn-excel:hover { background-color: #146c43; color: white; }
        .btn-print { background-color: #d32f2f; color: white; font-weight: bold; }
        .btn-print:hover { background-color: #b71c1c; color: white; }

        .badge-semaforo {
            cursor: pointer;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 0.72rem;
            font-weight: bold;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
            transition: transform 0.2s;
        }
        .badge-semaforo:hover { transform: scale(1.08); }
        .semaforo-verde { background-color: #198754; color: white; }
        .semaforo-amarillo { background-color: #ffc107; color: #000; }
        .semaforo-rojo { background-color: #dc3545; color: white; }

        .btn-audio-dictado {
            background-color: #0d6efd;
            color: white;
            border: none;
            border-radius: 20px;
            padding: 4px 10px;
            font-size: 0.72rem;
            font-weight: bold;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.15);
            transition: all 0.2s ease-in-out;
        }
        .btn-audio-dictado:hover { background-color: #0b5ed7; color: white; transform: scale(1.05); }
        .btn-audio-dictado.reproduciendo { background-color: #dc3545; animation: pulse-audio 1.2s infinite; }
        @keyframes pulse-audio { 0% { transform: scale(1); } 50% { transform: scale(1.08); } 100% { transform: scale(1); } }

        .btn-notif-wa {
            background-color: #25D366;
            color: white;
            border: none;
            border-radius: 20px;
            padding: 4px 10px;
            font-size: 0.72rem;
            font-weight: bold;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.15);
            transition: all 0.2s ease-in-out;
        }
        .btn-notif-wa:hover { background-color: #1eb857; color: white; transform: scale(1.05); }

        .btn-trasladar {
            background-color: #6f42c1;
            color: white;
            border: none;
            border-radius: 20px;
            padding: 4px 10px;
            font-size: 0.72rem;
            font-weight: bold;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.15);
            transition: all 0.2s ease-in-out;
        }
        .btn-trasladar:hover { background-color: #59359a; color: white; transform: scale(1.05); }

        @page { size: A4 landscape; margin: 8mm; }
        @media print {
            body { background: white !important; color: #000 !important; font-size: 10px !important; margin: 0 !important; padding: 0 !important; }
            .admin-container { background: white !important; box-shadow: none !important; margin: 0 !important; padding: 0 !important; width: 100% !important; max-width: 100% !important; }
            .no-print { display: none !important; }
            .table-section { box-shadow: none !important; padding: 0 !important; background: transparent !important; }
            .table-custom { width: 100% !important; border-collapse: collapse !important; }
            .table-custom th { background-color: #009639 !important; color: white !important; font-size: 0.68rem !important; padding: 5px !important; }
            .table-custom td { font-size: 0.65rem !important; padding: 5px !important; border: 1px solid #dee2e6 !important; }
            tr { page-break-inside: avoid !important; break-inside: avoid !important; }
        }
    </style>
</head>
<body>

    <% if (!locals.zona) { %>
        <div id="authModal">
            <div class="auth-card">
                <div class="text-center mb-4">
                    <img src="/images/logo.png" alt="Logo" style="height: 55px;" class="mb-2">
                    <h5 class="fw-bold text-success">Acceso a Panel por Zona</h5>
                    <p class="small text-muted">Seleccione su zona e ingrese la contraseña asignada.</p>
                </div>
                <form action="/login" method="POST">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Área de Procedencia / Módulo:</label>
                        <select name="zona" class="form-select form-select-sm" required>
                            <option value="">-- Seleccionar --</option>
                            <option value="san_andres">San Andrés Tuxtla</option>
                            <option value="medellin">Medellín</option>
                            <option value="manlio">Manlio Fabio</option>
                            <option value="orizaba">Orizaba</option>
                            <option value="cd_aleman">Ciudad Alemán</option>
                            <option value="xalapa">Xalapa</option>
                            <option value="carlos_a_carrillo">Carlos A. Carrillo</option>
                            <option value="tezonapa">Tezonapa</option>
                            <option value="dev_console" style="background-color: #0b221a; color: #00ff66; font-weight: bold;">🛠️ Dev Console (Programador)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Contraseña:</label>
                        <input type="password" name="password" class="form-control form-control-sm" placeholder="••••••••" required>
                    </div>
                    <button type="submit" class="btn btn-success w-100 fw-bold py-2">Ingresar al Sistema</button>
                </form>
            </div>
        </div>
    <% } %>

    <% if (locals.zona) { %>
    <div class="admin-container" id="adminContent">
        <div class="admin-header">
            <div class="d-flex align-items-center">
                <img src="/images/logo.png" alt="Logo" class="me-3">
                <div>
                    <h4 class="fw-bold text-success mb-0">Panel de Administración</h4>
                    <p class="small text-muted mb-0">Zona Activa: <span id="labelZonaActual" class="fw-bold text-uppercase text-danger"><%= zona %></span></p>
                </div>
            </div>
            <div class="d-flex gap-2 no-print flex-wrap">
                <a href="/admin-comunidad" class="btn btn-success btn-sm fw-bold shadow-sm" style="background-color: #25D366; border-color: #25D366; color: white;">
                    <i class="fab fa-whatsapp me-1 fa-lg"></i> Admin Grupos WhatsApp
                </a>
                
                <a href="/dev-admin" class="btn btn-dark btn-sm fw-bold border-success text-success"><i class="fas fa-terminal me-1"></i> Dev Console</a>
                <button onclick="detenerDictadoGlobal()" class="btn btn-warning btn-sm fw-bold"><i class="fas fa-volume-mute me-1"></i> Detener Audio</button>
                <a href="/exportar-excel" class="btn btn-excel btn-sm"><i class="fas fa-file-excel me-1"></i> Excel</a>
                <button onclick="window.print()" class="btn btn-print btn-sm"><i class="fas fa-print me-1"></i> Imprimir / PDF</button>
                <a href="/logout" class="btn btn-outline-secondary btn-sm"><i class="fas fa-sign-out-alt"></i> Salir</a>
            </div>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-md-4 col-sm-6"><div class="stat-card-green"><div><span class="small text-uppercase fw-bold opacity-75">Iglesias</span><h2 class="fw-bold mb-0"><%= totalIglesias %></h2></div><i class="fas fa-church fa-2x opacity-50 no-print"></i></div></div>
            <div class="col-md-4 col-sm-6"><div class="stat-card-blue"><div><span class="small text-uppercase fw-bold opacity-75">Cajitas</span><h2 class="fw-bold mb-0"><%= totalCajitas %></h2></div><i class="fas fa-box-open fa-2x opacity-50 no-print"></i></div></div>
            <div class="col-md-4 col-sm-6"><div class="stat-card-yellow"><div><span class="small text-uppercase fw-bold opacity-75">Maestros</span><h2 class="fw-bold mb-0"><%= totalMaestros %></h2></div><i class="fas fa-users fa-2x opacity-50 no-print"></i></div></div>
            <div class="col-md-4 col-sm-6"><div class="stat-card-teal"><div><span class="small text-uppercase fw-bold opacity-75">Pastores</span><h2 class="fw-bold mb-0"><%= totalPastores %></h2></div><i class="fas fa-user-tie fa-2x opacity-50 no-print"></i></div></div>
            <div class="col-md-4 col-sm-6"><div class="stat-card-purple"><div><span class="small text-uppercase fw-bold opacity-75">Guerreritos</span><h2 class="fw-bold mb-0"><%= totalGuerreritos %></h2></div><i class="fas fa-child fa-2x opacity-50 no-print"></i></div></div>
            <div class="col-md-4 col-sm-6"><div class="stat-card-red"><div><span class="small text-uppercase fw-bold opacity-75">Guerreros (Adultos)</span><h2 class="fw-bold mb-0"><%= totalGuerreros %></h2></div><i class="fas fa-user-shield fa-2x opacity-50 no-print"></i></div></div>
        </div>

        <div class="table-section">
            <div class="d-flex justify-content-between align-items-center mb-2 no-print">
                <h6 class="fw-bold text-success mb-0"><i class="fas fa-list me-2"></i> Registros de la Zona</h6>
                <div class="input-group input-group-sm w-50">
                    <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" id="searchInput" class="form-control" placeholder="Buscar por iglesia, pastor, líder o correo..." onkeyup="aplicarFiltrosYOrden()">
                </div>
            </div>

            <div class="filter-box no-print">
                <div class="row g-2 align-items-center">
                    <div class="col-md-3 col-6">
                        <label class="form-label small fw-bold mb-1 text-secondary">Estado Semáforo:</label>
                        <select id="filterSemaforo" class="form-select form-select-sm" onchange="aplicarFiltrosYOrden()">
                            <option value="">-- Todos --</option>
                            <option value="verde">🟢 Verde (Completo)</option>
                            <option value="amarillo">🟡 Amarillo (Faltante Menor)</option>
                            <option value="rojo">🔴 Rojo (Faltante Crítico)</option>
                        </select>
                    </div>
                    <div class="col-md-2 col-6">
                        <label class="form-label small fw-bold mb-1 text-secondary">Cantidad Cajas:</label>
                        <select id="filterCajas" class="form-select form-select-sm" onchange="aplicarFiltrosYOrden()">
                            <option value="">-- Todas --</option>
                            <option value="50">50 Cajas</option>
                            <option value="100">100 Cajas</option>
                            <option value="150">150 Cajas</option>
                        </select>
                    </div>
                    <div class="col-md-3 col-6">
                        <label class="form-label small fw-bold mb-1 text-secondary">Dirección / Localidad:</label>
                        <input type="text" id="filterLocalidad" class="form-control form-control-sm" placeholder="Filtrar dirección..." onkeyup="aplicarFiltrosYOrden()">
                    </div>
                    <div class="col-md-3 col-6">
                        <label class="form-label small fw-bold mb-1 text-secondary">Ordenar Por:</label>
                        <select id="sortOption" class="form-select form-select-sm" onchange="aplicarFiltrosYOrden()">
                            <option value="num_asc"># Orden original</option>
                            <option value="iglesia_asc">Iglesia (A - Z)</option>
                            <option value="iglesia_desc">Iglesia (Z - A)</option>
                            <option value="pastor_asc">Pastor (A - Z)</option>
                            <option value="pastor_desc">Pastor (Z - A)</option>
                            <option value="cajas_desc">Cajas (Mayor a Menor)</option>
                            <option value="cajas_asc">Cajas (Menor a Mayor)</option>
                        </select>
                    </div>
                    <div class="col-md-1 col-12 text-end">
                        <button class="btn btn-outline-secondary btn-sm w-100" onclick="limpiarFiltros()"><i class="fas fa-undo"></i></button>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover table-custom align-middle" id="tablaRegistros">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Iglesia / Dirección</th>
                            <th>Pastor</th>
                            <th>Líder de Proyecto</th>
                            <th>Cajas</th>
                            <th>Maestros Asignados</th>
                            <th>Guerreritos (Niño / Papá / Tel)</th>
                            <th>Guerreros (Adultos)</th>
                            <th class="no-print text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (registros && registros.length > 0) { %>
                            <% registros.forEach((item, index) => { 
                                let colorClase = 'semaforo-verde';
                                let textoEstado = 'Completo';
                                if (item.estado_semaforo === 'amarillo') {
                                    colorClase = 'semaforo-amarillo';
                                    textoEstado = item.observacion_semaforo || 'Pendiente';
                                } else if (item.estado_semaforo === 'rojo') {
                                    colorClase = 'semaforo-rojo';
                                    textoEstado = item.observacion_semaforo || 'Faltante';
                                } else {
                                    textoEstado = item.observacion_semaforo || 'Completo';
                                }

                                let textoIglesia = `Iglesia ${item.nombre_iglesia}. Dirección: ${item.direccion}.`;
                                let textoPastor = `Pastor ${item.nombre_pastor}. Teléfono: ${item.telefono_pastor || 'No registrado'}. Correo: ${item.correo_pastor || 'No registrado'}.`;
                                let textoLider = `Líder de proyecto ${item.nombre_lider}. Teléfono: ${item.telefono_lider || 'No registrado'}. Correo: ${item.correo_lider || 'No registrado'}.`;
                                let textoCajas = `Cajitas solicitadas: ${item.num_cajas}.`;
                                
                                let textoMaestros = "Maestros asignados: ";
                                if (item.maestros && item.maestros.length > 0) {
                                    textoMaestros += item.maestros.map((m, i) => `Maestro ${i+1}: ${m.nombre}, teléfono ${m.telefono}, correo ${m.correo || 'sin correo'}`).join('. ');
                                } else { textoMaestros += "Sin maestros registrados."; }

                                let textoGuerreritos = "Guerreritos de oración: ";
                                if (item.guerreritos_oracion && item.guerreritos_oracion.length > 0) {
                                    textoGuerreritos += item.guerreritos_oracion.map((g, i) => `Guerrerito ${i+1}: ${g.nombre_guerrerito}, tutor o papá ${g.nombre_tutor}, teléfono ${g.telefono_tutor}`).join('. ');
                                } else { textoGuerreritos += "Sin guerreritos registrados."; }

                                let textoGuerreros = "Guerreros adultos: ";
                                if (item.guerreros_oracion && item.guerreros_oracion.length > 0) {
                                    textoGuerreros += item.guerreros_oracion.map((gu, i) => `Guerrero ${i+1}: ${gu.nombre_guerrero}, teléfono ${gu.telefono_guerrero}`).join('. ');
                                } else { textoGuerreros += "Sin guerreros registrados."; }
                            %>
                                <tr data-id="<%= item.id %>"
                                    data-num="<%= index + 1 %>"
                                    data-iglesia="<%= (item.nombre_iglesia || '').toLowerCase() %>"
                                    data-pastor="<%= (item.nombre_pastor || '').toLowerCase() %>"
                                    data-direccion="<%= (item.direccion || '').toLowerCase() %>"
                                    data-cajas="<%= item.num_cajas || 0 %>"
                                    data-semaforo="<%= item.estado_semaforo || 'verde' %>"
                                    data-nombre-iglesia-raw="<%= item.nombre_iglesia %>"
                                    data-nombre-pastor-raw="<%= item.nombre_pastor %>"
                                    data-tel-pastor-raw="<%= item.telefono_pastor || '' %>"
                                    data-nombre-lider-raw="<%= item.nombre_lider %>"
                                    data-tel-lider-raw="<%= item.telefono_lider || '' %>"
                                    data-dictado-iglesia="<%= textoIglesia %>"
                                    data-dictado-pastor="<%= textoPastor %>"
                                    data-dictado-lider="<%= textoLider %>"
                                    data-dictado-cajas="<%= textoCajas %>"
                                    data-dictado-maestros="<%= textoMaestros %>"
                                    data-dictado-guerreritos="<%= textoGuerreritos %>"
                                    data-dictado-guerreros="<%= textoGuerreros %>">
                                    
                                    <td class="fw-bold"><%= index + 1 %></td>
                                    <td>
                                        <strong><%= item.nombre_iglesia %></strong><br>
                                        <small class="text-muted"><i class="fas fa-map-marker-alt text-danger me-1"></i> <%= item.direccion %></small>
                                    </td>
                                    <td>
                                        <strong><%= item.nombre_pastor %></strong><br>
                                        <small class="text-muted"><i class="fas fa-phone me-1"></i> <%= item.telefono_pastor || 'Sin tel.' %></small><br>
                                        <% if (item.correo_pastor) { %>
                                            <small class="text-primary"><i class="fas fa-envelope me-1"></i> <%= item.correo_pastor %></small>
                                        <% } else { %>
                                            <small class="text-muted fst-italic">Sin correo</small>
                                        <% } %>
                                    </td>
                                    <td>
                                        <strong><%= item.nombre_lider %></strong><br>
                                        <small class="text-muted"><i class="fas fa-phone me-1"></i> <%= item.telefono_lider || 'Sin tel.' %></small><br>
                                        <% if (item.correo_lider) { %>
                                            <small class="text-primary"><i class="fas fa-envelope me-1"></i> <%= item.correo_lider %></small>
                                        <% } else { %>
                                            <small class="text-muted fst-italic">Sin correo</small>
                                        <% } %>
                                    </td>
                                    <td><span class="badge bg-success"><%= item.num_cajas %></span></td>
                                    <td>
                                        <% if (item.maestros && item.maestros.length > 0) { %>
                                            <% item.maestros.forEach((m, mIdx) => { %>
                                                <div class="small text-secondary mb-1">
                                                    <strong>M<%= mIdx + 1 %>:</strong> <%= m.nombre %><br>
                                                    <span class="text-muted" style="font-size: 0.7rem;"><i class="fas fa-phone me-1"></i> <%= m.telefono %></span>
                                                    <% if (m.correo) { %>
                                                        <br><span class="text-primary" style="font-size: 0.7rem;"><i class="fas fa-envelope me-1"></i> <%= m.correo %></span>
                                                    <% } %>
                                                </div>
                                            <% }) %>
                                        <% } else { %>
                                            <span class="small text-muted">Sin maestros</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (item.guerreritos_oracion && item.guerreritos_oracion.length > 0) { %>
                                            <% item.guerreritos_oracion.forEach((g, gIdx) => { %>
                                                <div class="small text-secondary mb-1" style="line-height: 1.2;">
                                                    <strong>G<%= gIdx + 1 %>:</strong> <%= g.nombre_guerrerito %><br>
                                                    <span class="text-muted" style="font-size: 0.7rem;"><strong>Papá/Tutor:</strong> <%= g.nombre_tutor || 'No especificado' %></span><br>
                                                    <span class="text-muted" style="font-size: 0.7rem;"><i class="fas fa-phone me-1"></i> <%= g.telefono_tutor %></span>
                                                </div>
                                            <% }) %>
                                        <% } else { %>
                                            <span class="small text-muted">Sin guerreritos</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (item.guerreros_oracion && item.guerreros_oracion.length > 0) { %>
                                            <% item.guerreros_oracion.forEach((gu, guIdx) => { %>
                                                <div class="small text-secondary mb-1">
                                                    <strong>A<%= guIdx + 1 %>:</strong> <%= gu.nombre_guerrero %><br>
                                                    <span class="text-muted" style="font-size: 0.7rem;"><i class="fas fa-phone me-1"></i> <%= gu.telefono_guerrero %></span>
                                                </div>
                                            <% }) %>
                                        <% } else { %>
                                            <span class="small text-muted">Sin guerreros</span>
                                        <% } %>
                                    </td>
                                    <td class="no-print text-center">
                                        <div class="d-flex flex-column gap-1 align-items-center">
                                            <div class="d-flex gap-1">
                                                <a href="/editar-registro/<%= item.id %>" class="btn btn-outline-primary btn-sm"><i class="fas fa-edit"></i></a>
                                                <form action="/eliminar-registro/<%= item.id %>" method="POST" onsubmit="return confirm('¿Eliminar registro?');" style="display:inline;">
                                                    <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fas fa-trash-alt"></i></button>
                                                </form>
                                            </div>
                                            
                                            <button type="button" class="btn-notif-wa" onclick="abrirModalNotifWhatsApp('<%= item.id %>')">
                                                <i class="fab fa-whatsapp"></i> Notificar
                                            </button>

                                            <!-- 🚀 NUEVO BOTÓN PARA TRASLADAR REGISTRO A OTRA ZONA -->
                                            <button type="button" class="btn-trasladar" onclick="abrirModalTrasladar('<%= item.id %>', '<%= item.nombre_iglesia %>', '<%= zona %>')">
                                                <i class="fas fa-exchange-alt"></i> Trasladar
                                            </button>

                                            <span class="badge-semaforo <%= colorClase %>" onclick="abrirModalSemaforo('<%= item.id %>', '<%= item.estado_semaforo || 'verde' %>', '<%= item.observacion_semaforo || '' %>')">
                                                <i class="fas fa-circle"></i> <%= textoEstado %>
                                            </span>
                                            
                                            <button type="button" class="btn-audio-dictado" id="btnAudio_<%= item.id %>" onclick="abrirModalDictado('<%= item.id %>')">
                                                <i class="fas fa-volume-up"></i> Dictar
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="9" class="text-center text-muted py-4">No hay registros guardados.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <% } %>

