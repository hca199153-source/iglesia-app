<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Administración | Zona: <%= zona.toUpperCase() %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container" style="max-width: 1000px;">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #e2e8f0; padding-bottom: 15px; margin-bottom: 20px;">
            <div>
                <h2 style="margin: 0; color: #065f46;">📊 Panel de Control</h2>
                <p style="margin: 5px 0 0 0; color: #64748b; font-weight: bold;">Zona Administrada: <span style="color: #d97706;"><%= zona.toUpperCase() %></span></p>
            </div>
            <div>
                <a href="/logout" style="background: #ef4444; color: white; padding: 10px 15px; border-radius: 6px; text-decoration: none; font-weight: bold; font-size: 14px;">Cerrar Sesión</a>
            </div>
        </div>

        <h3 style="color: #1e293b;">Iglesias Registradas en esta Zona</h3>

        <% if (iglesias && iglesias.length > 0) { %>
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 14px;">
                    <thead>
                        <tr style="background: #065f46; color: white; text-align: left;">
                            <th style="padding: 10px;">Iglesia</th>
                            <th style="padding: 10px;">Pastor</th>
                            <th style="padding: 10px;">Líder</th>
                            <th style="padding: 10px;">Cajas</th>
                            <th style="padding: 10px;">Maestros</th>
                            <th style="padding: 10px;">Dirección</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% iglesias.forEach(iglesia => { %>
                            <tr style="border-bottom: 1px solid #cbd5e1;">
                                <td style="padding: 10px; font-weight: bold;"><%= iglesia.nombre_iglesia %></td>
                                <td style="padding: 10px;"><%= iglesia.nombre_pastor %><br><small><%= iglesia.telefono_pastor %></small></td>
                                <td style="padding: 10px;"><%= iglesia.nombre_lider %><br><small><%= iglesia.telefono_lider %></small></td>
                                <td style="padding: 10px; text-align: center; font-weight: bold; color: #059669;"><%= iglesia.num_cajas %></td>
                                <td style="padding: 10px; text-align: center;"><%= iglesia.num_maestros %></td>
                                <td style="padding: 10px;"><%= iglesia.direccion %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div style="background: #f1f5f9; padding: 20px; border-radius: 6px; text-align: center; color: #64748b;">
                <p style="margin: 0; font-weight: bold;">No hay iglesias registradas en esta zona todavía.</p>
            </div>
        <% } %>
    </div>
</body>
</html>
