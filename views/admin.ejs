<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Administración | Samaritan's Purse</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #0b221a;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #2b2b2b;
            margin: 0;
            padding: 0;
        }

        #authModal {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(11, 34, 26, 0.95);
            z-index: 9999;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .auth-card {
            background: #ffffff;
            padding: 30px;
            border-radius: 16px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
            border-top: 6px solid #009639;
        }

        .admin-container {
            max-width: 1600px;
            margin: 20px auto;
            background: #009639;
            border-radius: 16px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
            padding: 20px;
        }

        .admin-header {
            background: #ffffff;
            border-radius: 12px;
            padding: 15px 20px;
            margin-bottom: 20px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }
        .admin-header img {
            height: 45px;
            width: auto;
        }

        .stat-card-green {
            background-color: #007a2e;
            color: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .stat-card-blue {
            background-color: #0056b3;
            color: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .stat-card-yellow {
            background-color: #ffc107;
            color: #533f03;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .table-section {
            background: #ffffff;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.15);
        }
        .table-custom th {
            background-color: #009639 !important;
            color: white !important;
            font-size: 0.78rem;
            text-transform: uppercase;
        }
        .table-custom td {
            font-size: 0.78rem;
            vertical-align: top;
        }

        .btn-excel { background-color: #198754; color: white; font-weight: bold; }
        .btn-excel:hover { background-color: #146c43; color: white; }
        .btn-print { background-color: #d32f2f; color: white; font-weight: bold; }
        .btn-print:hover { background-color: #b71c1c; color: white; }

        /* =========================================================
           CONFIGURACIÓN ESPECIAL PARA EXPORTACIÓN Y VISTA IMPRESA / PDF
           ========================================================= */
        @page {
            size: A4 landscape;
            margin: 8mm;
        }

        @media print {
            body {
                background: white !important;
                color: #000 !important;
                font-size: 10px !important;
                margin: 0 !important;
                padding: 0 !important;
            }

            .admin-container {
                background: white !important;
                box-shadow: none !important;
                margin: 0 !important;
                padding: 0 !important;
                width: 100% !important;
                max-width: 100% !important;
            }

            .no-print {
                display: none !important;
            }

            /* Formato compacto para métricas principales al imprimir */
            .stat-card-green, .stat-card-blue, .stat-card-yellow {
                border: 1px solid #ccc !important;
                box-shadow: none !important;
                padding: 8px 12px !important;
                color: #000 !important;
                background: #f8f9fa !important;
                border-radius: 6px !important;
            }

            .stat-card-green h2, .stat-card-blue h2, .stat-card-yellow h2 {
                font-size: 1.2rem !important;
                color: #000 !important;
            }

            .stat-card-green span, .stat-card-blue span, .stat-card-yellow span {
                color: #444 !important;
                font-size: 0.65rem !important;
            }

            .table-section {
                box-shadow: none !important;
                padding: 0 !important;
                background: transparent !important;
            }

            .table-custom {
                width: 100% !important;
                border-collapse: collapse !important;
            }

            .table-custom th {
                background-color: #009639 !important;
                color: white !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                font-size: 0.68rem !important;
                padding: 5px !important;
            }

            .table-custom td {
                font-size: 0.65rem !important;
                padding: 5px !important;
                border: 1px solid #dee2e6 !important;
                word-wrap: break-word;
            }

            /* Evita que una fila de la tabla se rompa a la mitad entre 2 hojas */
            tr {
                page-break-inside: avoid !important;
                break-inside: avoid !important;
            }

            /* Anchos proporcionales para ajustar perfectamente en A4 Horizontal */
            .col-num { width: 3%; }
            .col-iglesia { width: 17%; }
            .col-pastor { width: 13%; }
            .col-lider { width: 13%; }
            .col-cajas { width: 6%; }
            .col-maestros { width: 16%; }
            .col-guerreritos { width: 16%; }
            .col-guerreros { width: 16%; }

            /* Color visible para iconos y enlaces en impresión */
            .text-primary, a {
                color: #000 !important;
                text-decoration: none !important;
            }

            .badge {
                border: 1px solid #000 !important;
                color: #000 !important;
                background: transparent !important;
            }
        }
    </style>
</head>
<body>

    <% if (!locals.zona) { %>
        <div id="authModal">
            <div class="auth-card">
                <div class="text-center mb-4">
                    <img src="/images/logo.png" alt="Logo" style="height: 55px;" class="mb-2">
                    <h5 class="fw-bold text-success">Acceso a Panel por Zona</h5>
                    <p class="small text-muted">Seleccione su zona e ingrese la contraseña asignada.</p>
                </div>
                <form action="/login" method="POST">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Área de Procedencia:</label>
                        <select name="zona" class="form-select form-select-sm" required>
                            <option value="">-- Seleccionar Zona --</option>
                            <option value="san_andres">San Andrés Tuxtla</option>
                            <option value="veracruz">Veracruz</option>
                            <option value="cd_aleman">Ciudad Alemán</option>
                            <option value="xalapa">Xalapa</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Contraseña de Zona:</label>
                        <input type="password" name="password" class="form-control form-control-sm" placeholder="••••••••" required>
                    </div>
                    <button type="submit" class="btn btn-success w-100 fw-bold py-2">Ingresar al Panel</button>
                </form>
            </div>
        </div>
    <% } %>

    <% if (locals.zona) { %>
    <div class="admin-container" id="adminContent">
        
        <!-- Encabezado de la página -->
        <div class="admin-header">
            <div class="d-flex align-items-center">
                <img src="/images/logo.png" alt="Logo" class="me-3">
                <div>
                    <h4 class="fw-bold text-success mb-0">Panel de Administración</h4>
                    <p class="small text-muted mb-0">Zona Activa: <span id="labelZonaActual" class="fw-bold text-uppercase text-danger"><%= zona %></span></p>
                </div>
            </div>
            <div class="d-flex gap-2 no-print">
                <a href="/exportar-excel" class="btn btn-excel btn-sm"><i class="fas fa-file-excel me-1"></i> Excel</a>
                <button onclick="window.print()" class="btn btn-print btn-sm"><i class="fas fa-print me-1"></i> Imprimir / PDF</button>
                <a href="/logout" class="btn btn-outline-secondary btn-sm"><i class="fas fa-sign-out-alt"></i> Salir</a>
            </div>
        </div>

        <!-- Tarjetas de Métricas Resumidas -->
        <div class="row g-2 mb-3">
            <div class="col-4">
                <div class="stat-card-green">
                    <div>
                        <span class="small text-uppercase fw-bold opacity-75">Iglesias</span>
                        <h2 class="fw-bold mb-0"><%= totalIglesias %></h2>
                    </div>
                    <i class="fas fa-church fa-2x opacity-50 no-print"></i>
                </div>
            </div>
            <div class="col-4">
                <div class="stat-card-blue">
                    <div>
                        <span class="small text-uppercase fw-bold opacity-75">Cajitas</span>
                        <h2 class="fw-bold mb-0"><%= totalCajitas %></h2>
                    </div>
                    <i class="fas fa-box-open fa-2x opacity-50 no-print"></i>
                </div>
            </div>
            <div class="col-4">
                <div class="stat-card-yellow">
                    <div>
                        <span class="small text-uppercase fw-bold opacity-75">Maestros</span>
                        <h2 class="fw-bold mb-0"><%= totalMaestros %></h2>
                    </div>
                    <i class="fas fa-users fa-2x opacity-50 no-print"></i>
                </div>
            </div>
        </div>

        <div class="table-section">
            <div class="d-flex justify-content-between align-items-center mb-3 no-print">
                <h6 class="fw-bold text-success mb-0"><i class="fas fa-list me-2"></i> Registros de la Zona</h6>
                <div class="input-group input-group-sm w-50">
                    <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" id="searchInput" class="form-control" placeholder="Buscar por iglesia, pastor, líder o correo..." onkeyup="filtrarTabla()">
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover table-custom align-middle" id="tablaRegistros">
                    <thead>
                        <tr>
                            <th class="col-num">#</th>
                            <th class="col-iglesia">Iglesia / Dirección</th>
                            <th class="col-pastor">Pastor</th>
                            <th class="col-lider">Líder de Proyecto</th>
                            <th class="col-cajas">Cajas</th>
                            <th class="col-maestros">Maestros Asignados</th>
                            <th class="col-guerreritos">Guerreritos de Oración</th>
                            <th class="col-guerreros">Guerreros (Adultos)</th>
                            <th class="no-print">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (registros && registros.length > 0) { %>
                            <% registros.forEach((item, index) => { %>
                                <tr>
                                    <td class="fw-bold"><%= index + 1 %></td>
                                    <td>
                                        <strong><%= item.nombre_iglesia %></strong><br>
                                        <small class="text-muted"><i class="fas fa-map-marker-alt text-danger me-1 no-print"></i> <%= item.direccion %></small>
                                    </td>
                                    <td>
                                        <strong><%= item.nombre_pastor %></strong><br>
                                        <small class="text-muted"><i class="fas fa-phone me-1 no-print"></i> <%= item.telefono_pastor %></small><br>
                                        <% if (item.correo_pastor) { %>
                                            <small class="text-primary"><i class="fas fa-envelope me-1 no-print"></i> <%= item.correo_pastor %></small>
                                        <% } else { %>
                                            <small class="text-muted italic">Sin correo</small>
                                        <% } %>
                                    </td>
                                    <td>
                                        <strong><%= item.nombre_lider %></strong><br>
                                        <small class="text-muted"><i class="fas fa-phone me-1 no-print"></i> <%= item.telefono_lider %></small><br>
                                        <% if (item.correo_lider) { %>
                                            <small class="text-primary"><i class="fas fa-envelope me-1 no-print"></i> <%= item.correo_lider %></small>
                                        <% } else { %>
                                            <small class="text-muted italic">Sin correo</small>
                                        <% } %>
                                    </td>
                                    <td>
                                        <span class="badge bg-success"><%= item.num_cajas %></span>
                                    </td>
                                    <td>
                                        <% if (item.maestros && item.maestros.length > 0) { %>
                                            <% item.maestros.forEach((m, mIdx) => { %>
                                                <div class="small text-secondary mb-1" style="line-height: 1.2;">
                                                    <strong>M<%= mIdx + 1 %>:</strong> <%= m.nombre %><br>
                                                    <span class="text-muted" style="font-size: 0.7rem;"><i class="fas fa-phone me-1 no-print"></i><%= m.telefono %></span>
                                                    <% if (m.correo) { %>
                                                        <br><span class="text-primary" style="font-size: 0.7rem;"><i class="fas fa-envelope me-1 no-print"></i><%= m.correo %></span>
                                                    <% } %>
                                                </div>
                                            <% }) %>
                                        <% } else { %>
                                            <span class="small text-muted">Sin maestros</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (item.guerreritos_oracion && item.guerreritos_oracion.length > 0) { %>
                                            <% item.guerreritos_oracion.forEach((g, gIdx) => { %>
                                                <div class="small text-secondary mb-1" style="line-height: 1.2;">
                                                    <strong>G<%= gIdx + 1 %>:</strong> <%= g.nombre_guerrerito %><br>
                                                    <span class="text-muted" style="font-size: 0.7rem;">Tutor: <%= g.nombre_tutor %> (<%= g.telefono_tutor %>)</span>
                                                </div>
                                            <% }) %>
                                        <% } else { %>
                                            <span class="small text-muted">Sin guerreritos</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (item.guerreros_oracion && item.guerreros_oracion.length > 0) { %>
                                            <% item.guerreros_oracion.forEach((gu, guIdx) => { %>
                                                <div class="small text-secondary mb-1" style="line-height: 1.2;">
                                                    <strong>A<%= guIdx + 1 %>:</strong> <%= gu.nombre_guerrero %><br>
                                                    <span class="text-muted" style="font-size: 0.7rem;">Tel: <%= gu.telefono_guerrero %></span>
                                                </div>
                                            <% }) %>
                                        <% } else { %>
                                            <span class="small text-muted">Sin guerreros</span>
                                        <% } %>
                                    </td>
                                    <td class="no-print text-center">
                                        <form action="/eliminar-registro/<%= item.id %>" method="POST" onsubmit="return confirm('¿Estás seguro de eliminar este registro?');" style="display:inline;">
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Eliminar"><i class="fas fa-trash-alt"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">No hay registros guardados en el sistema para esta zona.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <% } %>

    <script>
        function filtrarTabla() {
            const input = document.getElementById('searchInput').value.toLowerCase();
            const filas = document.querySelectorAll('#tablaRegistros tbody tr');
            
            filas.forEach(fila => {
                const textoFila = fila.innerText.toLowerCase();
                if (textoFila.includes(input)) {
                    fila.style.display = '';
                } else {
                    fila.style.display = 'none';
                }
            });
        }
    </script>
</body>
</html>
