<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Check-in Exitoso | Evento</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-success d-flex align-items-center justify-content-center vh-100">
    <div class="card shadow-lg p-4 text-center bg-white" style="max-width: 450px; border-radius: 16px;">
        <% if (exito) { %>
            <div class="mb-3 text-success">
                <i class="fas fa-check-circle fa-4x animate-bounce"></i>
            </div>
            <h3 class="fw-bold text-success mb-1">¡Asistencia Confirmada!</h3>
            <p class="small text-muted mb-3">Check-in registrado correctamente en el sistema.</p>

            <div class="bg-light p-3 rounded text-start mb-3 border">
                <h5 class="fw-bold text-dark mb-1"><%= iglesia.nombre_iglesia %></h5>
                <p class="small mb-1"><strong>Pastor:</strong> <%= iglesia.nombre_pastor %></p>
                <p class="small mb-1"><strong>Líder:</strong> <%= iglesia.nombre_lider %></p>
                <p class="small mb-0"><strong>Cajitas a entregar:</strong> <span class="badge bg-success fs-6"><%= iglesia.num_cajas %></span></p>
            </div>

            <a href="/evento/checkin-dashboard" class="btn btn-success w-100 fw-bold">Ver Dashboard de Asistencia</a>
        <% } else { %>
            <div class="mb-3 text-danger">
                <i class="fas fa-times-circle fa-4x"></i>
            </div>
            <h3 class="fw-bold text-danger mb-1">Error de Lectura</h3>
            <p class="text-muted"><%= mensaje %></p>
            <a href="/evento/checkin-dashboard" class="btn btn-secondary w-100 fw-bold">Volver al Panel</a>
        <% } %>
    </div>
</body>
</html>
