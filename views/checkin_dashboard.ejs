<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Check-in Evento | Samaritan's Purse</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #0b221a; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #2b2b2b; margin: 0; padding: 0; }
        .checkin-container { max-width: 1600px; margin: 20px auto; background: #009639; border-radius: 16px; box-shadow: 0 15px 35px rgba(0,0,0,0.5); padding: 20px; }
        .checkin-header { background: #ffffff; border-radius: 12px; padding: 15px 20px; margin-bottom: 20px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; }
        .checkin-header img { height: 45px; width: auto; }

        .stat-esperadas { background-color: #0056b3; color: white; border-radius: 12px; padding: 18px; box-shadow: 0 4px 10px rgba(0,0,0,0.15); display: flex; justify-content: space-between; align-items: center; }
        .stat-llegadas { background-color: #198754; color: white; border-radius: 12px; padding: 18px; box-shadow: 0 4px 10px rgba(0,0,0,0.15); display: flex; justify-content: space-between; align-items: center; }
        .stat-faltantes { background-color: #dc3545; color: white; border-radius: 12px; padding: 18px; box-shadow: 0 4px 10px rgba(0,0,0,0.15); display: flex; justify-content: space-between; align-items: center; }
        .stat-cajitas { background-color: #ffc107; color: #533f03; border-radius: 12px; padding: 18px; box-shadow: 0 4px 10px rgba(0,0,0,0.15); display: flex; justify-content: space-between; align-items: center; }

        .table-section { background: #ffffff; border-radius: 12px; padding: 20px; box-shadow: 0 5px 20px rgba(0,0,0,0.15); }
        .table-custom th { background-color: #d1e7dd !important; color: #0f5132 !important; font-size: 0.78rem; text-transform: uppercase; }
        .table-custom td { font-size: 0.78rem; vertical-align: middle; }

        .btn-wa-qr {
            background-color: #25D366;
            color: #ffffff;
            border: none;
            font-weight: bold;
        }
        .btn-wa-qr:hover {
            background-color: #1eb857;
            color: #ffffff;
        }
    </style>
</head>
<body>
    <div class="checkin-container">
        <div class="checkin-header">
            <div class="d-flex align-items-center">
                <img src="/images/logo.png" alt="Logo" class="me-3">
                <div>
                    <h4 class="fw-bold text-success mb-0"><i class="fas fa-qrcode me-2"></i> Control de Acceso y Check-in</h4>
                    <p class="small text-muted mb-0">Monitoreo automático de descarga de QR, concentrado y asistencia</p>
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a href="/descargar-qr" target="_blank" class="btn btn-outline-success btn-sm fw-bold">
                    <i class="fas fa-download me-1"></i> Buscador Público QR
                </a>
                <a href="/admin" class="btn btn-dark btn-sm fw-bold">
                    <i class="fas fa-arrow-left me-1"></i> Volver al Panel
                </a>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-3 col-sm-6">
                <div class="stat-esperadas">
                    <div>
                        <span class="small text-uppercase fw-bold opacity-75">Iglesias Esperadas</span>
                        <h2 class="fw-bold mb-0"><%= totalEsperadas %></h2>
                        <small class="opacity-75">QR descargados: <strong><%= locals.totalQrDescargados || 0 %></strong></small>
                    </div>
                    <i class="fas fa-church fa-2x opacity-50"></i>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="stat-llegadas">
                    <div><span class="small text-uppercase fw-bold opacity-75">Confirmadas</span><h2 class="fw-bold mb-0"><%= totalLlegadas %></h2></div>
                    <i class="fas fa-user-check fa-2x opacity-50"></i>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="stat-faltantes">
                    <div><span class="small text-uppercase fw-bold opacity-75">Pendientes</span><h2 class="fw-bold mb-0"><%= totalFaltantes %></h2></div>
                    <i class="fas fa-clock fa-2x opacity-50"></i>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="stat-cajitas">
                    <div><span class="small text-uppercase fw-bold opacity-75">Cajitas Confirmadas</span><h2 class="fw-bold mb-0"><%= totalCajitasEntregadas %></h2></div>
                    <i class="fas fa-box-open fa-2x opacity-50"></i>
                </div>
            </div>
        </div>

        <div class="table-section">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <h6 class="fw-bold text-success mb-0"><i class="fas fa-clipboard-list me-2"></i> Lista de Control de Acceso</h6>
                <div class="d-flex gap-2 flex-wrap">
                    <form method="GET" action="/evento/checkin-dashboard" class="m-0">
                        <select name="zona" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="">-- Filtrar por todas las zonas --</option>
                            <% if (locals.nombresZonas) { %>
                                <% Object.keys(nombresZonas).forEach(zKey => { %>
                                    <option value="<%= zKey %>" <%= zonaFiltro === zKey ? 'selected' : '' %>><%= nombresZonas[zKey] %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </form>
                    <select id="filtroQr" class="form-select form-select-sm" onchange="filtrarTablaCheckin()">
                        <option value="">-- QR: Todos --</option>
                        <option value="descargado">QR Descargado</option>
                        <option value="pendiente">QR Sin descargar</option>
                    </select>
                    <input type="text" id="buscarCheckin" class="form-control form-control-sm" style="min-width: 240px;" placeholder="Buscar iglesia o pastor (sin acentos)..." onkeyup="filtrarTablaCheckin()">
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover table-custom align-middle" id="tablaCheckin">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Iglesia / Zona</th>
                            <th>Pastor / Contacto</th>
                            <th>Cajitas</th>
                            <th class="text-center">Concentrado</th>
                            <th class="text-center">QR Descargado</th>
                            <th class="text-center">Estado de Asistencia</th>
                            <th class="text-center">Hora de Llegada</th>
                            <th class="text-center">Acción Manual</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (iglesias && iglesias.length > 0) { %>
                            <% iglesias.forEach((item, idx) => {
                                const zonaVisible = (locals.nombresZonas && nombresZonas[item.zona]) ? nombresZonas[item.zona].toUpperCase() : (item.zona || '').toUpperCase();
                                const asistio = Boolean(item.asistencia_confirmada);
                                const concHecho = Boolean(item.concentrado_realizado);
                                const qrDescargado = Boolean(item.qr_descargado);
                                const telLimpio = (item.telefono_pastor || '').replace(/\D/g, '');
                                const tel10 = telLimpio.length >= 10 ? telLimpio.slice(-10) : telLimpio;

                                let horaTexto = '--:--';
                                if (asistio && item.fecha_llegada) {
                                    const dt = new Date(item.fecha_llegada);
                                    horaTexto = dt.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
                                }

                                let fechaQrTexto = '';
                                if (qrDescargado && item.fecha_descarga_qr) {
                                    const dtQr = new Date(item.fecha_descarga_qr);
                                    fechaQrTexto = dtQr.toLocaleDateString('es-MX', { day: '2-digit', month: '2-digit' }) + ' ' + dtQr.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
                                }
                            %>
                                <tr data-qr-estado="<%= qrDescargado ? 'descargado' : 'pendiente' %>">
                                    <td class="fw-bold"><%= idx + 1 %></td>
                                    <td>
                                        <strong><%= item.nombre_iglesia %></strong><br>
                                        <small class="text-muted text-uppercase"><%= zonaVisible %></small>
                                    </td>
                                    <td>
                                        <div><%= item.nombre_pastor %></div>
                                        <small class="text-muted"><i class="fas fa-phone me-1"></i> <%= item.telefono_pastor || 'Sin tel.' %></small>
                                    </td>
                                    <td><span class="badge bg-success"><%= item.num_cajas || 0 %> cajas</span></td>
                                    <td class="text-center">
                                        <span class="badge rounded-pill <%= concHecho ? 'bg-success' : 'bg-danger' %>">
                                            <i class="fas <%= concHecho ? 'fa-check-circle' : 'fa-times-circle' %> me-1"></i>
                                            <%= concHecho ? 'Realizado' : 'No realizado' %>
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <% if (qrDescargado) { %>
                                            <span class="badge rounded-pill bg-success px-2 py-1">
                                                <i class="fas fa-check me-1"></i> Descargado
                                            </span>
                                            <% if (fechaQrTexto) { %>
                                                <div class="text-muted" style="font-size: 0.68rem;"><%= fechaQrTexto %></div>
                                            <% } %>
                                        <% } else { %>
                                            <span class="badge rounded-pill bg-secondary px-2 py-1">
                                                <i class="fas fa-hourglass-half me-1"></i> No descargado
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <% if (asistio) { %>
                                            <span class="badge rounded-pill bg-success px-3 py-2"><i class="fas fa-check-circle me-1"></i> Presente (Confirmado)</span>
                                        <% } else { %>
                                            <span class="badge rounded-pill bg-secondary px-3 py-2"><i class="fas fa-clock me-1"></i> Pendiente de Llegada</span>
                                        <% } %>
                                    </td>
                                    <td class="text-center fw-bold text-secondary"><%= horaTexto %></td>
                                    <td class="text-center">
                                        <div class="d-inline-flex align-items-center gap-1 flex-wrap justify-content-center">
                                            <form action="/evento/marcar-asistencia/<%= item.id %>" method="POST" style="display:inline;">
                                                <input type="hidden" name="estado" value="<%= asistio ? 'false' : 'true' %>">
                                                <button type="submit" class="btn btn-sm fw-bold <%= asistio ? 'btn-danger' : 'btn-success' %>">
                                                    <i class="fas <%= asistio ? 'fa-times' : 'fa-check' %> me-1"></i>
                                                    <%= asistio ? 'Desmarcar' : 'Check-in' %>
                                                </button>
                                            </form>
                                            <a href="/iglesia/qr/<%= item.id %>" target="_blank" class="btn btn-outline-secondary btn-sm" title="Ver QR">
                                                <i class="fas fa-qrcode"></i>
                                            </a>
                                            <button type="button"
                                                    class="btn btn-wa-qr btn-sm"
                                                    onclick="enviarQrWhatsAppPastor(this, '<%= item.id %>', '<%= tel10 %>', `<%= (item.nombre_pastor || '').replace(/`/g, '') %>`, `<%= (item.nombre_iglesia || '').replace(/`/g, '') %>`)"
                                                    title="Copiar imagen QR y abrir WhatsApp del pastor">
                                                <i class="fab fa-whatsapp"></i> QR
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="9" class="text-center text-muted py-4">No hay iglesias para mostrar.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        function normalizarSinAcentos(texto) {
            return (texto || '')
                .toString()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .toLowerCase()
                .trim();
        }

        function filtrarTablaCheckin() {
            const q = normalizarSinAcentos(document.getElementById('buscarCheckin').value);
            const qrFiltro = document.getElementById('filtroQr').value;
            const filas = document.querySelectorAll('#tablaCheckin tbody tr[data-qr-estado]');

            filas.forEach(tr => {
                const txt = normalizarSinAcentos(tr.innerText);
                const estadoQr = tr.getAttribute('data-qr-estado');
                const pasaTexto = !q || txt.includes(q);
                const pasaQr = !qrFiltro || estadoQr === qrFiltro;
                tr.style.display = (pasaTexto && pasaQr) ? '' : 'none';
            });
        }

        async function enviarQrWhatsAppPastor(btn, iglesiaId, tel10, nombrePastor, nombreIglesia) {
            const telLimpio = (tel10 || '').replace(/\D/g, '');
            if (!telLimpio || telLimpio.length < 10) {
                alert('Este pastor no tiene un teléfono válido de 10 dígitos registrado.');
                return;
            }

            const htmlOriginal = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = `<i class="fas fa-spinner fa-spin"></i>`;

            try {
                const resp = await fetch(`/api/qr-data/${iglesiaId}`);
                const data = await resp.json();
                if (!resp.ok || !data.success || !data.qrImageSrc) {
                    alert('No se pudo generar la imagen QR de esta iglesia.');
                    return;
                }

                let imagenCopiada = false;
                if (navigator.clipboard && window.ClipboardItem) {
                    try {
                        const imgResp = await fetch(data.qrImageSrc);
                        const imgBlob = await imgResp.blob();
                        await navigator.clipboard.write([
                            new ClipboardItem({ 'image/png': imgBlob })
                        ]);
                        imagenCopiada = true;
                    } catch (_) {
                        imagenCopiada = false;
                    }
                }

                const textoMensaje = `¡Dios le bendiga pastor *${nombrePastor}*! Le compartimos el código QR de acceso para la iglesia *${nombreIglesia}*. Preséntelo al llegar al evento.`;
                const numeroWa = telLimpio.startsWith('52') ? telLimpio : `52${telLimpio}`;
                const waUrl = `https://wa.me/${numeroWa}?text=${encodeURIComponent(textoMensaje)}`;

                if (!imagenCopiada) {
                    const linkDescarga = document.createElement('a');
                    linkDescarga.href = data.qrImageSrc;
                    linkDescarga.download = `QR_${(nombreIglesia || 'Iglesia').replace(/[^a-zA-Z0-9]/g, '_')}.png`;
                    document.body.appendChild(linkDescarga);
                    linkDescarga.click();
                    document.body.removeChild(linkDescarga);
                }

                window.open(waUrl, '_blank');

                if (imagenCopiada) {
                    alert('Imagen QR copiada al portapapeles. En WhatsApp solo presiona Ctrl + V (o Pegar) para enviar la imagen junto con el mensaje.');
                } else {
                    alert('Se descargó la imagen QR para que puedas adjuntarla fácilmente en el chat de WhatsApp que se acaba de abrir.');
                }
            } catch (err) {
                alert('Error al preparar el QR para WhatsApp.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = htmlOriginal;
            }
        }
    </script>
</body>
</html>
