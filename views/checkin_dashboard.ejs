<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard de Check-in | Evento</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #0b221a; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #2b2b2b; }
        .dashboard-container { max-width: 1500px; margin: 20px auto; background: #009639; border-radius: 16px; box-shadow: 0 15px 35px rgba(0,0,0,0.5); padding: 25px; }
        .header-box { background: #ffffff; border-radius: 12px; padding: 15px 20px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; }
        .stat-card { border-radius: 12px; padding: 18px; color: white; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 10px rgba(0,0,0,0.15); }
        .table-section { background: #ffffff; border-radius: 12px; padding: 20px; box-shadow: 0 5px 20px rgba(0,0,0,0.15); }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <!-- ENCABEZADO -->
        <div class="header-box">
            <div class="d-flex align-items-center">
                <img src="/images/logo.png" alt="Logo" style="height: 45px;" class="me-3">
                <div>
                    <h4 class="fw-bold text-success mb-0"><i class="fas fa-clipboard-check me-2"></i> Control de Asistencia y Check-in</h4>
                    <p class="small text-muted mb-0">Monitoreo de llegada de iglesias al evento en tiempo real</p>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a href="/admin" class="btn btn-outline-secondary btn-sm fw-bold"><i class="fas fa-arrow-left me-1"></i> Regresar al Panel Zonal</a>
                <button onclick="window.print()" class="btn btn-dark btn-sm fw-bold"><i class="fas fa-print me-1"></i> Imprimir Reporte</button>
            </div>
        </div>

        <!-- TARJETAS DE INDICADORES (KPIs) -->
        <div class="row g-3 mb-4">
            <div class="col-md-3 col-sm-6">
                <div class="stat-card" style="background-color: #0056b3;">
                    <div>
                        <span class="small text-uppercase fw-bold opacity-75">Iglesias Esperadas</span>
                        <h2 class="fw-bold mb-0"><%= totalEsperadas %></h2>
                    </div>
                    <i class="fas fa-church fa-2x opacity-50"></i>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="stat-card" style="background-color: #198754;">
                    <div>
                        <span class="small text-uppercase fw-bold opacity-75">Iglesias Llegadas</span>
                        <h2 class="fw-bold mb-0"><%= totalLlegadas %></h2>
                    </div>
                    <i class="fas fa-check-circle fa-2x opacity-50"></i>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="stat-card" style="background-color: #dc3545;">
                    <div>
                        <span class="small text-uppercase fw-bold opacity-75">Faltantes por Llegar</span>
                        <h2 class="fw-bold mb-0"><%= totalFaltantes %></h2>
                    </div>
                    <i class="fas fa-hourglass-half fa-2x opacity-50"></i>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="stat-card" style="background-color: #ffc107; color: #533f03;">
                    <div>
                        <span class="small text-uppercase fw-bold opacity-75">Cajitas Recibidas</span>
                        <h2 class="fw-bold mb-0"><%= totalCajitasEntregadas %></h2>
                    </div>
                    <i class="fas fa-box-open fa-2x opacity-50"></i>
                </div>
            </div>
        </div>

        <!-- SECCIÓN DE FILTROS Y TABLA -->
        <div class="table-section">
            <div class="row g-2 align-items-center mb-3">
                <div class="col-md-4">
                    <h6 class="fw-bold text-success mb-0"><i class="fas fa-list me-1"></i> Lista de Control de Acceso</h6>
                </div>
                <div class="col-md-4">
                    <form method="GET" action="/evento/checkin-dashboard">
                        <select name="zona" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="">-- Filtrar por todas las zonas --</option>
                            <option value="san_andres" <%= zonaFiltro === 'san_andres' ? 'selected' : '' %>>San Andrés Tuxtla</option>
                            <option value="medellin" <%= zonaFiltro === 'medellin' ? 'selected' : '' %>>Medellín</option>
                            <option value="manlio" <%= zonaFiltro === 'manlio' ? 'selected' : '' %>>Manlio Fabio</option>
                            <option value="orizaba" <%= zonaFiltro === 'orizaba' ? 'selected' : '' %>>Orizaba</option>
                            <option value="cd_aleman" <%= zonaFiltro === 'cd_aleman' ? 'selected' : '' %>>Ciudad Alemán</option>
                            <option value="xalapa" <%= zonaFiltro === 'xalapa' ? 'selected' : '' %>>Xalapa</option>
                            <option value="carlos_a_carrillo" <%= zonaFiltro === 'carlos_a_carrillo' ? 'selected' : '' %>>Carlos A. Carrillo</option>
                            <option value="tezonapa" <%= zonaFiltro === 'tezonapa' ? 'selected' : '' %>>Tezonapa</option>
                        </select>
                    </form>
                </div>
                <div class="col-md-4">
                    <input type="text" id="searchCheckin" class="form-control form-control-sm" placeholder="Buscar iglesia o pastor en la lista..." onkeyup="filtrarTablaCheckin()">
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle small" id="tablaCheckin">
                    <thead class="table-success">
                        <tr>
                            <th>#</th>
                            <th>Iglesia / Zona</th>
                            <th>Pastor / Contacto</th>
                            <th>Cajitas</th>
                            <th class="text-center">Estado de Asistencia</th>
                            <th>Hora de Llegada</th>
                            <th class="text-center">Acción Manual</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (iglesias && iglesias.length > 0) { %>
                            <% iglesias.forEach((item, index) => { %>
                                <tr>
                                    <td class="fw-bold"><%= index + 1 %></td>
                                    <td>
                                        <strong><%= item.nombre_iglesia %></strong><br>
                                        <small class="text-muted text-uppercase" style="font-size: 0.68rem;"><%= item.zona %></small>
                                    </td>
                                    <td>
                                        <%= item.nombre_pastor %><br>
                                        <small class="text-muted"><i class="fas fa-phone me-1"></i> <%= item.telefono_pastor || 'Sin tel.' %></small>
                                    </td>
                                    <td><span class="badge bg-success"><%= item.num_cajas %> cajas</span></td>
                                    <td class="text-center">
                                        <% if (item.asistencia_confirmada) { %>
                                            <span class="badge bg-success px-3 py-2"><i class="fas fa-check-circle me-1"></i> Presente (Confirmado)</span>
                                        <% } else { %>
                                            <span class="badge bg-secondary px-3 py-2"><i class="fas fa-clock me-1"></i> Pendiente de Llegada</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (item.fecha_llegada) { %>
                                            <small class="text-muted"><%= new Date(item.fecha_llegada).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %> hrs</small>
                                        <% } else { %>
                                            <span class="text-muted fst-italic">--:--</span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <form action="/evento/marcar-asistencia/<%= item.id %>" method="POST" style="display:inline;">
                                            <% if (item.asistencia_confirmada) { %>
                                                <input type="hidden" name="estado" value="false">
                                                <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" title="Marcar como no presentado">Desmarcar</button>
                                            <% } else { %>
                                                <input type="hidden" name="estado" value="true">
                                                <button type="submit" class="btn btn-success btn-sm py-0 px-2" title="Marcar asistencia manualmente"><i class="fas fa-check me-1"></i> Check-in</button>
                                            <% } %>
                                        </form>
                                        <a href="/iglesia/qr/<%= item.id %>" target="_blank" class="btn btn-outline-dark btn-sm py-0 px-2 ms-1" title="Ver QR"><i class="fas fa-qrcode"></i></a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="7" class="text-center text-muted py-4">No hay iglesias registradas en esta zona.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        function filtrarTablaCheckin() {
            const input = document.getElementById('searchCheckin').value.toLowerCase();
            const filas = document.querySelectorAll('#tablaCheckin tbody tr');
            filas.forEach(fila => {
                const texto = fila.innerText.toLowerCase();
                fila.style.display = texto.includes(input) ? '' : 'none';
            });
        }
    </script>
</body>
</html>
