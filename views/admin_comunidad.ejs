<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Grupos WhatsApp | Samaritan's Purse</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #0b221a; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #2b2b2b; }
        .admin-container { max-width: 1400px; margin: 20px auto; background: #ffffff; border-radius: 16px; box-shadow: 0 15px 35px rgba(0,0,0,0.5); padding: 25px; }
        .badge-rol { font-size: 0.75rem; text-transform: uppercase; font-weight: bold; }
    </style>
</head>
<body>
    <div class="container admin-container">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h4 class="fw-bold text-success mb-0"><i class="fab fa-whatsapp text-success me-2"></i> Control de Integración a Grupos de WhatsApp</h4>
                <p class="small text-muted mb-0">Zona Activa: <span class="fw-bold text-uppercase text-danger"><%= zona %></span></p>
            </div>
            <a href="/admin" class="btn btn-outline-secondary btn-sm fw-bold"><i class="fas fa-arrow-left me-1"></i> Regresar al Panel Principal</a>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle small">
                <thead class="table-success">
                    <tr>
                        <th>#</th>
                        <th>Iglesia / Pastor</th>
                        <th>Estado en Grupos</th>
                        <th>Integrantes Registrados (Comunidad)</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (iglesias && iglesias.length > 0) { %>
                        <% iglesias.forEach((iglesia, idx) => { 
                            let miembros = iglesia.miembros_comunidad || [];
                            let tieneMiembros = miembros.length > 0;
                        %>
                            <tr>
                                <td class="fw-bold"><%= idx + 1 %></td>
                                <td>
                                    <strong><%= iglesia.nombre_iglesia || 'Sin nombre' %></strong><br>
                                    <small class="text-muted">Pastor: <%= iglesia.nombre_pastor %></small><br>
                                    <small class="text-muted"><i class="fas fa-phone me-1"></i> <%= iglesia.telefono_pastor || 'Sin tel.' %></small>
                                </td>
                                <td>
                                    <% if (tieneMiembros) { %>
                                        <span class="badge bg-success"><i class="fas fa-check me-1"></i> Integrado (<%= miembros.length %>)</span>
                                    <% } else { %>
                                        <span class="badge bg-danger"><i class="fas fa-clock me-1"></i> Pendiente de unirse</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (tieneMiembros) { %>
                                        <% miembros.forEach(m => { %>
                                            <div class="mb-1 border-bottom pb-1 d-flex justify-content-between align-items-center">
                                                <div>
                                                    <span class="fw-bold text-success me-1">[<%= m.rol.toUpperCase() %>]</span> <%= m.nombre_completo %> 
                                                    <span class="text-muted">(<%= m.telefono %>)</span>
                                                </div>
                                            </div>
                                        <% }) %>
                                    <% } else { %>
                                        <span class="text-muted fst-italic">Ningún integrante de esta iglesia se ha unido al grupo aún.</span>
                                    <% } %>
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-success fw-bold" onclick='verDetalleIglesia(<%= JSON.stringify(iglesia) %>)'>
                                        <i class="fas fa-eye me-1"></i> Detalle
                                    </button>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="5" class="text-center text-muted py-4">No hay registros de iglesias en esta zona.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- MODAL DETALLE DE IGLESIA E INTEGRANTES DE COMUNIDAD -->
    <div class="modal fade" id="modalDetalleIglesia" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-success text-white py-2">
                    <h6 class="modal-title fw-bold" id="modalDetalleTitulo"><i class="fas fa-church me-2"></i> Detalle de la Iglesia</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-3">
                    <!-- DATOS GENERALES -->
                    <div class="bg-light p-3 rounded mb-3 border">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <span class="small text-muted d-block">Pastor Principal:</span>
                                <strong id="lblPastorNombre">-</strong><br>
                                <small id="lblPastorTel" class="text-muted"><i class="fas fa-phone me-1"></i> -</small>
                            </div>
                            <div class="col-md-6">
                                <span class="small text-muted d-block">Líder de Proyecto:</span>
                                <strong id="lblLiderNombre">-</strong><br>
                                <small id="lblLiderTel" class="text-muted"><i class="fas fa-phone me-1"></i> -</small>
                            </div>
                            <div class="col-12 mt-2">
                                <span class="small text-muted d-block">Dirección de la Iglesia:</span>
                                <small id="lblDireccion" class="fw-bold text-dark">-</small>
                            </div>
                        </div>
                    </div>

                    <!-- LISTA DE INTEGRANTES REGISTRADOS EN COMUNIDAD -->
                    <h6 class="fw-bold text-success border-bottom pb-2 mb-3">
                        <i class="fab fa-whatsapp me-2"></i> Integrantes Registrados en Grupos de WhatsApp
                    </h6>

                    <div class="table-responsive">
                        <table class="table table-sm table-striped align-middle" id="tablaDetalleIntegrantes">
                            <thead class="table-light">
                                <tr>
                                    <th>Rol</th>
                                    <th>Nombre Completo</th>
                                    <th>Teléfono</th>
                                    <th>Correo</th>
                                    <th class="text-end">Acción</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyIntegrantes">
                                <!-- Se llena con JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary btn-sm fw-bold" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL EDITAR INTEGRANTE -->
    <div class="modal fade" id="modalEditarMiembro" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white py-2">
                    <h6 class="modal-title fw-bold">Editar Integrante</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="formEditarMiembro" method="POST" action="">
                    <div class="modal-body p-3">
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Nombre Completo:</label>
                            <input type="text" name="nombre_completo" id="txtEditNombre" class="form-control form-control-sm" required>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Teléfono:</label>
                            <input type="tel" name="telefono" id="txtEditTel" class="form-control form-control-sm" required>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Correo:</label>
                            <input type="email" name="correo" id="txtEditCorreo" class="form-control form-control-sm">
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Rol:</label>
                            <select name="rol" id="selectEditRol" class="form-select form-select-sm" required>
                                <option value="pastor">Pastor (Grupo CM)</option>
                                <option value="lider">Líder de Proyecto</option>
                                <option value="maestro">Maestro (Grupo Maestros)</option>
                                <option value="guerrero">Guerrero de Oración / Tutor</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer py-1">
                        <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">Guardar Cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let modalDetalleBs = null;
        let modalEditarMiembroBs = null;

        function verDetalleIglesia(iglesia) {
            document.getElementById('modalDetalleTitulo').innerHTML = `<i class="fas fa-church me-2"></i> ${iglesia.nombre_iglesia || 'Iglesia Sin Nombre'}`;
            document.getElementById('lblPastorNombre').innerText = iglesia.nombre_pastor || 'No registrado';
            document.getElementById('lblPastorTel').innerText = iglesia.telefono_pastor || 'Sin teléfono';
            document.getElementById('lblLiderNombre').innerText = iglesia.nombre_lider || 'No registrado';
            document.getElementById('lblLiderTel').innerText = iglesia.telefono_lider || 'Sin teléfono';
            document.getElementById('lblDireccion').innerText = iglesia.direccion || 'Sin dirección registrada';

            const tbody = document.getElementById('tbodyIntegrantes');
            tbody.innerHTML = '';

            const miembros = iglesia.miembros_comunidad || [];
            if (miembros.length > 0) {
                miembros.forEach(m => {
                    let badgeClass = 'bg-primary';
                    if (m.rol === 'pastor') badgeClass = 'bg-success';
                    else if (m.rol === 'lider') badgeClass = 'bg-warning text-dark';
                    else if (m.rol === 'maestro') badgeClass = 'bg-info text-dark';
                    else if (m.rol === 'guerrero') badgeClass = 'bg-purple text-white';

                    tbody.innerHTML += `
                        <tr>
                            <td><span class="badge ${badgeClass} badge-rol">${m.rol}</span></td>
                            <td class="fw-bold">${m.nombre_completo}</td>
                            <td>${m.telefono}</td>
                            <td>${m.correo || 'Sin correo'}</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-1 me-1" onclick='abrirEditarMiembro(${JSON.stringify(m)})'>
                                    <i class="fas fa-edit"></i>
                                </button>
                                <form action="/admin-comunidad/eliminar/${m.id}" method="POST" style="display:inline;" onsubmit="return confirm('¿Eliminar de la comunidad?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-1"><i class="fas fa-trash-alt"></i></button>
                                </form>
                            </td>
                        </tr>
                    `;
                });
            } else {
                tbody.innerHTML = `<tr><td colspan="5" class="text-center text-muted py-3">Ningún integrante registrado para esta iglesia.</td></tr>`;
            }

            if (!modalDetalleBs) modalDetalleBs = new bootstrap.Modal(document.getElementById('modalDetalleIglesia'));
            modalDetalleBs.show();
        }

        function abrirEditarMiembro(m) {
            document.getElementById('formEditarMiembro').action = '/admin-comunidad/editar/' + m.id;
            document.getElementById('txtEditNombre').value = m.nombre_completo;
            document.getElementById('txtEditTel').value = m.telefono;
            document.getElementById('txtEditCorreo').value = m.correo || '';
            document.getElementById('selectEditRol').value = m.rol;

            if (!modalEditarMiembroBs) modalEditarMiembroBs = new bootstrap.Modal(document.getElementById('modalEditarMiembro'));
            modalEditarMiembroBs.show();
        }
    </script>
</body>
</html>
