<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel Comunidad WhatsApp | Samaritan's Purse</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #0b221a; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #2b2b2b; margin: 0; padding: 0; }
        .admin-container { max-width: 1400px; margin: 20px auto; background: #009639; border-radius: 16px; box-shadow: 0 15px 35px rgba(0,0,0,0.5); padding: 20px; }
        .admin-header { background: #ffffff; border-radius: 12px; padding: 15px 20px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; }
        .admin-header img { height: 45px; }
        .card-preview { border-radius: 12px; transition: transform 0.2s, box-shadow 0.2s; background: #ffffff; }
        .card-preview:hover { transform: translateY(-4px); box-shadow: 0 8px 20px rgba(0,0,0,0.15) !important; }
        .border-completo { border-left: 8px solid #198754 !important; }
        .border-parcial { border-left: 8px solid #ffc107 !important; }
        .border-pendiente { border-left: 8px solid #dc3545 !important; }
    </style>
</head>
<body>

    <div class="admin-container">
        <!-- HEADER DEL PANEL -->
        <div class="admin-header shadow-sm">
            <div class="d-flex align-items-center">
                <img src="/images/logo.png" alt="Logo" class="me-3">
                <div>
                    <h4 class="fw-bold text-success mb-0"><i class="fab fa-whatsapp me-2"></i> Monitoreo de Grupos WhatsApp</h4>
                    <p class="small text-muted mb-0">Zona Activa: <span class="fw-bold text-uppercase text-danger"><%= zona || 'Sin Sesión' %></span></p>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a href="/admin" class="btn btn-outline-success btn-sm fw-bold"><i class="fas fa-list me-1"></i> Dashboard General</a>
                <a href="/logout" class="btn btn-outline-secondary btn-sm"><i class="fas fa-sign-out-alt"></i> Salir</a>
            </div>
        </div>

        <% if (!zona) { %>
            <div class="card p-4 text-center bg-white shadow-sm">
                <h5 class="text-danger fw-bold">Acceso Requerido</h5>
                <p class="text-muted mb-3">Inicia sesión en el panel principal para acceder a los datos de tu zona.</p>
                <a href="/admin" class="btn btn-success btn-sm m-auto fw-bold" style="max-width: 200px;">Ir a Iniciar Sesión</a>
            </div>
        <% } else { %>

            <!-- BARRA DE BÚSQUEDA Y FILTRADO -->
            <div class="card bg-white p-3 mb-4 shadow-sm border-0">
                <div class="row g-2 align-items-center">
                    <div class="col-md-6">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                            <input type="text" id="inputBuscarComunidad" class="form-control form-control-sm border-start-0" placeholder="Buscar por iglesia, pastor o dirección..." onkeyup="filtrarTarjetasComunidad()">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <select id="selectFiltroEstado" class="form-select form-select-sm" onchange="filtrarTarjetasComunidad()">
                            <option value="">-- Todos los estados --</option>
                            <option value="completo">🟢 Completo (Todos dentro)</option>
                            <option value="parcial">🟡 Parcial (En proceso)</option>
                            <option value="pendiente">🔴 Pendiente (Sin registros)</option>
                        </select>
                    </div>
                    <div class="col-md-2 text-end">
                        <button class="btn btn-outline-secondary btn-sm w-100 fw-bold" onclick="limpiarFiltroComunidad()"><i class="fas fa-undo me-1"></i> Limpiar</button>
                    </div>
                </div>
            </div>

            <!-- CUADRÍCULA DE TARJETAS DE IGLESIAS -->
            <div class="row g-3" id="gridTarjetasIglesias">
                <% if (iglesias && iglesias.length > 0) { %>
                    <% iglesias.forEach((iglesia) => { 
                        let miembros = iglesia.miembros_comunidad || [];
                        let tienePastor = miembros.some(m => m.rol === 'pastor');
                        let tieneLider = miembros.some(m => m.rol === 'lider');
                        let tieneMaestro = miembros.some(m => m.rol === 'maestro');

                        let claseEstado = 'border-pendiente';
                        let estadoCodigo = 'pendiente';
                        let badgeTexto = '🔴 Sin Registro';
                        let badgeClase = 'bg-danger';

                        if (tienePastor && tieneLider && tieneMaestro) {
                            claseEstado = 'border-completo';
                            estadoCodigo = 'completo';
                            badgeTexto = '🟢 Equipo Completo';
                            badgeClase = 'bg-success';
                        } else if (miembros.length > 0) {
                            claseEstado = 'border-parcial';
                            estadoCodigo = 'parcial';
                            badgeTexto = `🟡 Parcial (${miembros.length} Integrantes)`;
                            badgeClase = 'bg-warning text-dark';
                        }
                    %>
                        <div class="col-lg-4 col-md-6 item-tarjeta-iglesia" 
                             data-iglesia="<%= (iglesia.nombre_iglesia || '').toLowerCase() %>" 
                             data-pastor="<%= (iglesia.nombre_pastor || '').toLowerCase() %>"
                             data-estado="<%= estadoCodigo %>">
                            <div class="card card-preview h-100 shadow-sm <%= claseEstado %>">
                                <div class="card-body p-3 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="fw-bold text-dark mb-0 text-truncate" style="max-width: 65%;"><%= iglesia.nombre_iglesia %></h6>
                                            <span class="badge <%= badgeClase %>" style="font-size: 0.7rem;"><%= badgeTexto %></span>
                                        </div>

                                        <p class="small text-muted mb-1"><i class="fas fa-user-tie me-1 text-success"></i> <strong>Pastor:</strong> <%= iglesia.nombre_pastor %></p>
                                        <p class="small text-muted mb-2"><i class="fas fa-map-marker-alt me-1 text-danger"></i> <%= iglesia.direccion %></p>

                                        <!-- ROLES REGISTRADOS -->
                                        <div class="d-flex flex-wrap gap-1 mb-3">
                                            <span class="badge <%= tienePastor ? 'bg-success' : 'bg-light text-muted border' %>" style="font-size: 0.65rem;">
                                                <i class="fas <%= tienePastor ? 'fa-check' : 'fa-times' %> me-1"></i> Pastor
                                            </span>
                                            <span class="badge <%= tieneLider ? 'bg-success' : 'bg-light text-muted border' %>" style="font-size: 0.65rem;">
                                                <i class="fas <%= tieneLider ? 'fa-check' : 'fa-times' %> me-1"></i> Líder
                                            </span>
                                            <span class="badge <%= tieneMaestro ? 'bg-success' : 'bg-light text-muted border' %>" style="font-size: 0.65rem;">
                                                <i class="fas <%= tieneMaestro ? 'fa-check' : 'fa-times' %> me-1"></i> Maestros
                                            </span>
                                        </div>
                                    </div>

                                    <button class="btn btn-outline-success btn-sm w-100 fw-bold mt-2" onclick="verDetalleIglesia('<%= iglesia.id %>', '<%= iglesia.nombre_iglesia.replace(/'/g, '') %>', '<%= encodeURIComponent(JSON.stringify(miembros)) %>')">
                                        <i class="fas fa-eye me-1"></i> Ver Integrantes (<%= miembros.length %>)
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-12 text-center text-white py-5">
                        <h5>No se encontraron iglesias en esta zona.</h5>
                    </div>
                <% } %>
            </div>

        <% } %>
    </div>

    <!-- MODAL DE DESGLOSE COMPLETO CON EDICIÓN Y BORRADO -->
    <div class="modal fade" id="modalDetalleComunidad" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-success text-white py-2">
                    <h6 class="modal-title fw-bold" id="modalTituloIglesia"><i class="fab fa-whatsapp me-2"></i> Integrantes Registrados</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover small mb-0">
                            <thead class="table-success">
                                <tr>
                                    <th>#</th>
                                    <th>Nombre Completo</th>
                                    <th>Rol</th>
                                    <th>Teléfono</th>
                                    <th>Correo</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="tablaCuerpoIntegrantes">
                                <!-- Se llena dinámicamente con JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL PARA EDITAR INTEGRANTE -->
    <div class="modal fade" id="modalEditarIntegrante" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white py-2">
                    <h6 class="modal-title fw-bold">Editar Integrante</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="formEditarIntegrante" method="POST" action="">
                    <div class="modal-body">
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Nombre Completo:</label>
                            <input type="text" name="nombre_completo" id="editNombre" class="form-control form-control-sm" required>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Rol:</label>
                            <select name="rol" id="editRol" class="form-select form-select-sm" required>
                                <option value="pastor">Pastor</option>
                                <option value="lider">Líder de Proyecto</option>
                                <option value="maestro">Maestro</option>
                                <option value="guerrero">Guerrero de Oración</option>
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Teléfono:</label>
                            <input type="tel" name="telefono" id="editTelefono" class="form-control form-control-sm" required>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Correo:</label>
                            <input type="email" name="correo" id="editCorreo" class="form-control form-control-sm">
                        </div>
                    </div>
                    <div class="modal-footer py-1">
                        <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">Guardar Cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let modalDetalleBs = null;
        let modalEditarBs = null;

        function filtrarTarjetasComunidad() {
            const busqueda = document.getElementById('inputBuscarComunidad').value.toLowerCase().trim();
            const estado = document.getElementById('selectFiltroEstado').value;
            const tarjetas = document.querySelectorAll('.item-tarjeta-iglesia');

            tarjetas.forEach(t => {
                const iglesia = t.getAttribute('data-iglesia');
                const pastor = t.getAttribute('data-pastor');
                const estadoVal = t.getAttribute('data-estado');

                const coincideBusqueda = !busqueda || iglesia.includes(busqueda) || pastor.includes(busqueda);
                const coincideEstado = !estado || estadoVal === estado;

                t.style.display = (coincideBusqueda && coincideEstado) ? '' : 'none';
            });
        }

        function limpiarFiltroComunidad() {
            document.getElementById('inputBuscarComunidad').value = '';
            document.getElementById('selectFiltroEstado').value = '';
            filtrarTarjetasComunidad();
        }

        function verDetalleIglesia(id, nombreIglesia, miembrosEncoded) {
            document.getElementById('modalTituloIglesia').innerText = `Integrantes de ${nombreIglesia} en WhatsApp`;
            const miembros = JSON.parse(decodeURIComponent(miembrosEncoded));
            const tbody = document.getElementById('tablaCuerpoIntegrantes');

            if (miembros.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="text-center text-muted py-3">Ningún integrante se ha registrado aún para esta iglesia.</td></tr>`;
            } else {
                let html = '';
                miembros.forEach((m, idx) => {
                    let rolBadge = m.rol === 'pastor' ? 'bg-primary' : (m.rol === 'lider' ? 'bg-info text-dark' : 'bg-warning text-dark');

                    html += `<tr>
                        <td class="fw-bold">${idx + 1}</td>
                        <td><strong>${m.nombre_completo}</strong></td>
                        <td><span class="badge ${rolBadge}">${m.rol.toUpperCase()}</span></td>
                        <td><a href="https://wa.me/52${m.telefono}" target="_blank" class="text-success text-decoration-none font-monospace fw-bold"><i class="fab fa-whatsapp me-1"></i>${m.telefono}</a></td>
                        <td>${m.correo || '<span class="text-muted">Sin correo</span>'}</td>
                        <td class="text-center">
                            <button class="btn btn-outline-primary btn-sm py-0 px-2 me-1" onclick="abrirModalEditar('${m.id}', '${m.nombre_completo.replace(/'/g, '')}', '${m.rol}', '${m.telefono}', '${m.correo || ''}')"><i class="fas fa-edit"></i></button>
                            <form action="/admin-comunidad/eliminar/${m.id}" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar registro duplicado?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2"><i class="fas fa-trash-alt"></i></button>
                            </form>
                        </td>
                    </tr>`;
                });
                tbody.innerHTML = html;
            }

            if (!modalDetalleBs) modalDetalleBs = new bootstrap.Modal(document.getElementById('modalDetalleComunidad'));
            modalDetalleBs.show();
        }

        function abrirModalEditar(id, nombre, rol, telefono, correo) {
            document.getElementById('formEditarIntegrante').action = `/admin-comunidad/editar/${id}`;
            document.getElementById('editNombre').value = nombre;
            document.getElementById('editRol').value = rol;
            document.getElementById('editTelefono').value = telefono;
            document.getElementById('editCorreo').value = correo;

            if (!modalEditarBs) modalEditarBs = new bootstrap.Modal(document.getElementById('modalEditarIntegrante'));
            modalEditarBs.show();
        }
    </script>
</body>
</html>
